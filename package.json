{
  "name": "cult-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Cult Simulator - Tailwind CSS build",
  "scripts": {
    "build": "tailwindcss -i ./src/CultSimulator/wwwroot/css/tailwind-input.css -o ./src/CultSimulator/wwwroot/css/tailwind.css --minify",
    "build:css": "tailwindcss -i ./src/CultSimulator/wwwroot/css/tailwind-input.css -o ./src/CultSimulator/wwwroot/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/CultSimulator/wwwroot/css/tailwind-input.css -o ./src/CultSimulator/wwwroot/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@tailwindcss/forms": "^0.5.9"
  }
}
