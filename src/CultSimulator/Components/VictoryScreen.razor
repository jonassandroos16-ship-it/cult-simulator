@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

@if (Game.ShadowWarVictory)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-4" style="background: rgba(0,0,0,0.9); backdrop-filter: blur(8px);">
        <div class="relative max-w-lg text-center">
            <div class="absolute inset-0 -z-10 rounded-full blur-3xl animate-pulse" style="background: rgba(251,191,36,0.1);"></div>
            <div class="mb-6 flex justify-center">
                <div class="relative">
                    <span class="text-6xl">🌍</span>
                    <span class="absolute -right-2 -top-2 text-2xl animate-pulse">✨</span>
                </div>
            </div>
            <h1 class="mb-3 text-4xl font-bold tracking-tight text-amber-200 font-display">The World Is Ours</h1>
            <p class="mb-6 text-slate-400">From a single coven to total global dominion. Every institution, every government, every military command — all bow to the shadow. The world doesn't even know it's been conquered.</p>
            <div class="mb-6 grid grid-cols-2 gap-3">
                <div class="p-4 rounded-[14px]" style="background: rgba(120,53,15,0.15); border: 1px solid rgba(251,191,36,0.2);">
                    <div class="text-2xl font-bold text-amber-300 font-display">@ShadowWarEngine.ControlledInstitutions(Game.ShadowWar).Count</div>
                    <div class="text-xs uppercase tracking-wider text-slate-400">Institutions</div>
                </div>
                <div class="p-4 rounded-[14px]" style="background: rgba(120,53,15,0.15); border: 1px solid rgba(251,191,36,0.2);">
                    <div class="text-2xl font-bold text-amber-300 font-display">@ShadowWarData.Territories.Length</div>
                    <div class="text-xs uppercase tracking-wider text-slate-400">Territories</div>
                </div>
                <div class="p-4 rounded-[14px]" style="background: rgba(120,53,15,0.15); border: 1px solid rgba(251,191,36,0.2);">
                    <div class="text-2xl font-bold text-amber-300 font-display">×@Game.ShadowWar.PrestigeMultiplier</div>
                    <div class="text-xs uppercase tracking-wider text-slate-400">Prestige Multiplier</div>
                </div>
                <div class="p-4 rounded-[14px]" style="background: rgba(120,53,15,0.15); border: 1px solid rgba(251,191,36,0.2);">
                    <div class="text-2xl font-bold text-amber-300 font-display">@Game.State.Covens.Count</div>
                    <div class="text-xs uppercase tracking-wider text-slate-400">Covens</div>
                </div>
            </div>
            <p class="mb-6 text-sm text-slate-500">A permanent prestige multiplier of ×@Game.ShadowWar.PrestigeMultiplier has been achieved. The shadow reigns supreme.</p>
            <button class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium text-amber-200 transition-colors hover:opacity-80 font-display tracking-wider uppercase" style="background: rgba(120,53,15,0.3); border: 1px solid rgba(251,191,36,0.3);" @onclick="ResetGame">↻ Begin Anew</button>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task ResetGame() => await Game.ResetAsync();
    public void Dispose() => Game.OnChange -= StateChanged;
}
