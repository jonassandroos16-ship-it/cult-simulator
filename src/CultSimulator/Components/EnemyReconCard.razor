@using CultSimulator.Game

@if (Recon != null)
{
    var totalEnemyAttack = Recon.Composition.Where(u => !u.IsSupport).Sum(u => u.Attack * u.Count);
    var totalEnemyArmor = Recon.Composition.Sum(u => u.Defense * u.Count);

    <div class="enemy-recon-card p-3 rounded-[14px] mb-3" style="background: rgba(20,8,28,0.6); border: 1px solid rgba(239,68,68,0.2);">
        <div class="flex items-center gap-2 mb-2">
            <span class="text-xl">@Recon.Icon</span>
            <div class="flex-1">
                <div class="text-sm text-amber-100 font-medium">@Recon.Name</div>
                <div class="text-[0.6rem] text-slate-400 leading-4">@Recon.Description</div>
            </div>
            <div class="px-2 py-1 rounded-[8px] text-[0.6rem] font-bold uppercase tracking-wider"
                 style="@ThreatStyle">
                @Recon.Threat
            </div>
        </div>

        <div class="grid grid-cols-2 gap-2 mb-2">
            <div class="p-1.5 rounded-[8px] text-center" style="background: rgba(15,10,36,0.4);">
                <div class="text-[0.55rem] text-slate-400 uppercase">Est. HP</div>
                <div class="text-sm text-rose-300 font-medium">@Recon.EstimatedHp:F0</div>
            </div>
            <div class="p-1.5 rounded-[8px] text-center" style="background: rgba(15,10,36,0.4);">
                <div class="text-[0.55rem] text-slate-400 uppercase">Est. Attack</div>
                <div class="text-sm text-cyan-300 font-medium">@Recon.EstimatedAttack:F1</div>
            </div>
        </div>

        @if (Recon.Composition.Count > 0)
        {
            <div class="mb-2">
                <div class="text-[0.55rem] text-violet-400 uppercase tracking-wider mb-1">Known Composition</div>
                <div class="flex flex-wrap gap-1">
                    @foreach (var unit in Recon.Composition)
                    {
                        <div class="flex items-center gap-1 px-1.5 py-0.5 rounded-[6px] text-[0.55rem]"
                             style="background: rgba(15,10,36,0.5); border: 1px solid rgba(239,68,68,0.1);">
                            <span class="text-xs">@unit.Icon</span>
                            <span class="text-slate-300">@unit.Name</span>
                            <span class="text-rose-300">×@unit.Count</span>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="text-[0.6rem] text-amber-200 leading-4 p-2 rounded-[8px]" style="background: rgba(120,53,15,0.2);">
            @Recon.Recommendation
        </div>

        @if (Recon.Composition.Count > 0)
        {
            <div class="grid grid-cols-2 gap-1.5 mt-2">
                <div class="p-1.5 rounded-[8px] text-center" style="background: rgba(15,10,36,0.4); border: 1px solid rgba(239,68,68,0.15);">
                    <div class="text-[0.5rem] text-slate-400 uppercase">Enemy Total ATK</div>
                    <div class="text-xs text-rose-300 font-medium">@totalEnemyAttack:F0</div>
                    <div class="text-[0.5rem] text-slate-500 mt-0.5">Bring DEF >= this to survive</div>
                </div>
                <div class="p-1.5 rounded-[8px] text-center" style="background: rgba(15,10,36,0.4); border: 1px solid rgba(34,211,238,0.15);">
                    <div class="text-[0.5rem] text-slate-400 uppercase">Enemy Total DEF</div>
                    <div class="text-xs text-cyan-300 font-medium">@totalEnemyArmor:F0</div>
                    <div class="text-[0.5rem] text-slate-500 mt-0.5">Bring ATK >= this to win</div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public EnemyRecon? Recon { get; set; }

    private string ThreatStyle => Recon?.Threat switch
    {
        ThreatLevel.Low => "background: rgba(34,197,94,0.2); color: #4ade80; border: 1px solid rgba(34,197,94,0.3);",
        ThreatLevel.Moderate => "background: rgba(234,179,8,0.2); color: #facc15; border: 1px solid rgba(234,179,8,0.3);",
        ThreatLevel.High => "background: rgba(249,115,22,0.2); color: #fb923c; border: 1px solid rgba(249,115,22,0.3);",
        ThreatLevel.Extreme => "background: rgba(239,68,68,0.2); color: #f87171; border: 1px solid rgba(239,68,68,0.3);",
        _ => "background: rgba(100,116,139,0.2); color: #94a3b8; border: 1px solid rgba(100,116,139,0.3);"
    };
}
