@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService Locations
@implements IDisposable

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">The Sanctum</h2>
    <p class="text-xs text-slate-400 mb-3 leading-relaxed">Manage your cult's inner circle. Hire Acolytes for passive Faith, upgrade Sermon Power for stronger preaching, and Promote Acolytes into named Disciples with unique traits. Disciples can be appointed to the High Council for powerful bonuses, or sacrificed for rituals once unlocked.</p>
    @if (Game.State.ActiveCoven.BaseMultiplier > 1.0)
    {
        <div class="mb-3 p-2.5 rounded-[12px] text-xs flex items-center gap-2" style="background: rgba(167,139,250,0.08); border: 1px solid rgba(167,139,250,0.2);">
            <span class="text-amber-400">✨</span>
            <span class="text-violet-300">@activeCovenName faith bonus: <span class="text-amber-200 font-display font-semibold">×@Game.State.ActiveCoven.BaseMultiplier.ToString("F2")</span> applied to all acolyte, sermon, and map faith</span>
        </div>
    }
    <div class="flex flex-col gap-3">
        <div class="acolyte-block p-3 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2"><span class="text-xl">🙇</span><span class="text-sm text-violet-300 tracking-[0.1em] uppercase">Acolytes</span></div>
                <span class="font-display text-lg font-semibold text-amber-100">@occult.Acolytes / @CultistHierarchy.AcolyteCap(occult, Game.State.ActiveCoven)</span>
            </div>
            @if (hasSanguineAutomata && occult.Acolytes > 0)
            {
                var acolyteRate = OccultEngine.AcolyteFaithPerSec(Game.State);
                <div class="acolyte-autosermon mt-2.5">
                    <div class="flex items-center justify-between text-[0.7rem] mb-1">
                        <span class="text-emerald-400 tracking-[0.1em] uppercase">Auto-Sermon</span>
                        <span class="text-amber-200 font-display font-medium">+@NumberFormat.Fmt(acolyteRate)/s ✨</span>
                    </div>
                    <div class="acolyte-progress-bar h-1 bg-white/[0.06] rounded-full overflow-hidden">
                        <div class="acolyte-progress-fill h-full rounded-full" style="width: @(sermonProgress * 100)%; background: linear-gradient(90deg, var(--gold-warm), var(--gold-deep)); transition: width 0.1s linear;"></div>
                    </div>
                </div>
            }
        </div>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanHireAcolyte(Game.State))" @onclick="() => Game.HireAcolyte()">
            <div class="text-3xl flex-shrink-0">🙇</div>
            <div class="flex-1 flex flex-col gap-0.5"><span class="font-display text-base text-amber-100 font-medium">Initiate Acolyte</span><span class="text-xs text-emerald-400">+1 Acolyte (passive Faith)</span></div>
            <div class="flex items-baseline gap-1 flex-shrink-0"><span class="font-display font-semibold text-amber-400 text-base">@NumberFormat.Fmt(OccultEngine.AcolyteHireCost(Game.State))</span><span class="text-sm">✨</span></div>
        </button>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanBuySermonPower(Game.State))" @onclick="() => Game.BuySermonPower()">
            <div class="text-3xl flex-shrink-0">📖</div>
            <div class="flex-1 flex flex-col gap-0.5"><span class="font-display text-base text-amber-100 font-medium">Sermon Power</span><span class="text-xs text-emerald-400">+1 base sermon power (level @occult.SermonPowerLevel)</span></div>
            <div class="flex items-baseline gap-1 flex-shrink-0"><span class="font-display font-semibold text-amber-400 text-base">@NumberFormat.Fmt(OccultEngine.SermonPowerUpgradeCost(occult))</span><span class="text-sm">✨</span></div>
        </button>
        <div class="flex flex-col gap-2">
            <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider mb-1">Recruit Disciple (choose role)</div>
            @foreach (var role in OccultData.PromotedRoles)
            {
                var cost = CultistHierarchy.RecruitUnitCostForRole(role);
                var canRecruit = CultistHierarchy.CanRecruitUnitForRole(occult, role);
                <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!canRecruit)" @onclick="() => Game.RecruitUnitForRole(role)">
                    <div class="text-3xl flex-shrink-0">@RoleIcon(role)</div>
                    <div class="flex-1 flex flex-col gap-0.5">
                        <span class="font-display text-base text-amber-100 font-medium">Recruit @RoleName(role)</span>
                        <span class="text-xs text-violet-300">@RoleDesc(role) — Costs @cost Initiates</span>
                    </div>
                    <div class="flex items-baseline gap-1 flex-shrink-0">
                        <span class="font-display font-semibold text-amber-400 text-base">@cost</span>
                        <span class="text-sm">🙇</span>
                    </div>
                </button>
            }
        </div>
    </div>
</div>

@if (occult.Minions.Count > 0)
{
    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">Promoted Disciples</h2>
        <div class="flex flex-col gap-2.5">
            @foreach (var minion in occult.Minions)
            {
                <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <div class="text-3xl flex-shrink-0">@RoleIcon(minion.Role)</div>
                    <div class="flex-1 flex flex-col gap-0.5"><span class="font-display text-base text-amber-100 font-medium">@minion.Name</span><span class="text-xs text-violet-300">@RoleName(minion.Role) · @minion.Trait?.Name</span><span class="text-[0.7rem] text-slate-400">@minion.Trait?.Description</span></div>
                    <button class="upgrade-buy px-3 py-1.5 rounded-full font-body text-xs cursor-pointer transition-transform duration-200" style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);" @onclick="() => Game.SacrificeMinion(minion.Id)">Banish</button>
                </div>
            }
        </div>
    </div>
}

@if (occult.HighCouncil.Count > 0 || occult.Minions.Count > 0)
{
    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">High Council</h2>
        <div class="flex flex-col gap-2.5">
            @foreach (var role in OccultData.CouncilRoles)
            {
                var member = occult.HighCouncil.FirstOrDefault(c => c.Role == role);
                <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px] @(member != null ? "border-amber-500/20 bg-amber-500/5" : "")" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <div class="text-3xl flex-shrink-0">👑</div>
                <div class="flex-1 flex flex-col gap-0.5">
                    <span class="font-display text-base text-amber-100 font-medium">@CouncilRoleName(role)</span>
                    <span class="text-[0.7rem] text-violet-400">@CouncilRoleBenefit(role)</span>
                    @if (member != null) { <span class="text-xs text-emerald-400">@member.Name (@RoleName(member.OriginalRole)) · @member.Trait?.Name</span> <span class="text-[0.65rem] text-slate-400">@member.Trait?.Description</span> }
                    else { <span class="text-xs text-slate-400">Empty seat</span> }
                </div>
                    @if (member != null) { <button class="upgrade-buy px-3 py-1.5 rounded-full font-body text-xs cursor-pointer transition-transform duration-200" style="background: rgba(100,100,100,0.3); border: 1px solid var(--panel-border); color: var(--gold-soft);" @onclick="() => Game.RemoveCouncil(role)">Remove</button> }
                    else if (occult.Minions.Count > 0) { <select class="bg-transparent text-xs text-amber-100 border border-violet-500/20 rounded-full px-2 py-1" @onchange="(e) => AppointFromSelect(role, e.Value?.ToString())"><option value="">Appoint...</option>@foreach (var m in occult.Minions) { <option value="@m.Id">@m.Name (@RoleName(m.Role))</option> }</select> }
                </div>
            }
        </div>
    </div>
}

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">Rituals</h2>
    <div class="flex flex-col gap-2.5">
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanSacrificeAcolyte(Game.State))" @onclick="() => Game.SacrificeAcolyte()">
            <div class="text-3xl flex-shrink-0">🩸</div>
            <div class="flex-1 flex flex-col gap-0.5"><span class="font-display text-base text-amber-100 font-medium">Acolyte Sacrifice</span><span class="text-xs text-rose-400">Sacrifice 1 Acolyte to gain Faith (+50%)</span></div>
        </button>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanActivateBloodOffering(Game.State))" @onclick="() => Game.ActivateBloodOffering()">
            <div class="text-3xl flex-shrink-0">💀</div>
            <div class="flex-1 flex flex-col gap-0.5"><span class="font-display text-base text-amber-100 font-medium">Blood Offering</span><span class="text-xs text-rose-400">Sacrifice 5 Acolytes for a massive burst of Faith</span></div>
        </button>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanActivateDarkVigil(occult))" @onclick="() => Game.ActivateDarkVigil()">
            <div class="text-3xl flex-shrink-0">🌙</div>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="font-display text-base text-amber-100 font-medium">Dark Vigil</span>
                <span class="text-xs text-violet-300">Sacrifice 3 Acolytes for 45s of +50% Acolyte Faith generation</span>
                @if (occult.IsDarkVigilActive) { <span class="text-[0.7rem] text-amber-400">Active: @Math.Ceiling(occult.DarkVigilTimer)s remaining</span> }
            </div>
        </button>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanActivateWhisperChoir(occult))" @onclick="() => Game.ActivateWhisperChoir()">
            <div class="text-3xl flex-shrink-0">🗣️</div>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="font-display text-base text-amber-100 font-medium">Whisper Choir</span>
                <span class="text-xs text-violet-300">Sacrifice 10 Acolytes for 60s of tripled sermon power</span>
                @if (occult.IsWhisperChoirActive) { <span class="text-[0.7rem] text-amber-400">Active: @Math.Ceiling(occult.WhisperChoirTimer)s remaining</span> }
            </div>
        </button>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanActivateCovenBlessing(occult))" @onclick="() => Game.ActivateCovenBlessing()">
            <div class="text-3xl flex-shrink-0">✨</div>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="font-display text-base text-amber-100 font-medium">Coven Blessing</span>
                <span class="text-xs text-violet-300">Sacrifice 20 Acolytes for 90s of doubled Faith generation and +50% tap power</span>
                @if (occult.IsCovenBlessingActive) { <span class="text-[0.7rem] text-amber-400">Active: @Math.Ceiling(occult.CovenBlessingTimer)s remaining</span> }
            </div>
        </button>
        @if (TechTree.HasTech(occult, TechId.ExsanguinationEngine))
        {
            <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanActivateFrenzy(occult))" @onclick="() => Game.ActivateFrenzy()">
                <div class="text-3xl flex-shrink-0">🔥</div>
                <div class="flex-1 flex flex-col gap-0.5"><span class="font-display text-base text-amber-100 font-medium">Ecstatic Frenzy</span><span class="text-xs text-rose-400">Banish a disciple for 15s of 10x sermon power</span></div>
            </button>
        }
        @if (TechTree.HasTech(occult, TechId.MassHysteria))
        {
            <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;" disabled="@(!OccultEngine.CanActivateMassHysteria(occult))" @onclick="() => Game.ActivateMassHysteria()">
                <div class="text-3xl flex-shrink-0">😱</div>
                <div class="flex-1 flex flex-col gap-0.5"><span class="font-display text-base text-amber-100 font-medium">Mass Hysteria</span><span class="text-xs text-violet-400">30s of doubled Faith generation</span></div>
            </button>
        }
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">Disciple Guide</h2>
    <div class="p-3.5 rounded-[14px] text-sm leading-relaxed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
        <p class="text-violet-300 font-display tracking-[0.1em] uppercase text-xs mb-2">Disciple Roles</p>
        <div class="flex flex-col gap-2">
            <div class="flex items-start gap-2"><span class="text-lg flex-shrink-0">⚔️</span><div><span class="text-amber-200 font-medium">Zealot</span><span class="text-slate-400 text-xs ml-1">— Boosts Shadow War agent production. Each Zealot adds +2% agent generation rate.</span></div></div>
            <div class="flex items-start gap-2"><span class="text-lg flex-shrink-0">📖</span><div><span class="text-amber-200 font-medium">Scholar</span><span class="text-slate-400 text-xs ml-1">— Support unit. Generates passive Faith (@OccultBalance.ScholarFaithPerSec/s) and regenerates HP during battles. Required to field Mages.</span></div></div>
            <div class="flex items-start gap-2"><span class="text-lg flex-shrink-0">🕵️</span><div><span class="text-amber-200 font-medium">Infiltrator</span><span class="text-slate-400 text-xs ml-1">— Generates passive Faith and can auto-suppress Inquisitor raids (requires Inquisitor's Blindfold tech). Each Infiltrator produces @OccultBalance.InfiltratorFaithPerSec/s.</span></div></div>
            <div class="flex items-start gap-2"><span class="text-lg flex-shrink-0">🔮</span><div><span class="text-amber-200 font-medium">Mage</span><span class="text-slate-400 text-xs ml-1">— Devastating spell-caster in battle (12 ATK). Very fragile (1.5 DEF). Requires at least 1 Scholar in the squad to field.</span></div></div>
        </div>
        <p class="text-violet-300 font-display tracking-[0.1em] uppercase text-xs mt-3 mb-2">Disciple Traits</p>
        <div class="flex flex-col gap-1.5">
            @foreach (var trait in OccultData.Traits)
            {
                <div class="flex items-start gap-2"><span class="text-amber-200 text-xs font-medium flex-shrink-0 w-24">@trait.Name</span><span class="text-slate-400 text-xs">@trait.Description</span></div>
            }
        </div>
        <p class="text-violet-300 font-display tracking-[0.1em] uppercase text-xs mt-3 mb-2">High Council</p>
        <div class="flex flex-col gap-2">
            <div class="flex items-start gap-2"><span class="text-lg flex-shrink-0">👑</span><div><span class="text-amber-200 font-medium">Inquisitor</span><span class="text-slate-400 text-xs ml-1">— Boosts all Faith generation by 20%.</span></div></div>
            <div class="flex items-start gap-2"><span class="text-lg flex-shrink-0">👑</span><div><span class="text-amber-200 font-medium">Archon</span><span class="text-slate-400 text-xs ml-1">— Boosts agent production rate by 50%.</span></div></div>
            <div class="flex items-start gap-2"><span class="text-lg flex-shrink-0">👑</span><div><span class="text-amber-200 font-medium">High Priest</span><span class="text-slate-400 text-xs ml-1">— Boosts all Faith generation by 50%. Requires at least one Grand Sacrifice.</span></div></div>
        </div>
    </div>
</div>

@code {
    private OccultState occult => Game.State.Occult;
    private bool hasSanguineAutomata => TechTree.HasTech(occult, TechId.SanguineAutomata);
    private double sermonProgress => (DateTime.UtcNow.Ticks / 10000000.0) % 1.0;
    private string activeCovenName { get { var loc = Locations.Find(Game.State.ActiveCovenId); return loc?.Name ?? Game.State.ActiveCovenId; } }
    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    private void AppointFromSelect(CouncilRole role, string? minionId) { if (!string.IsNullOrEmpty(minionId)) Game.AppointCouncil(role, minionId); }
    private static string RoleIcon(PromotedRole role) => role switch { PromotedRole.Zealot => "⚔️", PromotedRole.Scholar => "📖", PromotedRole.Infiltrator => "🕵️", PromotedRole.Mage => "🔮", _ => "🔮" };
    private static string RoleName(PromotedRole role) => role switch { PromotedRole.Zealot => "Zealot", PromotedRole.Scholar => "Scholar", PromotedRole.Infiltrator => "Infiltrator", PromotedRole.Mage => "Mage", _ => "Unknown" };
    private static string RoleDesc(PromotedRole role) => role switch { PromotedRole.Zealot => "Fanatical warrior — boosts raid power and agent production", PromotedRole.Scholar => "Faith multiplier and Mage support in battle", PromotedRole.Infiltrator => "Stealth operative — reduces enemy counterattacks", PromotedRole.Mage => "Devastating battle caster — requires a Scholar", _ => "" };
    private static string CouncilRoleName(CouncilRole role) => role switch { CouncilRole.Inquisitor => "Inquisitor", CouncilRole.Archon => "Archon", CouncilRole.HighPriest => "High Priest", _ => "Unknown" };
    private static string CouncilRoleBenefit(CouncilRole role) => role switch { CouncilRole.Inquisitor => "Boosts all Faith generation", CouncilRole.Archon => "Boosts agent production rate", CouncilRole.HighPriest => "Boosts all faith generation", _ => "" };
    public void Dispose() => Game.OnChange -= StateChanged;
}
