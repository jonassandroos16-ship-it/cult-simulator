@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService Locations
@implements IDisposable

@if (Game.ConversionCompletePending)
{
    <div class="event-overlay fixed inset-0 z-[100] flex items-center justify-center p-8 animate-fade-in"
         style="background: rgba(5,3,8,0.85); backdrop-filter: blur(8px);">
        <div class="event-modal relative rounded-3xl p-10 max-w-md w-full overflow-hidden animate-modal-rise"
             style="background: linear-gradient(135deg, var(--violet-void), var(--void-deep)); border: 1px solid rgba(167,139,250,0.25);">
            <div class="event-glow absolute -top-[30%] -left-[30%] w-[160%] h-[160%] pointer-events-none"
                 style="background: radial-gradient(circle at center, rgba(124,58,237,0.18) 0%, transparent 60%);"></div>
            <div class="relative text-center">
                <div class="text-3xl mb-3">⛧</div>
                <h2 class="font-display text-sm font-semibold tracking-[0.3em] uppercase text-violet-300 mb-4">Coven Converted</h2>
                <div class="takeover-name-swap font-display text-3xl font-bold tracking-[0.08em] mb-6">
                    <span class="takeover-old">@Game.ConvertedCovenName</span>
                    <span class="takeover-arrow">➜</span>
                    <span class="takeover-new">@Game.State.CultName</span>
                </div>
                <p class="text-sm leading-7 text-violet-300 mb-6">The rival coven kneels. Their name is erased; yours is written in its place. Your dominion grows.</p>
                <button class="event-choice w-full p-4 rounded-[14px] cursor-pointer transition-all duration-200 text-center hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                        style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                        @onclick="DismissComplete">
                    <span class="choice-label font-display text-base text-amber-100 font-medium">Continue</span>
                </button>
            </div>
        </div>
    </div>
}

@{
    var convDef = Game.ActiveConversion;
    var targetLoc = convDef != null ? Locations.Find(convDef.CovenId) : null;
    var inBattle = Game.IsConversionBattlePhase;
    var battle = Game.ConversionBattle;
    var step = Game.CurrentConversionStep;
}

@if (Game.IsConversionActive && targetLoc != null)
{
    var rival = BattleData.RivalForContinent(targetLoc.Continent);

    <div class="event-overlay fixed inset-0 z-[100] flex items-center justify-center p-4 animate-fade-in"
         style="background: rgba(5,3,8,0.85); backdrop-filter: blur(8px);">
        <div class="event-modal relative rounded-3xl p-8 max-w-lg w-full overflow-hidden animate-modal-rise"
             style="background: linear-gradient(135deg, var(--violet-void), var(--void-deep)); border: 1px solid rgba(167,139,250,0.25);">
            <div class="event-glow absolute -top-[30%] -left-[30%] w-[160%] h-[160%] pointer-events-none"
                 style="background: radial-gradient(circle at center, rgba(124,58,237,0.18) 0%, transparent 60%);"></div>

            <div class="relative">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="font-display text-sm font-semibold tracking-[0.3em] uppercase text-violet-300">Conversion Op</h2>
                    <button class="text-slate-400 hover:text-slate-200 transition-colors text-2xl leading-none" @onclick="CancelConversion">×</button>
                </div>

                <div class="mb-4 p-4 rounded-[16px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <div class="flex items-center gap-3">
                        <span class="text-2xl">@targetLoc.Icon</span>
                        <div class="flex-1">
                            <div class="font-display text-base font-semibold text-amber-100">@targetLoc.Name</div>
                            <div class="text-xs text-slate-400">@targetLoc.Continent • Defense: @targetLoc.Defense.ToString("F0")</div>
                        </div>
                        @if (rival != null)
                        {
                            <div class="text-right">
                                <div class="text-[0.65rem] text-rose-300 uppercase tracking-wider">Rival</div>
                                <div class="text-sm font-display text-rose-200">@rival.Icon @rival.Name</div>
                            </div>
                        }
                    </div>
                </div>

                @if (!inBattle && step != null)
                {
                    <div class="mb-4">
                        <p class="text-sm text-violet-200 mb-2 font-display">@step.Title</p>
                        <p class="text-xs text-slate-400 mb-4 leading-relaxed">@step.Narrative</p>
                        <div class="event-choices flex flex-col gap-3">
                            <button class="event-choice flex flex-col gap-1 p-4 rounded-[14px] cursor-pointer transition-all duration-200 text-left hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                                    @onclick="() => ChooseStep(step.ChoiceA)">
                                <span class="choice-label font-display text-base text-amber-100 font-medium">@step.ChoiceA.Label</span>
                                <span class="choice-desc text-xs text-amber-200">@step.ChoiceA.Description</span>
                            </button>
                            <button class="event-choice flex flex-col gap-1 p-4 rounded-[14px] cursor-pointer transition-all duration-200 text-left hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                                    @onclick="() => ChooseStep(step.ChoiceB)">
                                <span class="choice-label font-display text-base text-amber-100 font-medium">@step.ChoiceB.Label</span>
                                <span class="choice-desc text-xs text-amber-200">@step.ChoiceB.Description</span>
                            </button>
                        </div>
                    </div>

                    <div class="mb-4 p-3 rounded-[12px] text-xs" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                        <div class="grid grid-cols-2 gap-1 text-slate-300">
                            <div>Target Defense</div><div class="text-amber-200 text-right">@targetLoc.Defense.ToString("F1")</div>
                            <div>Progress</div><div class="text-emerald-300 text-right">@((int)(Game.ConversionProgressValue * 100))%</div>
                        </div>
                    </div>
                }
                else if (!inBattle && step == null)
                {
                    <div class="text-center text-xs text-slate-400 py-4">Preparing battle phase...</div>
                }
                else if (inBattle && battle != null)
                {
                    @if (battle.Phase == BattlePhase.Deploy)
                    {
                        <p class="text-xs text-slate-400 mb-3 leading-relaxed">
                            Deploy your agents to fight the rival cult. Each unit consumes from your Recruited pool (Battle tab).
                        </p>
                        <div class="grid grid-cols-3 gap-2 mb-3">
                            @foreach (var agentDef in BattleData.AgentTypes)
                            {
                                <button class="battle-agent-card p-2 rounded-[8px] text-center @(convSelectedAgent == agentDef.Type ? "selected" : "")"
                                        style="background: rgba(5,3,8,0.4); border: 1px solid @(convSelectedAgent == agentDef.Type ? "var(--gold-warm)" : "var(--panel-border)");"
                                        @onclick="() => convSelectedAgent = agentDef.Type">
                                    <div class="text-lg mb-0.5">@agentDef.Icon</div>
                                    <div class="text-[0.65rem] font-medium text-amber-200">@agentDef.Name</div>
                                    <div class="text-[0.55rem] text-slate-400 mt-0.5">ATK @agentDef.Attack / DEF @agentDef.Defense</div>
                                </button>
                            }
                        </div>
                        <div class="flex items-center gap-3 mb-3">
                            <label class="text-xs text-violet-300 min-w-[60px]">Amount</label>
                            <input type="number" min="1" max="100" class="form-input w-24 text-sm rounded-[8px] px-2 py-1.5"
                                   style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit;"
                                   @bind="convDeployCount" @bind:event="oninput" />
                            <button class="px-3 py-1.5 rounded-[8px] text-xs text-amber-100 transition-all hover:bg-amber-500/10"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                    @onclick="ConvDeploy">
                                Deploy
                            </button>
                        </div>

                        @if (battle.DeployedSquad.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1.5 mb-3">
                                @foreach (var slot in battle.DeployedSquad)
                                {
                                    var def = BattleData.AgentDef(slot.Type);
                                    <div class="text-[0.65rem] px-2 py-1 rounded-[8px] flex items-center gap-1" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                                        <span>@def?.Icon</span>
                                        <span class="text-amber-200">@slot.Count</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mb-4 p-3 rounded-[12px] text-xs" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                            <div class="grid grid-cols-2 gap-1 text-slate-300">
                                <div>Enemy Strength</div><div class="text-rose-300 text-right">@((rival?.AgentStrength ?? 5.0).ToString("F1"))</div>
                                <div>Enemy HP</div><div class="text-rose-300 text-right">@((int)battle.RivalMaxHp)</div>
                                <div>Your HP</div><div class="text-emerald-300 text-right">@((int)battle.PlayerMaxHp)</div>
                                <div>Deployed</div><div class="text-amber-200 text-right">@battle.TotalDeployed agents</div>
                            </div>
                        </div>
                    }
                    else if (battle.Phase == BattlePhase.Fighting)
                    {
                        <div class="grid grid-cols-2 gap-2 mb-4">
                            <div>
                                <div class="text-slate-400 text-[0.65rem] mb-0.5">Your HP</div>
                                <div class="text-emerald-300 font-display text-sm">@((int)battle.PlayerHp) / @((int)battle.PlayerMaxHp)</div>
                                <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                    <div class="h-full bg-emerald-400 rounded-full transition-all duration-300" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="text-slate-400 text-[0.65rem] mb-0.5">Rival HP</div>
                                <div class="text-rose-300 font-display text-sm">@((int)battle.RivalHp) / @((int)battle.RivalMaxHp)</div>
                                <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                    <div class="h-full bg-rose-400 rounded-full transition-all duration-300" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="text-center text-xs text-rose-300 py-3 animate-pulse">Battle in progress...</div>
                    }
                    else if (battle.Phase == BattlePhase.Cooldown)
                    {
                        <div class="text-center text-xs text-emerald-300 py-3">Victory! Claiming the coven...</div>
                    }
                }

                @if (!string.IsNullOrEmpty(convMessage))
                {
                    <div class="mb-4 p-2 rounded-[10px] text-xs text-center @(convSuccess ? "text-emerald-300" : "text-red-300")"
                         style="background: rgba(15,10,36,0.5); border: 1px solid @(convSuccess ? "rgba(52,211,153,0.3)" : "rgba(239,68,68,0.3)");">
                        @convMessage
                    </div>
                }

                <div class="flex gap-3">
                    <button class="event-choice flex-1 p-3 rounded-[12px] cursor-pointer text-center transition-all duration-200 hover:-translate-y-0.5"
                            style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                            @onclick="CancelConversion">
                        <span class="text-sm text-slate-300">Cancel</span>
                    </button>
                    @if (inBattle && battle != null && battle.Phase == BattlePhase.Deploy)
                    {
                        <button class="event-choice flex-1 p-3 rounded-[12px] cursor-pointer text-center transition-all duration-200 hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                                style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                                @onclick="ConvStartFight">
                            <span class="text-sm text-amber-100 font-medium">Start Battle</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string convMessage = "";
    private bool convSuccess = false;
    private int convDeployCount = 1;
    private AgentType convSelectedAgent = AgentType.Initiate;

    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private void ChooseStep(ConversionChoice choice)
    {
        var outcome = Game.ApplyConversionChoice(choice);
        convMessage = outcome ?? "";
        convSuccess = true;
    }

    private void ConvDeploy()
    {
        var result = Game.DeployConversionAgents(convSelectedAgent, convDeployCount);
        convSuccess = result.success;
        convMessage = result.message;
    }

    private void ConvStartFight()
    {
        var result = Game.StartConversionBattleFight();
        convSuccess = result.success;
        convMessage = result.message;
    }

    private void CancelConversion() { Game.CancelConversion(); }

    private void DismissComplete() { Game.DismissConversionComplete(); }

    public void Dispose() => Game.OnChange -= StateChanged;
}
