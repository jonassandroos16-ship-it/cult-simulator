@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService Locations
@implements IDisposable

@if (Game.ConversionCompletePending)
{
    <div class="event-overlay fixed inset-0 z-[100] flex items-center justify-center p-8 animate-fade-in"
         style="background: rgba(5,3,8,0.85); backdrop-filter: blur(8px);">
        <div class="event-modal relative rounded-3xl p-10 max-w-md w-full overflow-hidden animate-modal-rise"
             style="background: linear-gradient(135deg, var(--violet-void), var(--void-deep)); border: 1px solid rgba(167,139,250,0.25);">
            <div class="event-glow absolute -top-[30%] -left-[30%] w-[160%] h-[160%] pointer-events-none"
                 style="background: radial-gradient(circle at center, rgba(124,58,237,0.18) 0%, transparent 60%);"></div>
            <div class="relative text-center">
                <div class="text-3xl mb-3">⛧</div>
                <h2 class="font-display text-sm font-semibold tracking-[0.3em] uppercase text-violet-300 mb-4">Coven Converted</h2>
                <div class="takeover-name-swap font-display text-3xl font-bold tracking-[0.08em] mb-6">
                    <span class="takeover-old">@Game.ConvertedCovenName</span>
                    <span class="takeover-arrow">➜</span>
                    <span class="takeover-new">@Game.State.CultName</span>
                </div>
                <p class="text-sm leading-7 text-violet-300 mb-6">The rival coven kneels. Their name is erased; yours is written in its place. Your dominion grows.</p>
                <button class="event-choice w-full p-4 rounded-[14px] cursor-pointer transition-all duration-200 text-center hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                        style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                        @onclick="DismissComplete">
                    <span class="choice-label font-display text-base text-amber-100 font-medium">Continue</span>
                </button>
            </div>
        </div>
    </div>
}

@if (Game.IsConversionActive && !isMinimized)
{
    var target = Game.ActiveConversion != null ? Locations.Find(Game.State.Conversion!.CovenId) : null;
    var step = Game.CurrentConversionStep;
    var isBattlePhase = Game.IsConversionBattlePhase;
    var convBattle = Game.ConversionBattle;
    var sw = Game.State.ShadowWarOrInit;
    var poolAgents = (int)sw.AvailableAgents;
    var totalRecruited = sw.RecruitedAgents.Values.Sum();

    <div class="event-overlay fixed inset-0 z-[100] flex items-center justify-center p-4 animate-fade-in"
         style="background: rgba(5,3,8,0.85); backdrop-filter: blur(8px);"
         @onclick="HandleOverlayClick">
        <div class="event-modal relative rounded-3xl p-8 max-w-lg w-full overflow-hidden animate-modal-rise max-h-[90vh] overflow-y-auto"
             style="background: linear-gradient(135deg, var(--violet-void), var(--void-deep)); border: 1px solid rgba(167,139,250,0.25);"
             @onclick:stopPropagation="true">
            <div class="event-glow absolute -top-[30%] -left-[30%] w-[160%] h-[160%] pointer-events-none"
                 style="background: radial-gradient(circle at center, rgba(124,58,237,0.18) 0%, transparent 60%);"></div>

            <div class="relative">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="font-display text-sm font-semibold tracking-[0.3em] uppercase text-violet-300">Conversion</h2>
                    <button class="text-slate-400 hover:text-slate-200 transition-colors text-2xl leading-none" @onclick="Close">×</button>
                </div>

                @if (target != null)
                {
                    <div class="mb-4 p-4 rounded-[16px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                        <div class="flex items-center gap-3">
                            <span class="text-2xl">@target.Icon</span>
                            <div>
                                <div class="font-display text-base font-semibold text-amber-100">@target.Name</div>
                                <div class="text-xs text-slate-400">@target.Continent</div>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Game.State.Conversion?.LastOutcome))
                {
                    <div class="mb-4 p-3 rounded-[12px] text-xs leading-relaxed text-violet-200"
                         style="background: rgba(15,10,36,0.5); border: 1px solid rgba(167,139,250,0.2);">
                        @Game.State.Conversion!.LastOutcome
                    </div>
                }

                @if (step != null && !isBattlePhase)
                {
                    <div class="mb-4">
                        <h3 class="font-display text-base text-amber-100 mb-2">@step.Title</h3>
                        <p class="text-sm leading-6 text-violet-300 mb-4">@step.Narrative</p>

                        <div class="flex flex-col gap-3">
                            <button class="event-choice p-4 rounded-[14px] cursor-pointer text-left transition-all duration-200 hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                                    @onclick="() => ChooseStep(step.ChoiceA)">
                                <div class="font-display text-sm text-amber-100 font-medium mb-1">@step.ChoiceA.Label</div>
                                <div class="text-xs text-slate-400">@step.ChoiceA.Description</div>
                            </button>
                            <button class="event-choice p-4 rounded-[14px] cursor-pointer text-left transition-all duration-200 hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                                    @onclick="() => ChooseStep(step.ChoiceB)">
                                <div class="font-display text-sm text-amber-100 font-medium mb-1">@step.ChoiceB.Label</div>
                                <div class="text-xs text-slate-400">@step.ChoiceB.Description</div>
                            </button>
                        </div>
                    </div>

                    <div class="mb-2">
                        <div class="text-[0.65rem] text-slate-400 mb-1">Conversion Progress</div>
                        <div class="w-full h-2 rounded-full bg-slate-700/50 overflow-hidden">
                            <div class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: @(Game.ConversionProgressValue * 100)%"></div>
                        </div>
                    </div>
                }
                else if (isBattlePhase)
                {
                    <div class="mb-4">
                        <p class="text-sm leading-6 text-rose-300 mb-4">
                            The coven's defenders have been stirred. You must defeat them in battle to complete the conversion.
                        </p>

                        @if (convBattle != null)
                        {
                            <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                                <div>
                                    <div class="text-slate-400 text-[0.65rem] mb-0.5">Your HP</div>
                                    <div class="text-emerald-300 font-display">@((int)convBattle.PlayerHp) / @((int)convBattle.PlayerMaxHp)</div>
                                    <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                        <div class="h-full bg-emerald-400 rounded-full transition-all duration-300" style="width: @(convBattle.PlayerMaxHp > 0 ? (convBattle.PlayerHp / convBattle.PlayerMaxHp * 100).ToString("F0") : "0")%;"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="text-slate-400 text-[0.65rem] mb-0.5">Defender HP</div>
                                    <div class="text-rose-300 font-display">@((int)convBattle.RivalHp) / @((int)convBattle.RivalMaxHp)</div>
                                    <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                        <div class="h-full bg-rose-400 rounded-full transition-all duration-300" style="width: @(convBattle.RivalMaxHp > 0 ? (convBattle.RivalHp / convBattle.RivalMaxHp * 100).ToString("F0") : "0")%;"></div>
                                    </div>
                                </div>
                            </div>

                            @if (convBattle.Phase == BattlePhase.Deploy)
                            {
                                @if (totalRecruited == 0 && poolAgents == 0)
                                {
                                    <div class="deploy-empty-state mb-4">
                                        <div class="text-2xl mb-2">🏕️</div>
                                        <p class="text-sm text-slate-400 mb-2">You have no agents to fight with.</p>
                                        <p class="text-xs text-violet-300 mb-3">Tap <strong>Minimize</strong> below, then go to the <strong>Battle</strong> tab to recruit agents from your pool. Come back when you're ready.</p>
                                    </div>
                                }
                                else
                                {
                                    <DeploySquadPanel CanDeploy="true"
                                                      DeployedSquad="convBattle.DeployedSquad"
                                                      FightLabel="Fight!"
                                                      OnDeployAgent="args => DeployConvAgent(args.Item1, args.Item2)"
                                                      OnWithdraw="WithdrawConvAgents"
                                                      OnFight="StartConvBattle" />
                                }
                            }
                            else if (convBattle.Phase == BattlePhase.Fighting)
                            {
                                <DeploySquadPanel CanDeploy="false" IsFighting="true" DeployedSquad="convBattle.DeployedSquad" />
                            }
                            else if (convBattle.Phase == BattlePhase.Cooldown)
                            {
                                <div class="text-center text-xs text-emerald-300 py-3">Victory! Finalizing conversion...</div>
                            }
                        }
                        else
                        {
                            <button class="event-choice w-full p-3 rounded-[12px] cursor-pointer text-center transition-all duration-200 hover:-translate-y-0.5 hover:bg-amber-500/10 hover:border-amber-500/30"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                                    @onclick="StartConvBattle">
                                <span class="text-sm text-amber-100 font-medium">Begin the Battle</span>
                            </button>
                        }
                    </div>
                }

                <div class="flex gap-2">
                    <button class="flex-1 p-3 rounded-[12px] cursor-pointer text-center transition-all duration-200 hover:bg-violet-500/10 hover:border-violet-500/30"
                            style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                            @onclick="Minimize">
                        <span class="text-xs text-violet-300 font-medium">⤓ Minimize</span>
                    </button>
                    <button class="flex-1 p-3 rounded-[12px] cursor-pointer text-center transition-all duration-200 hover:bg-slate-500/10"
                            style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                            @onclick="Close">
                        <span class="text-xs text-slate-400">Abandon</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (Game.IsConversionActive && isMinimized)
{
    <div class="fixed bottom-4 right-4 z-[100] animate-fade-in">
        <button class="px-5 py-3 rounded-2xl shadow-2xl transition-all duration-200 hover:scale-105"
                style="background: linear-gradient(135deg, var(--violet-void), var(--void-deep)); border: 1px solid rgba(167,139,250,0.3); box-shadow: 0 0 20px rgba(167,139,250,0.15);"
                @onclick="Restore">
            <div class="flex items-center gap-2">
                <span class="text-lg">🔮</span>
                <div class="text-left">
                    <div class="text-xs text-amber-200 font-medium">Conversion in Progress</div>
                    @if (Game.IsConversionBattlePhase)
                    {
                        <div class="text-[0.6rem] text-rose-300">Battle phase — tap to return</div>
                    }
                    else
                    {
                        <div class="text-[0.6rem] text-violet-400">Tap to continue</div>
                    }
                </div>
            </div>
        </button>
    </div>
}

@code {
    private bool isMinimized = false;

    protected override void OnInitialized() => Game.OnChange += StateHasChanged;
    public void Dispose() => Game.OnChange -= StateHasChanged;

    private void HandleOverlayClick() => Close();
    private void Close() => Game.CancelConversion();
    private void DismissComplete() => Game.DismissConversionComplete();
    private void Minimize() => isMinimized = true;
    private void Restore() => isMinimized = false;

    private void ChooseStep(ConversionChoice choice)
    {
        Game.ApplyConversionChoice(choice);
    }

    private void DeployConvAgent(AgentType type, int count) => Game.DeployConversionAgents(type, count);
    private void WithdrawConvAgents()
    {
        var continent = Game.ConversionBattleContinent;
        if (continent != null) Game.WithdrawBattleAgents(continent);
    }
    private void StartConvBattle()
    {
        var continent = Game.ConversionBattleContinent;
        if (continent == null) return;
        var battle = Game.GetBattle(continent);
        if (battle != null && battle.Phase == BattlePhase.Deploy && battle.TotalDeployed > 0)
            Game.StartConversionBattleFight();
        else
            Game.StartConversionBattle();
    }
}
