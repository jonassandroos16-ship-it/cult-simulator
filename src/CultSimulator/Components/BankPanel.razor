@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService Locations
@implements IDisposable

<div class="bank-panel flex flex-col gap-6">
    <div class="p-3.5 rounded-[14px] text-sm leading-relaxed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
        <p class="text-violet-300">The Bank manages your cult's finances. It tracks income from all your covens, increases the cap on offline earnings (so you collect more Faith and Gold while away), and offers upgrades purchasable with Gold.</p>
        <p class="text-slate-400 text-xs mt-2">Gold is generated by certain constructions in the Preach tab. The Bank building raises your offline earning cap — each level extends how long income accumulates while you're away.</p>
    </div>
    @if (Game.HasOfflineReport)
    {
        <div class="offline-report glass-panel rounded-[20px] p-5 border border-amber-500/30">
            <div class="flex items-center gap-3 mb-3">
                <span class="text-2xl">🌙</span>
                <h2 class="panel-title" style="margin-bottom:0;">Offline Earnings</h2>
            </div>
            <p class="text-sm text-violet-300 mb-3">While you were away for @FormatTime(Game.OfflineSeconds), your covens gathered:</p>
            <div class="flex gap-6 flex-wrap mb-3">
                <div class="flex items-baseline gap-1.5">
                    <span class="text-xl">✨</span>
                    <span class="font-display text-lg font-semibold text-amber-100">+@NumberFormat.Fmt(Game.OfflineFaith)</span>
                    <span class="text-[0.7rem] text-violet-300 tracking-[0.15em] uppercase">Faith</span>
                </div>
                <div class="flex items-baseline gap-1.5">
                    <span class="text-xl">💰</span>
                    <span class="font-display text-lg font-semibold text-amber-100">+@NumberFormat.Fmt(Game.OfflineGold)</span>
                    <span class="text-[0.7rem] text-violet-300 tracking-[0.15em] uppercase">Gold</span>
                </div>
            </div>
            <button class="upgrade-buy px-4 py-2 rounded-full font-body text-xs cursor-pointer transition-transform duration-200"
                    style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);"
                    @onclick="DismissOffline">
                Collect
            </button>
        </div>
    }

    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">Income Overview</h2>
        <div class="income-overview flex flex-col gap-3">
            <div class="income-row flex items-center justify-between p-3 rounded-[14px]"
                 style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center gap-2">
                    <span class="text-xl">✨</span>
                    <span class="text-sm text-violet-300 tracking-[0.1em] uppercase">Faith / sec</span>
                </div>
                <span class="font-display text-lg font-semibold text-emerald-400">+@NumberFormat.Fmt(totalIncome.faith)</span>
            </div>
            <div class="income-row flex items-center justify-between p-3 rounded-[14px]"
                 style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center gap-2">
                    <span class="text-xl">💰</span>
                    <span class="text-sm text-violet-300 tracking-[0.1em] uppercase">Gold / sec</span>
                </div>
                <span class="font-display text-lg font-semibold text-amber-500">+@NumberFormat.Fmt(totalIncome.gold)</span>
            </div>
            <div class="income-row flex items-center justify-between p-3 rounded-[14px]"
                 style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center gap-2">
                    <span class="text-xl">👥</span>
                    <span class="text-sm text-violet-300 tracking-[0.1em] uppercase">Total Followers</span>
                </div>
                <span class="font-display text-lg font-semibold text-amber-100">@NumberFormat.Fmt(CovenProgress.TotalFollowers(Game.State))</span>
            </div>
            <div class="income-row flex items-center justify-between p-3 rounded-[14px]"
                 style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center gap-2">
                    <span class="text-xl">🩸</span>
                    <span class="text-sm text-violet-300 tracking-[0.1em] uppercase">Acolytes</span>
                </div>
                <span class="font-display text-lg font-semibold text-rose-300">@Game.State.Occult.Acolytes <span class="text-xs text-slate-400">(+@OccultEngine.AcolytePassivePerSec(Game.State).ToString("F1")/s faith)</span></span>
            </div>
        </div>
    </div>

    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">Coven Breakdown</h2>
        <div class="coven-list flex flex-col gap-2.5">
            @foreach (var coven in takenOverCovens)
            {
                var loc = Locations.Find(coven.Id);
                var name = loc?.Name ?? coven.Id;
                var (faithPerSec, goldPerSec) = GameEngine.TickIncome(coven);
                <div class="coven-row flex items-center justify-between p-3.5 rounded-[14px] @(coven.Id == Game.State.ActiveCovenId ? "border-amber-500/30" : "")"
                     style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <div class="flex flex-col gap-0.5">
                        <span class="font-display text-base text-amber-100 font-medium">@name</span>
                        <span class="text-xs text-violet-300">👥 @coven.Followers · ✨ @NumberFormat.Fmt(coven.Faith) · 💰 @NumberFormat.Fmt(coven.Gold)</span>
                    </div>
                    <div class="flex flex-col items-end gap-0.5">
                        <span class="text-xs text-emerald-400">+@NumberFormat.Fmt(faithPerSec)/s ✨</span>
                        <span class="text-xs text-amber-500">+@NumberFormat.Fmt(goldPerSec)/s 💰</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">Bank</h2>
        <div class="bank-building flex items-center gap-3.5 p-3.5 rounded-[14px] mb-4"
             style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-3xl flex-shrink-0">🏦</div>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="font-display text-base text-amber-100 font-medium">Bank</span>
                <span class="text-xs text-emerald-400">Increases idle income cap</span>
                <span class="text-[0.7rem] text-violet-300">Current cap: @GameEngine.IdleCapDisplay(activeCoven) · owned: @bankOwned</span>
            </div>
            <div class="flex-shrink-0">
                <button class="upgrade-buy flex items-center gap-1.5 px-3.5 py-2 rounded-full font-body font-semibold text-xs cursor-pointer transition-transform duration-200 disabled:opacity-40 disabled:cursor-not-allowed"
                        style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);"
                        disabled="@(activeCoven.Gold < bankCost)"
                        @onclick="() => Game.BuyBank()">
                    <span>@NumberFormat.Fmt(bankCost) 💰</span>
                </button>
            </div>
        </div>

        <div class="bank-cap-tiers flex flex-col gap-2 mb-4">
            <span class="text-[0.7rem] text-violet-300 tracking-[0.1em] uppercase">Cap Tiers</span>
            <div class="flex gap-2 flex-wrap">
                @foreach (var (hours, idx) in GameBalance.BankCapHours.Select((h, i) => (h, i)))
                {
                    var reached = bankOwned > idx;
                    <span class="px-3 py-1.5 rounded-full text-xs font-display tracking-[0.1em] @(reached ? "text-emerald-400 border border-emerald-400/30 bg-emerald-400/5" : "text-slate-400 border border-slate-600/20")">
                        @(hours < 1 ? $"{Math.Floor(hours * 60)} min" : hours < 24 ? $"{hours:F0} h" : $"{hours / 24:F0} d")
                    </span>
                }
            </div>
        </div>

        <h3 class="panel-title" style="font-size:0.75rem; margin-top:1rem;">Bank Upgrades</h3>
        <div class="upgrade-list flex flex-col gap-2.5">
            @foreach (var upgradeId in GameData.BankUpgrades)
            {
                var def = GameData.Upgrades.First(u => u.Id == upgradeId);
                var owned = activeCoven.HasUpgrade(def.Id);
                var unlocked = GameEngine.UpgradeUnlocked(activeCoven, def);
                var affordable = GameEngine.CanAfford(activeCoven, def.FaithCost, def.GoldCost);
                <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px] transition-all duration-200 @(owned ? "border-emerald-400/20 bg-emerald-400/5" : "") @(!unlocked ? "opacity-40" : "")"
                     style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <div class="upgrade-icon text-3xl flex-shrink-0">@def.Icon</div>
                    <div class="upgrade-info flex-1 flex flex-col gap-0.5">
                        <span class="upgrade-name font-display text-base text-amber-100 font-medium">@def.Name</span>
                        <span class="upgrade-effect text-xs text-violet-300">@def.EffectDescription</span>
                        @if (!unlocked) { <span class="upgrade-lock text-[0.7rem] text-slate-400">Unlocks at @def.UnlockFollowers followers</span> }
                    </div>
                    <div class="upgrade-action flex-shrink-0">
                        @if (owned) { <span class="learned-badge text-[0.7rem] font-semibold tracking-[0.15em] uppercase text-emerald-400 px-3 py-1.5 border border-emerald-400/30 rounded-full">Learned</span> }
                        else if (!unlocked) { <span class="locked-badge text-xl">🔒</span> }
                        else {
                            <button class="upgrade-buy flex items-center gap-1.5 px-3.5 py-2 rounded-full font-body font-semibold text-xs cursor-pointer transition-transform duration-200 disabled:opacity-40 disabled:cursor-not-allowed"
                                    style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);"
                                    disabled="@(!affordable)" @onclick="() => Game.BuyUpgrade(def.Id)">
                                <span>@NumberFormat.Fmt(def.FaithCost) ✨</span>
                                @if (def.GoldCost > 0) { <span> @NumberFormat.Fmt(def.GoldCost) 💰</span> }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private CovenState activeCoven => Game.State.ActiveCoven;
    private (double faith, double gold) totalIncome => GameEngine.TotalTickIncome(Game.State);
    private int bankOwned => activeCoven.Buildings.GetValueOrDefault(BuildingType.Bank);
    private int bankCost => GameEngine.BankBuildingCost(bankOwned);
    private List<CovenState> takenOverCovens => Game.State.Covens.Where(c => c.TakenOver).ToList();

    protected override void OnInitialized() => Game.OnChange += StateChanged;

    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private void DismissOffline() => Game.DismissOfflineReport();

    private static string FormatTime(double seconds)
    {
        if (seconds < 60) return $"{Math.Floor(seconds)}s";
        if (seconds < 3600) return $"{Math.Floor(seconds / 60)}m {Math.Floor(seconds % 60)}s";
        if (seconds < 86400) return $"{Math.Floor(seconds / 3600)}h {Math.Floor((seconds % 3600) / 60)}m";
        return $"{Math.Floor(seconds / 86400)}d {Math.Floor((seconds % 86400) / 3600)}h";
    }

    public void Dispose() => Game.OnChange -= StateChanged;
}