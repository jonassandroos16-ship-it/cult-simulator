@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

@if (def != null && inst != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);" @onclick="Close">
        <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-[20px] p-6 shadow-2xl" style="background: rgba(5,3,8,0.95); border: 1px solid rgba(167,139,250,0.3);" @onclick:stopPropagation="true">
            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                    <span class="text-3xl">@GetTypeIcon(def.Type)</span>
                    <div>
                        <h2 class="text-lg font-semibold text-amber-100">@def.Name</h2>
                        <div class="text-xs text-slate-400 uppercase tracking-wider">Tier @((int)def.Tier + 1) · @def.Type</div>
                    </div>
                </div>
                <button class="p-1 text-slate-400 hover:text-slate-200" @onclick="Close">✕</button>
            </div>

            <p class="text-sm text-slate-400 mb-4">@def.Description</p>

            <div class="grid grid-cols-2 gap-2 mb-4">
                <div class="p-2 rounded-[10px] flex items-center gap-2" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <span class="text-slate-400">🛡️</span>
                    <div><div class="text-[10px] text-slate-500 uppercase">Defense</div><div class="text-sm text-amber-100">@Math.Ceiling(inst.DefenseRemaining)</div></div>
                </div>
                <div class="p-2 rounded-[10px] flex items-center gap-2" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <span class="text-slate-400">⚠️</span>
                    <div><div class="text-[10px] text-slate-500 uppercase">Detection</div><div class="text-sm text-amber-100">@((int)inst.Detection)%</div></div>
                </div>
                <div class="p-2 rounded-[10px] flex items-center gap-2" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <span class="text-slate-400">⚔️</span>
                    <div><div class="text-[10px] text-slate-500 uppercase">Agents</div><div class="text-sm text-amber-100">@inst.AssignedAgents</div></div>
                </div>
                <div class="p-2 rounded-[10px] flex items-center gap-2" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <span class="text-slate-400">💪</span>
                    <div><div class="text-[10px] text-slate-500 uppercase">Strength</div><div class="text-sm text-amber-100">×@ShadowWarEngine.AgentStrength(sw, Game.State).ToString("F2")</div></div>
                </div>
            </div>

            <div class="mb-4 p-3 rounded-[14px]" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(52,211,153,0.2);">
                <div class="flex items-center gap-2 text-xs text-emerald-300">
                    <span>✅</span><span class="font-medium">Reward:</span><span class="text-emerald-200">@def.RewardLabel</span>
                </div>
            </div>

            @if (inst.Status == InstitutionStatus.Unlocked)
            {
                <div class="rounded-[14px] p-3 mb-3" style="background: rgba(30,58,138,0.15); border: 1px solid rgba(59,130,246,0.2);">
                    <div class="flex items-center gap-2 text-sm text-blue-300 mb-2">👁️ Recon Phase</div>
                    <p class="text-xs text-slate-400 mb-3">Send 1-3 agents to scout defenses. Risk of losing agents: @((def.ReconRisk * ShadowWarEngine.ReconRiskMultiplier(sw) * 100).ToString("F0"))%.</p>
                    <div class="flex items-center gap-2">
                        <input type="range" min="1" max="3" @bind="reconCount" class="flex-1 accent-blue-500" />
                        <span class="w-16 text-sm text-slate-300 text-right">@reconCount agents</span>
                        <button class="px-4 py-2 rounded-[10px] text-sm text-blue-100 transition-colors hover:opacity-80" style="background: rgba(30,58,138,0.4);" disabled="@(sw.AvailableAgents < reconCount)" @onclick="DoRecon">Start Recon</button>
                    </div>
                </div>
            }

            @if (inst.Status == InstitutionStatus.Recon || inst.Status == InstitutionStatus.Infiltrating)
            {
                @if (inst.Status == InstitutionStatus.Recon)
                {
                    <div class="mb-2">
                        <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Recon Progress</span><span>@((int)inst.ReconProgress)%</span></div>
                        <div class="h-2 rounded-full bg-stone-800 overflow-hidden"><div class="h-full bg-blue-500 transition-all" style="width: @inst.ReconProgress%"></div></div>
                    </div>
                }
                <div class="mb-2">
                    <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Defense Remaining</span><span>@Math.Ceiling(inst.DefenseRemaining) / @def.Defense</span></div>
                    <div class="h-2 rounded-full bg-stone-800 overflow-hidden"><div class="h-full bg-amber-500 transition-all" style="width: @((def.Defense - inst.DefenseRemaining) / def.Defense * 100)%"></div></div>
                </div>
                <div class="mb-3">
                    <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Detection Level</span><span>@((int)inst.Detection)%</span></div>
                    <div class="h-2 rounded-full bg-stone-800 overflow-hidden"><div class="h-full bg-red-500 transition-all" style="width: @inst.Detection%"></div></div>
                </div>
                <div class="rounded-[14px] p-3 mb-3" style="background: rgba(120,53,15,0.15); border: 1px solid rgba(245,158,11,0.2);">
                    <div class="flex items-center gap-2 text-sm text-amber-300 mb-2">⚔️ Infiltration Phase</div>
                    <p class="text-xs text-slate-400 mb-3">Send waves of agents. Each wave reduces defense but raises detection. Detection per agent: @((def.DetectionRate * ShadowWarEngine.DetectionMultiplier(sw)).ToString("F1"))%/s.</p>
                    <div class="flex items-center gap-2">
                        <input type="range" min="1" max="@Math.Max(1, (int)sw.AvailableAgents)" @bind="waveSize" class="flex-1 accent-amber-500" />
                        <span class="w-16 text-sm text-slate-300 text-right">@waveSize agents</span>
                        <button class="px-4 py-2 rounded-[10px] text-sm text-amber-100 transition-colors hover:opacity-80" style="background: rgba(120,53,15,0.4);" disabled="@(sw.AvailableAgents < waveSize)" @onclick="DoWave">Send Wave</button>
                    </div>
                </div>
                <button class="w-full p-2.5 rounded-[10px] text-sm text-slate-400 transition-colors hover:text-rose-300" style="border: 1px solid var(--panel-border); background: rgba(15,10,36,0.4);" @onclick="DoWithdraw">↔ Withdraw Agents</button>
            }

            @if (inst.Status == InstitutionStatus.Controlled)
            {
                <div class="rounded-[14px] p-4 text-center" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(52,211,153,0.2);">
                    <div class="text-3xl mb-2">✅</div>
                    <div class="text-sm font-medium text-emerald-300">This institution is under your control.</div>
                    <div class="mt-1 text-xs text-emerald-400">@def.RewardLabel</div>
                </div>
            }

            @if (inst.Status == InstitutionStatus.Alerted)
            {
                <div class="rounded-[14px] p-4 text-center" style="background: rgba(127,29,29,0.15); border: 1px solid rgba(239,68,68,0.2);">
                    <div class="text-3xl mb-2">⚠️</div>
                    <div class="text-sm font-medium text-red-300">The institution has been alerted!</div>
                    <div class="mt-1 text-xs text-red-400">Agents lost. Will become available again after cooldown.</div>
                </div>
            }

            @if (inst.Status == InstitutionStatus.Investigated)
            {
                <div class="rounded-[14px] p-3 mb-3" style="background: rgba(154,52,18,0.15); border: 1px solid rgba(251,146,60,0.2);">
                    <div class="flex items-center gap-2 text-sm text-orange-300 mb-2">🛡️ Under Investigation!</div>
                    <p class="text-xs text-slate-400 mb-3">Assign defenders to maintain control — if defense drops to 0, you lose it.</p>
                    <div class="mb-3">
                        <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Investigation Defense</span><span>@((int)inst.InvestigationDefense)%</span></div>
                        <div class="h-2 rounded-full bg-stone-800 overflow-hidden"><div class="h-full bg-orange-500 transition-all" style="width: @inst.InvestigationDefense%"></div></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="range" min="1" max="@Math.Max(1, (int)sw.AvailableAgents)" @bind="defenderCount" class="flex-1 accent-orange-500" />
                        <span class="w-16 text-sm text-slate-300 text-right">@defenderCount agents</span>
                        <button class="px-4 py-2 rounded-[10px] text-sm text-orange-100 transition-colors hover:opacity-80" style="background: rgba(154,52,18,0.4);" disabled="@(sw.AvailableAgents < defenderCount)" @onclick="DoDefend">Defend</button>
                    </div>
                </div>
            }

            @if (inst.Status == InstitutionStatus.Locked)
            {
                <div class="rounded-[14px] p-4 text-center text-sm text-slate-400" style="background: rgba(15,10,36,0.3); border: 1px solid var(--panel-border);">
                    Locked. Control prerequisite institutions to unlock.
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string InstitutionId { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private int reconCount = 2;
    private int waveSize = 3;
    private int defenderCount = 3;
    private string? lastMessage;

    private ShadowWarState sw => Game.ShadowWar;
    private InstitutionDef? def => ShadowWarData.Institution(InstitutionId);
    private InstitutionState? inst => sw.GetInstitution(InstitutionId);

    private string GetTypeIcon(InstitutionType t) => t switch
    {
        InstitutionType.Police => "🚔",
        InstitutionType.Media => "📡",
        InstitutionType.Government => "🏛️",
        InstitutionType.Military => "⚔️",
        InstitutionType.Finance => "💰",
        InstitutionType.Intelligence => "🕵️",
        _ => ""
    };

    private void Close() => OnClose.InvokeAsync();

    private void DoRecon()
    {
        var r = Game.StartRecon(InstitutionId, reconCount);
        lastMessage = r.message;
        if (r.success) Close();
    }

    private void DoWave()
    {
        var r = Game.SendInfiltrationWave(InstitutionId, waveSize);
        lastMessage = r.message;
    }

    private void DoWithdraw()
    {
        var r = Game.WithdrawAgents(InstitutionId);
        lastMessage = r.message;
    }

    private void DoDefend()
    {
        var r = Game.AssignDefenders(InstitutionId, defenderCount);
        lastMessage = r.message;
    }

    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.OnChange -= StateChanged;
}