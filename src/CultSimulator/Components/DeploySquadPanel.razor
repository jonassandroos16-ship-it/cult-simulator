@using CultSimulator.Game

<div class="deploy-squad-panel">
    @if (DeployedSquad != null && DeployedSquad.Count > 0)
    {
        <div class="flex flex-col gap-1.5 mb-3">
            <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider">Deployed Squad</div>
            @foreach (var slot in DeployedSquad.Where(d => d.Count > 0))
            {
                var def = BattleData.AgentDef(slot.Type);
                <div class="flex items-center gap-2 text-xs">
                    <span class="text-base">@def?.Icon</span>
                    <span class="text-amber-100 font-medium">@def?.Name</span>
                    <span class="text-slate-400">×@slot.Count</span>
                    @if (def?.IsSupport == true)
                    {
                        <span class="text-[0.55rem] text-emerald-400">+@def.FaithRegen/s Faith</span>
                    }
                </div>
            }
        </div>
    }
    else if (!IsFighting && !IsCooldown)
    {
        <div class="text-xs text-slate-500 text-center py-2 mb-2">No agents deployed yet.</div>
    }

    @if (CanDeploy)
    {
        <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider mb-1.5">Add Agents</div>
        <div class="grid grid-cols-1 gap-1.5">
            @foreach (var agentDef in BattleData.AgentTypes)
            {
                <div class="flex items-center gap-2 p-2 rounded-[10px]" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
                    <span class="text-lg flex-shrink-0">@agentDef.Icon</span>
                    <div class="flex-1 min-w-0">
                        <div class="text-xs text-amber-100 font-medium">@agentDef.Name</div>
                        <div class="text-[0.55rem] text-slate-400">
                            <span class="text-rose-300">⚔@agentDef.Attack</span>
                            <span class="text-cyan-300 ml-1">🛡@agentDef.Defense</span>
                            <span class="text-emerald-300 ml-1">👁@agentDef.Stealth</span>
                            @if (agentDef.IsSupport)
                            {
                                <span class="text-amber-300 ml-1">✨@agentDef.FaithRegen/s</span>
                            }
                        </div>
                    </div>
                    <button class="deploy-btn deploy-btn-deploy"
                            @onclick="() => OnDeployAgent.InvokeAsync((agentDef.Type, 1))">
                        Deploy
                    </button>
                </div>
            }
        </div>
        <div class="flex gap-2 mt-3">
            @if (OnWithdraw.HasDelegate)
            {
                <button class="flex-1 p-2 rounded-[10px] text-xs text-slate-300 transition-all hover:bg-slate-500/10"
                        style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);"
                        @onclick="() => OnWithdraw.InvokeAsync()">
                    Withdraw
                </button>
            }
            @if (OnFight.HasDelegate)
            {
                <button class="flex-1 p-2 rounded-[10px] text-xs font-bold text-rose-100 transition-all hover:bg-rose-500/20"
                        style="background: rgba(127,29,29,0.4); border: 1px solid rgba(239,68,68,0.3);"
                        @onclick="() => OnFight.InvokeAsync()">
                    @FightLabel
                </button>
            }
        </div>
    }

    @if (ShowReinforce)
    {
        <div class="text-[0.65rem] text-amber-400 uppercase tracking-wider mb-1.5 mt-2">Reinforce</div>
        <div class="text-[0.6rem] text-slate-400 mb-2">Pool: @PoolAgents agents available</div>
        <div class="grid grid-cols-1 gap-1.5">
            @foreach (var agentDef in BattleData.AgentTypes.Where(a => a.Type != AgentType.Initiate))
            {
                <div class="flex items-center gap-2 p-2 rounded-[10px]" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
                    <span class="text-lg flex-shrink-0">@agentDef.Icon</span>
                    <div class="flex-1 min-w-0">
                        <div class="text-xs text-amber-100 font-medium">@agentDef.Name</div>
                        <div class="text-[0.55rem] text-slate-400">
                            <span class="text-rose-300">⚔@agentDef.Attack</span>
                            <span class="text-cyan-300 ml-1">🛡@agentDef.Defense</span>
                            @if (agentDef.IsSupport)
                            {
                                <span class="text-amber-300 ml-1">✨@agentDef.FaithRegen/s</span>
                            }
                        </div>
                    </div>
                    <button class="deploy-btn deploy-btn-reinforce"
                            disabled="@(PoolAgents < agentDef.AgentCost)"
                            @onclick="() => OnReinforceAgent.InvokeAsync((agentDef.Type, 1))">
                        +1
                    </button>
                </div>
            }
        </div>
    }

    @if (IsFighting && !ShowReinforce)
    {
        <div class="text-xs text-rose-300 text-center py-2 animate-pulse">Battle in progress...</div>
    }

    @if (IsCooldown)
    {
        <div class="text-xs text-slate-500 text-center py-2">Battle on cooldown.</div>
    }
</div>

@code {
    [Parameter] public bool CanDeploy { get; set; }
    [Parameter] public bool IsFighting { get; set; }
    [Parameter] public bool IsCooldown { get; set; }
    [Parameter] public bool ShowReinforce { get; set; }
    [Parameter] public int PoolAgents { get; set; }
    [Parameter] public List<DeployedAgent>? DeployedSquad { get; set; }
    [Parameter] public string FightLabel { get; set; } = "Fight!";
    [Parameter] public EventCallback<(AgentType, int)> OnDeployAgent { get; set; }
    [Parameter] public EventCallback OnWithdraw { get; set; }
    [Parameter] public EventCallback OnFight { get; set; }
    [Parameter] public EventCallback<(AgentType, int)> OnReinforceAgent { get; set; }
}
