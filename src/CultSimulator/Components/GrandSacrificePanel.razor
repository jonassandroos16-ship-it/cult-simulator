@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">Grand Sacrifice</h2>
    <div class="flex flex-col gap-4">
        <div class="p-3.5 rounded-[14px] text-sm leading-relaxed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <p class="text-violet-300">A Grand Sacrifice resets your entire cult — all covens, followers, buildings, map progress, agents, and rival battles are lost. In exchange, you gain permanent <strong class="text-amber-400">Eldritch Favor</strong>, which multiplies <strong>all</strong> future production: Faith, Gold, and battle Agents.</p>
            <p class="text-slate-400 text-xs mt-2">Each point of Favor boosts global production by +2%. You earn Favor based on lifetime Faith accumulated, with bonuses from conquered map nodes and continent tech. Technologies like <em>Memories of the Deep</em> let you retain some Faith across resets. The more you sacrifice, the faster each new cycle grows.</p>
        </div>
        <div class="text-center p-4 rounded-[14px]" style="background: radial-gradient(circle, rgba(76,29,149,0.2), rgba(15,10,36,0.5)); border: 1px solid rgba(167,139,250,0.2);">
            <div class="text-5xl mb-3">🌟</div>
            <p class="text-sm text-violet-300 mb-2">Eldritch Favor</p>
            <span class="font-display text-3xl font-semibold text-amber-100">@NumberFormat.Fmt(Game.State.EldritchFavor)</span>
            <div class="grid grid-cols-3 gap-2 mt-3">
                <div class="p-2 rounded-[10px]" style="background: rgba(15,10,36,0.5);">
                    <div class="text-[0.6rem] text-amber-400 uppercase tracking-wider">Faith</div>
                    <div class="font-display text-sm text-amber-100">×@GrandSacrifice.GlobalProductionMult(Game.State).ToString("F2")</div>
                </div>
                <div class="p-2 rounded-[10px]" style="background: rgba(15,10,36,0.5);">
                    <div class="text-[0.6rem] text-amber-300 uppercase tracking-wider">Gold</div>
                    <div class="font-display text-sm text-amber-100">×@GrandSacrifice.GlobalProductionMult(Game.State).ToString("F2")</div>
                </div>
                <div class="p-2 rounded-[10px]" style="background: rgba(15,10,36,0.5);">
                    <div class="text-[0.6rem] text-cyan-400 uppercase tracking-wider">Agents</div>
                    <div class="font-display text-sm text-amber-100">×@GrandSacrifice.GlobalProductionMult(Game.State).ToString("F2")</div>
                </div>
            </div>
        </div>
        <div class="p-3 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="flex items-center justify-between mb-2"><span class="text-xs text-violet-300 tracking-[0.1em] uppercase">Lifetime Faith</span><span class="font-display text-sm text-amber-100">@NumberFormat.Fmt(occult.LifetimeFaith)</span></div>
            <div class="flex items-center justify-between mb-2"><span class="text-xs text-violet-300 tracking-[0.1em] uppercase">Grand Sacrifices</span><span class="font-display text-sm text-amber-100">@Game.State.GrandSacrificeCount</span></div>
            <div class="flex items-center justify-between"><span class="text-xs text-violet-300 tracking-[0.1em] uppercase">Favor Yield</span><span class="font-display text-sm text-emerald-400">+@NumberFormat.Fmt(GrandSacrifice.CalculateFavor(Game.State))</span></div>
        </div>
        @if (canSacrifice)
        {
            <button class="w-full py-3 rounded-full font-display text-sm font-semibold tracking-[0.2em] uppercase cursor-pointer transition-all duration-200 hover:scale-[1.02]" style="background: linear-gradient(135deg, #4c1d95, #2e1065); border: 1px solid rgba(167,139,250,0.3); color: var(--gold-pale);" @onclick="DoSacrifice">Perform Grand Sacrifice</button>
            <p class="text-xs text-rose-400 text-center">Warning: This resets ALL progress — every coven, building, agent, and map node is lost. Your Eldritch Favor is permanent.</p>
        }
        else { <p class="text-xs text-slate-400 text-center">Accumulate @NumberFormat.Fmt(OccultBalance.FavorDivisor) lifetime faith to earn 1 Eldritch Favor.</p> }
    </div>
</div>

@code {
    private OccultState occult => Game.State.Occult;
    private bool canSacrifice => GrandSacrifice.CanSacrifice(Game.State);
    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    private void DoSacrifice() { Game.PerformGrandSacrifice(); }
    public void Dispose() => Game.OnChange -= StateChanged;
}
