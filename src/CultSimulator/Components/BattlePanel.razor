@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService LocationService
@implements IDisposable

@{
    var sw = Game.State.ShadowWarOrInit;
    var losses = Game.RecentTerritoryLosses;
    var activeRivals = Game.ActiveRivals.ToList();
}

<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <div class="flex items-center justify-between mb-3">
        <h2 class="panel-title">⚔️ Shadow Battle</h2>
        <button class="ley-line-shortcut-btn" @onclick="OnViewMap">
            <span>🗺️</span> View on Map
        </button>
    </div>
    <p class="text-sm text-violet-300 mb-4 leading-6">
        Rival cults threaten your hold on the world. When you control <strong class="text-amber-200">2 or more covens in the same continent</strong>, a rival will emerge. Recruit agents below, deploy them to a Battle Theatre, then launch your attack. <strong class="text-rose-300">Agents used in battle are lost forever</strong> — win for a Faith bonus, or lose and your Suspicion rises. Choose your battles wisely.
    </p>

    <div class="grid grid-cols-3 gap-3">
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-cyan-400 uppercase tracking-wider mb-1">Agent Pool</div>
            <div class="font-display text-lg text-amber-100">@((int)sw.AvailableAgents) / @((int)sw.TotalAgents)</div>
            <div class="text-[10px] text-slate-400">+@ShadowWarEngine.AgentProductionPerSec(sw, Game.State).ToString("F2")/s</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Spend to recruit units</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-emerald-400 uppercase tracking-wider mb-1">Strength</div>
            <div class="font-display text-lg text-amber-100">×@ShadowWarEngine.AgentStrength(sw, Game.State).ToString("F2")</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Multiplies all agent ATK</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-amber-400 uppercase tracking-wider mb-1">Controlled</div>
            <div class="font-display text-lg text-amber-100">@sw.TotalControlled</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Institutions seized</div>
        </div>
    </div>

    @if (losses.Count > 0)
    {
        <div class="mt-3 p-2.5 rounded-[12px] text-xs" style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2);">
            <div class="text-rose-300 mb-1 font-medium">Recent Territory Losses</div>
            @foreach (var loss in losses)
            {
                <div class="text-slate-400 text-[0.7rem]">@loss.RivalName took @loss.ContinentId</div>
            }
        </div>
    }
</div>

@if (activeRivals.Count > 0)
{
    <div class="panel rounded-[20px] p-5 mb-4" style="background: linear-gradient(135deg, rgba(30,10,40,0.8), rgba(10,5,20,0.9)); border: 2px solid rgba(239,68,68,0.3); box-shadow: 0 0 30px rgba(239,68,68,0.1);">
        <div class="flex items-center gap-2 mb-2">
            <span class="text-2xl">☠️</span>
            <h2 class="panel-title text-rose-200">Rival Cult Assault</h2>
        </div>
        <p class="text-sm text-rose-300 mb-4 leading-6">
            These are the most powerful enemies in the world. Each rival commands hundreds of agents and controls institutions across their continent.
            <strong class="text-amber-200">Defeating a rival permanently destroys them</strong> and grants a massive Faith reward — but their HP is enormous and their counterattack devastating. Stockpile your best agents before engaging.
        </p>

        @foreach (var (def, rivalState) in activeRivals)
        {
            var battle = Game.GetRivalBattle(def.Id);
            var isDefeated = rivalState.Defeated;

            <div class="mb-4 p-4 rounded-[16px] @(isDefeated ? "opacity-40" : "")" style="background: rgba(15,10,36,0.6); border: 1px solid rgba(239,68,68,0.2);">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <span class="text-3xl">@def.Icon</span>
                        <div>
                            <div class="font-display text-base font-bold text-rose-200">@def.Name</div>
                            <div class="text-[0.65rem] text-slate-400 uppercase tracking-wider">@ContinentName(def.PreferredTerritoryId) · Power: @((int)rivalState.Power)</div>
                        </div>
                    </div>
                    @if (isDefeated)
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-medium">DEFEATED</span>
                    }
                    else if (battle != null && battle.Phase == RivalBattlePhase.Fighting)
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-rose-500/20 text-rose-300 animate-pulse font-medium">IN COMBAT</span>
                    }
                    else if (battle != null && battle.Phase == RivalBattlePhase.Deploy)
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 font-medium">DEPLOYING</span>
                    }
                    else
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-slate-500/20 text-slate-300">@rivalState.Status</span>
                    }
                </div>

                <p class="text-xs text-slate-400 mb-3 italic">@def.Description</p>

                @if (!isDefeated && battle != null)
                {
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <div class="text-[0.65rem] text-emerald-400 uppercase tracking-wider mb-1">Your Force HP</div>
                            <div class="text-emerald-300 font-display text-sm">@((int)battle.PlayerHp) / @((int)battle.PlayerMaxHp)</div>
                            <div class="w-full h-2.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-emerald-400 rounded-full transition-all duration-300" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="text-[0.65rem] text-rose-400 uppercase tracking-wider mb-1">Rival HP</div>
                            <div class="text-rose-300 font-display text-sm">@((int)battle.RivalHp) / @((int)battle.RivalMaxHp)</div>
                            <div class="w-full h-2.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-rose-400 rounded-full transition-all duration-300" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                    </div>

                    @if (battle.DeployedSquad.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1.5 mb-3">
                            @foreach (var slot in battle.DeployedSquad)
                            {
                                var agentDef = BattleData.AgentDef(slot.Type);
                                <div class="text-[0.65rem] px-2 py-1 rounded-[8px] flex items-center gap-1" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                                    <span>@agentDef?.Icon</span>
                                    <span class="text-amber-200">@slot.Count</span>
                                </div>
                            }
                        </div>
                    }

                    @if (battle.Phase == RivalBattlePhase.Deploy)
                    {
                        <div class="grid grid-cols-3 gap-2 mb-3">
                            @foreach (var agentDef in BattleData.AgentTypes)
                            {
                                sw.RecruitedAgents.TryGetValue(agentDef.Type, out int avail);
                                <button class="battle-agent-card p-2.5 rounded-[10px] text-center transition-all hover:-translate-y-0.5 @(avail == 0 ? "opacity-40" : "")"
                                        style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);"
                                        disabled="@(avail == 0)"
                                        @onclick="() => OnDeployRival(def.Id, agentDef.Type)">
                                    <div class="text-xl mb-0.5">@agentDef.Icon</div>
                                    <div class="text-[0.65rem] text-amber-200">@agentDef.Name</div>
                                    <div class="text-[0.55rem] text-slate-400">@avail available</div>
                                </button>
                            }
                        </div>
                        <div class="flex gap-2">
                            <button class="flex-1 p-2.5 rounded-[10px] text-xs text-slate-300 transition-all hover:bg-slate-500/10"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                    @onclick="() => OnWithdrawRival(def.Id)">
                                Withdraw
                            </button>
                            <button class="flex-[2] p-2.5 rounded-[10px] text-sm text-rose-100 font-bold transition-all hover:bg-rose-500/20 hover:border-rose-500/40"
                                    style="background: rgba(127,29,29,0.4); border: 1px solid rgba(239,68,68,0.3);"
                                    disabled="@(battle.TotalDeployed == 0)"
                                    @onclick="() => OnStartRivalBattle(def.Id)">
                                ⚔️ Launch Assault
                            </button>
                        </div>
                    }
                    else if (battle.Phase == RivalBattlePhase.Fighting)
                    {
                        <div class="text-center text-sm text-rose-300 py-3 animate-pulse font-medium">⚔️ Battle in progress...</div>
                    }
                    else if (battle.Phase == RivalBattlePhase.Defeat)
                    {
                        <div class="text-center text-sm text-rose-400 py-2 mb-2">Your forces were crushed. Regroup and try again.</div>
                        <button class="w-full p-2.5 rounded-[10px] text-sm text-amber-100 font-medium transition-all hover:bg-amber-500/10"
                                style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                @onclick="() => OnRetryRival(def.Id)">
                            Regroup
                        </button>
                    }

                    @if (battle.Log.Count > 0)
                    {
                        <div class="mt-2 p-2 rounded-[8px] text-[0.65rem] space-y-0.5 max-h-20 overflow-y-auto" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                            @foreach (var entry in battle.Log.TakeLast(4))
                            {
                                <div class="text-slate-400">@entry</div>
                            }
                        </div>
                    }
                }
                else if (!isDefeated && battle == null)
                {
                    <button class="w-full p-3 rounded-[12px] text-sm text-rose-100 font-bold transition-all hover:bg-rose-500/20 hover:border-rose-500/40"
                            style="background: rgba(127,29,29,0.3); border: 1px solid rgba(239,68,68,0.25);"
                            @onclick="() => OnStartRivalBattle(def.Id)">
                        ⚔️ Begin Assault on @def.Name
                    </button>
                }
            </div>
        }
    </div>
}

<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <h2 class="panel-title mb-3">Recruit Agents</h2>
    <p class="text-xs text-slate-400 mb-4 leading-relaxed">Spend agents from your pool to recruit units. Each unit type has different stats and costs.</p>

    <div class="grid grid-cols-3 gap-3">
        @foreach (var agentDef in BattleData.AgentTypes)
        {
            sw.RecruitedAgents.TryGetValue(agentDef.Type, out int owned);
            <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="text-xl mb-1">@agentDef.Icon</div>
                <div class="text-sm font-display text-amber-100">@agentDef.Name</div>
                <div class="text-[0.6rem] text-slate-400 mt-1">ATK @agentDef.Attack / DEF @agentDef.Defense / STL @agentDef.Stealth</div>
                <div class="text-[0.6rem] text-cyan-400 mt-1">Cost: @agentDef.AgentCost agents</div>
                <div class="text-[0.6rem] text-slate-500">Owned: @owned</div>
                <button class="mt-2 w-full p-1.5 rounded-[8px] text-xs text-amber-100 transition-all hover:bg-amber-500/10 hover:border-amber-500/30"
                        style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                        @onclick="() => OnRecruit(agentDef.Type, 1)">
                    Recruit
                </button>
            </div>
        }
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title mb-3">Battle Theatres</h2>
    <p class="text-xs text-slate-400 mb-4 leading-relaxed">Each continent where you control 2+ covens becomes a Battle Theatre. Recruit agents from the pool above, deploy them here, then start the battle. Victory grants a Faith bonus based on your total covens.</p>

    <div class="flex flex-col gap-3">
        @foreach (var theater in BattleData.Theaters)
        {
            bool active = BattleEngine.IsTheaterActive(Game.State, LocationService, theater.ContinentId);
            var battle = active ? BattleEngine.GetOrCreateBattle(Game.State, LocationService, theater.ContinentId) : Game.State.BattleSystem?.GetBattle(theater.ContinentId);

            <div class="p-4 rounded-[16px] @(active ? "" : "opacity-50")" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">@theater.Icon</span>
                        <span class="font-display text-sm font-semibold text-amber-100">@theater.Name</span>
                    </div>
                    @if (active)
                    {
                        <span class="text-[0.6rem] px-2 py-0.5 rounded-full @(battle?.Phase == BattlePhase.Fighting ? "bg-rose-500/20 text-rose-300" : battle?.Phase == BattlePhase.Deploy ? "bg-amber-500/20 text-amber-300" : "bg-slate-500/20 text-slate-300")">@battle?.Phase</span>
                    }
                    else
                    {
                        <span class="text-[0.6rem] px-2 py-0.5 rounded-full bg-slate-500/20 text-slate-400">Inactive</span>
                    }
                </div>

                @if (active && battle != null)
                {
                    <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                        <div>
                            <div class="text-slate-400 text-[0.65rem] mb-0.5">Your HP</div>
                            <div class="text-emerald-300 font-display">@((int)battle.PlayerHp) / @((int)battle.PlayerMaxHp)</div>
                            <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-emerald-400 rounded-full transition-all duration-300" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="text-slate-400 text-[0.65rem] mb-0.5">Rival HP</div>
                            <div class="text-rose-300 font-display">@((int)battle.RivalHp) / @((int)battle.RivalMaxHp)</div>
                            <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-rose-400 rounded-full transition-all duration-300" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                    </div>

                    @if (battle.DeployedSquad.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1.5 mb-3">
                            @foreach (var slot in battle.DeployedSquad)
                            {
                                var def = BattleData.AgentDef(slot.Type);
                                <div class="text-[0.65rem] px-2 py-1 rounded-[8px] flex items-center gap-1" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                                    <span>@def?.Icon</span>
                                    <span class="text-amber-200">@slot.Count</span>
                                </div>
                            }
                        </div>
                    }

                    @if (battle.Phase == BattlePhase.Deploy)
                    {
                        <div class="grid grid-cols-3 gap-2 mb-3">
                            @foreach (var agentDef in BattleData.AgentTypes)
                            {
                                sw.RecruitedAgents.TryGetValue(agentDef.Type, out int avail);
                                <button class="battle-agent-card p-2 rounded-[8px] text-center transition-all hover:-translate-y-0.5"
                                        style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);"
                                        @onclick="() => OnDeploy(theater.ContinentId, agentDef.Type)">
                                    <div class="text-lg mb-0.5">@agentDef.Icon</div>
                                    <div class="text-[0.6rem] text-amber-200">@agentDef.Name</div>
                                    <div class="text-[0.55rem] text-slate-400">@avail available</div>
                                </button>
                            }
                        </div>
                        <div class="flex gap-2">
                            <button class="flex-1 p-2 rounded-[10px] text-xs text-slate-300 transition-all hover:bg-slate-500/10"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                    @onclick="() => OnWithdraw(theater.ContinentId)">
                                Withdraw
                            </button>
                            <button class="flex-1 p-2 rounded-[10px] text-xs text-amber-100 font-medium transition-all hover:bg-amber-500/10 hover:border-amber-500/30"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                    @onclick="() => OnStartBattle(theater.ContinentId)">
                                Start Battle
                            </button>
                        </div>
                    }
                    else if (battle.Phase == BattlePhase.Fighting)
                    {
                        <div class="text-center text-xs text-rose-300 py-2">Battle in progress...</div>
                    }
                    else if (battle.Phase == BattlePhase.Cooldown)
                    {
                        <div class="text-center text-xs text-slate-400 py-2">Cooldown active...</div>
                    }

                    @if (battle.Log.Count > 0)
                    {
                        <div class="mt-2 p-2 rounded-[8px] text-[0.65rem] space-y-0.5 max-h-24 overflow-y-auto" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                            @foreach (var entry in battle.Log.TakeLast(5))
                            {
                                <div class="text-slate-400">@entry</div>
                            }
                        </div>
                    }
                }
                else if (!active)
                {
                    <div class="text-xs text-slate-500 text-center py-2">Control 2+ covens in this continent to activate.</div>
                }
            </div>
        }
    </div>
</div>


@code {
    [Parameter] public EventCallback OnViewMap { get; set; }

    private void StateChanged() => StateHasChanged();

    protected override void OnInitialized() => Game.OnChange += StateChanged;

    private void OnRecruit(AgentType type, int count) => Game.RecruitAgent(type, count);
    private void OnDeploy(string continentId, AgentType type) => Game.DeployAgents(continentId, type, 1);
    private void OnStartBattle(string continentId) => Game.StartBattle(continentId);
    private void OnWithdraw(string continentId) => Game.WithdrawBattleAgents(continentId);

    private void OnDeployRival(string rivalId, AgentType type) => Game.DeployRivalBattleAgents(rivalId, type, 1);
    private void OnWithdrawRival(string rivalId) => Game.WithdrawRivalBattleAgents(rivalId);
    private void OnStartRivalBattle(string rivalId) => Game.StartRivalBattle(rivalId);
    private void OnRetryRival(string rivalId)
    {
        Game.WithdrawRivalBattleAgents(rivalId);
        var battle = Game.GetRivalBattle(rivalId);
        if (battle != null) battle.Phase = RivalBattlePhase.Deploy;
        StateHasChanged();
    }

    private static string ContinentName(string continent) => continent switch
    {
        "europe" => "Europe",
        "north_america" => "North America",
        "south_america" => "South America",
        "asia" => "Asia",
        "oceania" => "Oceania",
        "africa" => "Africa",
        "middle_east" => "Middle East",
        _ => continent
    };

    public void Dispose() => Game.OnChange -= StateChanged;
}
