@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService LocationService
@inject IJSRuntime JS
@implements IDisposable

@{
    var sw = Game.State.ShadowWarOrInit;
    var losses = Game.RecentTerritoryLosses;
    var warElixirActive = Game.State.Occult.ElixirWarStrengthMult > 1.0 && Game.State.Occult.ElixirTimer > 0;
    var agentCap = ShadowWarEngine.AgentPoolCap(Game.State);
    var guildLevel = Game.State.Covens.Where(c => c.TakenOver).Sum(c => c.Buildings.GetValueOrDefault(BuildingType.ShadowGuild));
    var safehouseLevel = Game.State.Covens.Where(c => c.TakenOver).Sum(c => c.Buildings.GetValueOrDefault(BuildingType.Safehouse));
    var atCap = (int)sw.AvailableAgents >= agentCap && sw.TotalAgents >= agentCap;
    var poolAgents = (int)sw.AvailableAgents;
    var totalRecruited = sw.RecruitedAgents.Values.Sum();
    var productionRate = ShadowWarEngine.AgentProductionPerSec(sw, Game.State);
    var fractional = sw.TotalAgents - Math.Floor(sw.TotalAgents);
    var agentProgressPercent = (int)(fractional * 100);
    var secondsToNext = productionRate > 0 ? (1.0 - fractional) / productionRate : 0;
    var agentProgressText = secondsToNext >= 60 ? $"{(int)(secondsToNext / 60)}m {Math.Ceiling(secondsToNext % 60)}s" : $"{Math.Ceiling(secondsToNext)}s";
    var strengthMult = ShadowWarEngine.AgentStrength(sw, Game.State);
    if (warElixirActive) strengthMult *= Game.State.Occult.ElixirWarStrengthMult;
}

<div class="battle-panel-scroll">
<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <div class="flex items-center justify-between mb-3">
        <h2 class="panel-title">⚔️ Shadow Battle</h2>
        <button class="ley-line-shortcut-btn" @onclick="OnViewMap">
            <span>🗺️</span> View on Map
        </button>
    </div>
    <p class="text-sm text-violet-300 mb-4 leading-6">
        Rival cults emerge as continent bosses when you fully convert a continent. Recruit agents below, deploy them to a Battle Theatre, then launch your attack. <strong class="text-rose-300">Agents used in battle are lost forever</strong> — win for a Faith bonus, or lose and you forfeit 100 Faith. Choose your battles wisely.
    </p>

    <div class="grid grid-cols-3 gap-3">
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-cyan-400 uppercase tracking-wider mb-1">Agent Pool</div>
            <div class="font-display text-lg text-amber-100">@poolAgents / @agentCap</div>
            <div class="text-[10px] text-slate-400">+@productionRate.ToString("F2")/s</div>
            @if (!atCap && productionRate > 0)
            {
                <div class="mt-1.5 mx-auto" style="max-width: 120px;">
                    <div class="h-1.5 rounded-full bg-stone-800 overflow-hidden">
                        <div class="h-full rounded-full transition-all duration-300" style="width: @(agentProgressPercent)%; background: linear-gradient(90deg, #06b6d4, #0891b2);"></div>
                    </div>
                    <div class="text-[9px] text-slate-500 mt-0.5">@agentProgressText until next agent</div>
                </div>
            }
            @if (atCap)
            {
                <div class="text-[10px] text-amber-400 font-medium mt-0.5">⚠ Pool full — build Safehouses</div>
            }
            else if (productionRate <= 0)
            {
                <div class="text-[10px] text-slate-500 mt-0.5">Spend to recruit units</div>
            }
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-emerald-400 uppercase tracking-wider mb-1">Strength</div>
            <div class="font-display text-lg text-amber-100">×@strengthMult.ToString("F2")</div>
            @if (warElixirActive)
            {
                <div class="text-[10px] text-amber-400 font-medium">⚗️ War Elixir: ×@Game.State.Occult.ElixirWarStrengthMult.ToString("F1") (@((int)Game.State.Occult.ElixirTimer)s left)</div>
            }
            else
            {
                <div class="text-[10px] text-slate-500 mt-0.5">Multiplies all agent ATK in battle</div>
            }
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-amber-400 uppercase tracking-wider mb-1">Bosses</div>
            <div class="font-display text-lg text-amber-100">@Game.State.RivalCultsOrInit.Rivals.Count(r => r.Defeated) / @RivalCultData.Rivals.Length</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Continents conquered</div>
        </div>
    </div>

    @if (warElixirActive)
    {
        <div class="mt-3 p-2.5 rounded-[12px] text-xs flex items-center gap-2" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
            <span class="text-base">⚗️</span>
            <span class="text-amber-300">War Elixir active — your battle agents deal <strong>@((int)((Game.State.Occult.ElixirWarStrengthMult - 1) * 100))% extra damage</strong> for @((int)Game.State.Occult.ElixirTimer)s more.</span>
        </div>
    }

    <div class="mt-3 p-2.5 rounded-[12px] text-xs leading-5" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
        <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider mb-1">How to Get More Agents</div>
        <div class="text-slate-400 space-y-0.5">
            <div><strong class="text-amber-200">🏰 Shadow Guild</strong> (@guildLevel owned) — Boosts agent production speed by +@((int)(GameBalance.ShadowGuildAgentSpeedBonus * 100))% per building. Currently: ×@((1.0 + guildLevel * GameBalance.ShadowGuildAgentSpeedBonus).ToString("F2")) production.</div>
            <div><strong class="text-amber-200">🏠 Safehouse</strong> (@safehouseLevel owned) — Raises your agent pool cap by +@((int)GameBalance.SafehouseAgentCapBonus) per building. Currently: @agentCap max.</div>
            <div class="text-slate-500 text-[0.65rem] mt-1">Build or upgrade these in the <strong>Build</strong> tab to increase your agent flow. All covens contribute — build in any taken-over coven.</div>
        </div>
    </div>

    <div class="mt-2 p-2.5 rounded-[12px] text-xs leading-5" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
        <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider mb-1">How to Increase Strength</div>
        <div class="text-slate-400 space-y-0.5">
            <div><strong class="text-amber-200">📖 Shadow Tactics</strong> — Research this tech in the Grimoire to multiply all Strength by ×1.25.</div>
            <div><strong class="text-amber-200">⚗️ War Elixir</strong> — Brew a War Elixir in the Cauldron for a temporary ×1.5 Strength boost during battle.</div>
            <div class="text-slate-500 text-[0.65rem] mt-1">Strength multiplies every agent's attack damage in all battles — the higher it is, the faster enemies fall.</div>
        </div>
    </div>

    @if (losses.Count > 0)
    {
        <div class="mt-3 p-2.5 rounded-[12px] text-xs" style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2);">
            <div class="text-rose-300 mb-1 font-medium">Recent Territory Losses</div>
            @foreach (var loss in losses)
            {
                <div class="text-slate-400 text-[0.7rem]">@loss.RivalName took @loss.ContinentId</div>
            }
        </div>
    }
</div>

<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <h2 class="panel-title mb-3">Shadow Constructions</h2>
    <p class="text-xs text-slate-400 mb-4 leading-relaxed">These constructions enhance the global agent pool. All covens contribute — building these in any coven boosts agent generation and capacity across your entire cult.</p>
    <div class="building-list flex flex-col gap-2.5">
        @foreach (var def in GameData.Buildings.Where(b => GameData.ShadowWarBuildings.Contains(b.Type)))
        {
            var totalOwned = Game.State.Covens.Where(c => c.TakenOver).Sum(c => c.Buildings.GetValueOrDefault(def.Type));
            var activeCoven = Game.State.ActiveCoven;
            var owned = activeCoven.Buildings.GetValueOrDefault(def.Type);
            var cost = GameEngine.BuildingCost(def, owned);
            var affordable = activeCoven.Gold >= cost;
            <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full
                          disabled:opacity-45 disabled:cursor-not-allowed
                          hover:not(:disabled):bg-amber-500/10 hover:not(:disabled):border-amber-500/30"
                    style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                    disabled="@(!affordable)" @onclick="() => Game.BuyBuilding(def.Type)">
                <div class="building-icon text-3xl flex-shrink-0">@def.Icon</div>
                <div class="building-info flex-1 flex flex-col gap-0.5">
                    <span class="building-name font-display text-base text-amber-100 font-medium">@def.Name</span>
                    <span class="building-effect text-xs text-emerald-400">@def.EffectDescription</span>
                    <span class="building-owned text-[0.7rem] text-violet-300">this coven: @owned · all covens: @totalOwned</span>
                </div>
                <div class="building-cost flex items-baseline gap-1 flex-shrink-0">
                    <span class="cost-value font-display font-semibold text-amber-400 text-base">@NumberFormat.Fmt(cost)</span>
                    <span class="cost-icon text-sm">💰</span>
                </div>
            </button>
        }
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5 mb-4" id="recruit-section">
    <div class="flex items-center gap-2 mb-1">
        <span class="deploy-step-badge">Step 1</span>
        <h2 class="panel-title">Recruit Agents</h2>
    </div>
    <p class="text-xs text-slate-400 mb-3 leading-relaxed">
        Spend agents from your pool (@poolAgents available) to recruit battle units. Each unit type has different strengths.
    </p>

    <div class="mb-3 p-2.5 rounded-[12px] text-xs leading-5" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
        <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider mb-1">Understanding Agent Stats</div>
        <div class="text-slate-400 space-y-0.5">
            <div><strong class="text-rose-300">⚔ ATK</strong> — Damage dealt to the rival per second. Multiplied by your Strength.</div>
            <div><strong class="text-cyan-300">🛡 DEF</strong> — Reduces damage your squad takes from counterattacks.</div>
            <div><strong class="text-emerald-300">👁 STL</strong> — Higher stealth reduces rival counterattack damage. <strong class="text-amber-200">Infiltrators</strong> are key to minimizing losses.</div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        @foreach (var agentDef in BattleData.AgentTypes)
        {
            sw.RecruitedAgents.TryGetValue(agentDef.Type, out int owned);
            var maxForType = BattleEngine.MaxAgentsForType(sw, Game.State, agentDef.Type);
            var canAfford = poolAgents >= agentDef.AgentCost;
            <div class="deploy-recruit-card @(owned == 0 && !canAfford ? "opacity-50" : "")">
                <div class="flex items-start gap-3">
                    <span class="text-2xl flex-shrink-0">@agentDef.Icon</span>
                    <div class="flex-1 min-w-0">
                        <div class="font-display text-sm text-amber-100 font-medium">@agentDef.Name</div>
                        <div class="deploy-agent-stats text-[0.6rem] mt-0.5">
                            <span class="text-rose-300">⚔ @agentDef.Attack</span>
                            <span class="text-cyan-300">🛡 @agentDef.Defense</span>
                            <span class="text-emerald-300">👁 @agentDef.Stealth</span>
                        </div>
                        <div class="text-[0.55rem] text-slate-500 mt-1 leading-tight">@agentDef.Description</div>
                    </div>
                </div>
                <div class="flex items-center justify-between mt-3">
                    <div class="text-[0.6rem]">
                        <div class="text-cyan-400">Cost: @agentDef.AgentCost pool agents</div>
                        @if (agentDef.Type != AgentType.Initiate && maxForType == 0)
                        {
                            <div class="text-amber-400">Recruit @agentDef.Name in the Sanctum first</div>
                        }
                        else
                        {
                            <div class="text-slate-400">Owned: @owned@(agentDef.Type != AgentType.Initiate ? $" / {maxForType} max" : "")</div>
                        }
                    </div>
                    <button class="deploy-btn deploy-btn-recruit" disabled="@(!canAfford || (agentDef.Type != AgentType.Initiate && owned >= maxForType))" @onclick="() => OnRecruit(agentDef.Type, 1)">
                        Recruit
                    </button>
                </div>
            </div>
        }
    </div>

    @if (totalRecruited == 0 && poolAgents == 0)
    {
        <div class="mt-3 p-3 rounded-[12px] text-center text-xs text-slate-400" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
            Your agent pool is empty. Agents accumulate over time — build Shadow Guilds to speed up production and Safehouses to raise the cap.
        </div>
    }
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <div class="flex items-center gap-2 mb-1">
        <span class="deploy-step-badge">Step 2</span>
        <h2 class="panel-title">Battle Theatres</h2>
    </div>
    <p class="text-xs text-slate-400 mb-4 leading-relaxed">Deploy your recruited agents here, then launch the attack. Defeating the rival completes the continent.</p>

    <div class="flex flex-col gap-3">
        @foreach (var theater in BattleData.Theaters)
        {
            bool active = BattleEngine.IsTheaterActive(Game.State, LocationService, theater.ContinentId);
            var battle = active ? BattleEngine.GetOrCreateBattle(Game.State, LocationService, theater.ContinentId) : Game.State.BattleSystem?.GetBattle(theater.ContinentId);

            <div class="p-4 rounded-[16px] @(active ? "" : "opacity-50")" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">@theater.Icon</span>
                        <span class="font-display text-sm font-semibold text-amber-100">@theater.Name</span>
                    </div>
                    @if (active)
                    {
                        <span class="text-[0.6rem] px-2 py-0.5 rounded-full @(battle?.Phase == BattlePhase.Fighting ? "bg-rose-500/20 text-rose-300" : battle?.Phase == BattlePhase.Deploy ? "bg-amber-500/20 text-amber-300" : "bg-slate-500/20 text-slate-300")">@(battle?.Phase == BattlePhase.Deploy ? "Ready" : battle?.Phase == BattlePhase.Fighting ? "Fighting" : battle?.Phase == BattlePhase.Cooldown ? "Cooldown" : "No threat")</span>
                    }
                    else
                    {
                        <span class="text-[0.6rem] px-2 py-0.5 rounded-full bg-slate-500/20 text-slate-400">Inactive</span>
                    }
                </div>

                @if (active && battle != null)
                {
                    <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                        <div>
                            <div class="text-slate-400 text-[0.65rem] mb-0.5">Your HP</div>
                            <div class="text-emerald-300 font-display">@((int)battle.PlayerHp) / @((int)battle.PlayerMaxHp)</div>
                            <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-emerald-400 rounded-full transition-all duration-300" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="text-slate-400 text-[0.65rem] mb-0.5">Rival HP</div>
                            <div class="text-rose-300 font-display">@((int)battle.RivalHp) / @((int)battle.RivalMaxHp)</div>
                            <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-rose-400 rounded-full transition-all duration-300" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                    </div>

                    @if (battle.DeployedSquad.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1.5 mb-3">
                            @foreach (var slot in battle.DeployedSquad)
                            {
                                var def = BattleData.AgentDef(slot.Type);
                                <div class="text-[0.65rem] px-2 py-1 rounded-[8px] flex items-center gap-1" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                                    <span>@def?.Icon</span>
                                    <span class="text-amber-200">@slot.Count</span>
                                </div>
                            }
                        </div>
                    }

                    @if (battle.Phase == BattlePhase.Deploy)
                    {
                        @if (BuildTheaterRecon(theater) is { } theaterRecon)
                        {
                            <EnemyReconCard Recon="theaterRecon" />
                        }

                        <div class="battle-info-summary mb-3">
                            <div class="battle-info-row">
                                <span class="battle-info-label">Pool Agents</span>
                                <span class="battle-info-value text-cyan-300">@poolAgents</span>
                            </div>
                            @if (totalRecruited > 0)
                            {
                                <div class="battle-info-row">
                                    <span class="battle-info-label">Recruited Units</span>
                                    <span class="battle-info-value text-amber-200">@totalRecruited</span>
                                </div>
                                <div class="battle-info-units">
                                    @foreach (var agentDef in BattleData.AgentTypes)
                                    {
                                        sw.RecruitedAgents.TryGetValue(agentDef.Type, out int unitCount);
                                        if (unitCount > 0)
                                        {
                                            <span class="battle-info-unit-chip"><span>@agentDef.Icon</span> @agentDef.Name: @unitCount</span>
                                        }
                                    }
                                </div>
                                <div class="battle-info-row">
                                    <span class="battle-info-label">Deployed Strength</span>
                                    <span class="battle-info-value text-emerald-300">@CalcDeployedStrength(battle.DeployedSquad).ToString("F1")</span>
                                </div>
                            }
                            else
                            {
                                <div class="battle-info-row">
                                    <span class="battle-info-label">Recruited Units</span>
                                    <span class="battle-info-value text-rose-300">0 — recruit first!</span>
                                </div>
                            }
                        </div>

                        @if (totalRecruited == 0)
                        {
                            <div class="flex gap-2">
                                <button class="flex-1 p-2.5 rounded-[10px] text-xs text-amber-100 font-medium transition-all hover:bg-amber-500/10 hover:border-amber-500/30"
                                        style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                        @onclick="ScrollToRecruit">
                                    ⬆ Recruit Agents First
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-3 gap-2 mb-3">
                                @foreach (var agentDef in BattleData.AgentTypes)
                                {
                                    sw.RecruitedAgents.TryGetValue(agentDef.Type, out int avail);
                                    <button class="battle-agent-card p-2 rounded-[8px] text-center transition-all hover:-translate-y-0.5"
                                            style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);"
                                            @onclick="() => OnDeploy(theater.ContinentId, agentDef.Type)">
                                        <div class="text-lg mb-0.5">@agentDef.Icon</div>
                                        <div class="text-[0.6rem] text-amber-200">@agentDef.Name</div>
                                        <div class="text-[0.55rem] text-slate-400">@avail available</div>
                                    </button>
                                }
                            </div>
                            <div class="flex gap-2">
                                <button class="flex-1 p-2 rounded-[10px] text-xs text-slate-300 transition-all hover:bg-slate-500/10"
                                        style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                        @onclick="() => OnWithdraw(theater.ContinentId)">
                                    Withdraw
                                </button>
                                <button class="flex-1 p-2 rounded-[10px] text-xs text-amber-100 font-medium transition-all hover:bg-amber-500/10 hover:border-amber-500/30"
                                        style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                        @onclick="() => OnStartBattle(theater.ContinentId)">
                                    Start Battle
                                </button>
                            </div>
                        }
                    }
                    else if (battle.Phase == BattlePhase.Fighting)
                    {
                        <BattleView IsFighting="true"
                                    RecentRounds="battle.RecentRounds"
                                    EnemyUnits="battle.EnemyUnits"
                                    Momentum="battle.Momentum"
                                    PlayerHp="battle.PlayerHp"
                                    PlayerMaxHp="battle.PlayerMaxHp"
                                    RivalHp="battle.RivalHp"
                                    RivalMaxHp="battle.RivalMaxHp" />
                    }
                    else if (battle.Phase == BattlePhase.Cooldown)
                    {
                        <div class="p-4 rounded-[14px] mb-3 text-center animate-fade-in" style="background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.25);">
                            <div class="text-2xl mb-2">🏆</div>
                            <div class="text-sm text-emerald-300 font-medium mb-1">Victory!</div>
                            <div class="text-[0.65rem] text-amber-200">+@NumberFormat.Fmt(battle.LastFaithReward) Faith earned</div>
                            <div class="text-[0.6rem] text-slate-400 mt-1">The rival has been pushed back. Preparing for the next assault...</div>
                        </div>
                    }

                    @if (battle.Log.Count > 0)
                    {
                        <div class="mt-2 p-2 rounded-[8px] text-[0.65rem] space-y-0.5 max-h-24 overflow-y-auto" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                            @foreach (var entry in battle.Log.TakeLast(5))
                            {
                                <div class="text-slate-400">@entry</div>
                            }
                        </div>
                    }
                }
                else if (!active)
                {
                    <div class="text-xs text-slate-500 text-center py-2">Control 2+ covens in this continent to activate.</div>
                }
            </div>
        }
    </div>
</div>

@{
    var rivalSystem = Game.State.RivalCultsOrInit;
    var activeRivals = rivalSystem.Rivals.Where(r => r.Status != RivalCultStatus.Dormant && !r.Defeated).ToList();
}
@if (activeRivals.Count > 0)
{
<div class="panel glass-panel rounded-[20px] p-5 mt-4">
    <div class="flex items-center gap-2 mb-1">
        <span class="deploy-step-badge">Step 3</span>
        <h2 class="panel-title">Rival Cult Bosses</h2>
    </div>
    <p class="text-xs text-slate-400 mb-4 leading-relaxed">These are the final bosses for each continent. Defeat them to complete your conquest. They are much stronger than regular battle theatre rivals.</p>

    <div class="flex flex-col gap-3">
        @foreach (var rival in activeRivals)
        {
            var def = RivalCultData.Find(rival.Id);
            if (def == null) continue;
            var rb = Game.GetRivalBattleState(rival.Id);

            <div class="p-4 rounded-[16px]" style="background: rgba(15,10,36,0.5); border: 1px solid rgba(239,68,68,0.3);">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">@def.Icon</span>
                        <span class="font-display text-sm font-semibold text-rose-200">@def.Name</span>
                    </div>
                    <span class="text-[0.6rem] px-2 py-0.5 rounded-full @(rb?.Phase == RivalBattlePhase.Fighting ? "bg-rose-500/20 text-rose-300" : rb?.Phase == RivalBattlePhase.Deploy ? "bg-amber-500/20 text-amber-300" : "bg-slate-500/20 text-slate-300")">@(rb?.Phase == RivalBattlePhase.Deploy ? "Ready" : rb?.Phase == RivalBattlePhase.Fighting ? "Fighting" : rb?.Phase == RivalBattlePhase.Victory ? "Defeated" : "Dormant")</span>
                </div>

                @if (rb != null && rb.Phase == RivalBattlePhase.Deploy)
                {
                    @if (Game.BuildRivalBattleRecon(rival.Id) is { } rivalRecon)
                    {
                        <EnemyReconCard Recon="rivalRecon" />
                    }

                    <div class="battle-info-summary mb-3">
                        <div class="battle-info-row">
                            <span class="battle-info-label">Pool Agents</span>
                            <span class="battle-info-value text-cyan-300">@poolAgents</span>
                        </div>
                        @if (totalRecruited > 0)
                        {
                            <div class="battle-info-row">
                                <span class="battle-info-label">Recruited Units</span>
                                <span class="battle-info-value text-amber-200">@totalRecruited</span>
                            </div>
                            <div class="battle-info-units">
                                @foreach (var agentDef in BattleData.AgentTypes)
                                {
                                    sw.RecruitedAgents.TryGetValue(agentDef.Type, out int unitCount);
                                    if (unitCount > 0)
                                    {
                                        <span class="battle-info-unit-chip"><span>@agentDef.Icon</span> @agentDef.Name: @unitCount</span>
                                    }
                                }
                            </div>
                            <div class="battle-info-row">
                                <span class="battle-info-label">Deployed Strength</span>
                                <span class="battle-info-value text-emerald-300">@CalcDeployedStrength(rb.DeployedSquad).ToString("F1")</span>
                            </div>
                        }
                        else
                        {
                            <div class="battle-info-row">
                                <span class="battle-info-label">Recruited Units</span>
                                <span class="battle-info-value text-rose-300">0 — recruit first!</span>
                            </div>
                        }
                    </div>

                    @if (totalRecruited == 0)
                    {
                        <div class="flex gap-2">
                            <button class="flex-1 p-2.5 rounded-[10px] text-xs text-amber-100 font-medium transition-all hover:bg-amber-500/10 hover:border-amber-500/30"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                    @onclick="ScrollToRecruit">
                                ⬆ Recruit Agents First
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-3 gap-2 mb-3">
                            @foreach (var agentDef in BattleData.AgentTypes)
                            {
                                sw.RecruitedAgents.TryGetValue(agentDef.Type, out int avail);
                                <button class="battle-agent-card p-2 rounded-[8px] text-center transition-all hover:-translate-y-0.5"
                                        style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);"
                                        @onclick="() => Game.DeployRivalBattleAgents(rival.Id, agentDef.Type, 1)">
                                    <div class="text-lg mb-0.5">@agentDef.Icon</div>
                                    <div class="text-[0.6rem] text-amber-200">@agentDef.Name</div>
                                    <div class="text-[0.55rem] text-slate-400">@avail available</div>
                                </button>
                            }
                        </div>
                        <div class="flex gap-2">
                            <button class="flex-1 p-2 rounded-[10px] text-xs text-slate-300 transition-all hover:bg-slate-500/10"
                                    style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                    @onclick="() => Game.WithdrawRivalBattleAgents(rival.Id)">
                                Withdraw
                            </button>
                            <button class="flex-1 p-2 rounded-[10px] text-xs text-rose-100 font-medium transition-all hover:bg-rose-500/10 hover:border-rose-500/30"
                                    style="background: rgba(127,29,29,0.4); border: 1px solid rgba(239,68,68,0.3);"
                                    @onclick="() => Game.StartRivalBattle(rival.Id)">
                                Fight Boss
                            </button>
                        </div>
                    }
                }
                else if (rb != null && rb.Phase == RivalBattlePhase.Fighting)
                {
                    <BattleView IsFighting="true"
                                RecentRounds="rb.RecentRounds"
                                EnemyUnits="rb.EnemyUnits"
                                Momentum="rb.Momentum"
                                PlayerHp="rb.PlayerHp"
                                PlayerMaxHp="rb.PlayerMaxHp"
                                RivalHp="rb.RivalHp"
                                RivalMaxHp="rb.RivalMaxHp" />
                }
                else if (rb != null && rb.Phase == RivalBattlePhase.Victory)
                {
                    <div class="p-4 rounded-[14px] mb-3 text-center animate-fade-in" style="background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.25);">
                        <div class="text-2xl mb-2">👑</div>
                        <div class="text-sm text-emerald-300 font-medium mb-1">Boss Defeated!</div>
                        <div class="text-[0.65rem] text-amber-200">@def.Name has been conquered.</div>
                    </div>
                }
                else
                {
                    <div class="text-xs text-slate-500 text-center py-2">This rival is dormant. Gain more influence to provoke them.</div>
                }
            </div>
        }
    </div>
</div>
}
</div>

@code {
    [Parameter] public EventCallback OnViewMap { get; set; }

    private void StateChanged() => StateHasChanged();

    protected override void OnInitialized() => Game.OnChange += StateChanged;

    private double CalcDeployedStrength(List<DeployedAgent> squad)
    {
        double strength = ShadowWarEngine.AgentStrength(Game.State.ShadowWarOrInit, Game.State);
        if (Game.State.Occult.ElixirWarStrengthMult > 1.0 && Game.State.Occult.ElixirTimer > 0)
            strength *= Game.State.Occult.ElixirWarStrengthMult;
        double attack = 0;
        foreach (var slot in squad)
        {
            var def = BattleData.AgentDef(slot.Type);
            if (def != null) attack += def.Attack * slot.Count * strength;
        }
        return attack;
    }

    private EnemyRecon? BuildTheaterRecon(BattleTheaterDef theater)
    {
        var battle = Game.GetBattle(theater.ContinentId);
        if (battle == null) return null;
        var rival = BattleData.RivalForContinent(theater.ContinentId);
        if (rival == null) return null;
        double scale = RivalCultEngine.ScaleFor(theater.ContinentId);
        return BattleRoundEngine.BuildRecon(
            rival.Name, rival.Icon, rival.Description,
            battle.RivalMaxHp, rival.AgentStrength * scale,
            rival.Archetype, scale, 20);
    }

    private void OnRecruit(AgentType type, int count)
    {
        Game.RecruitAgent(type, count);
    }

    private void OnDeploy(string continentId, AgentType type)
    {
        Game.DeployAgents(continentId, type, 1);
    }

    private void OnStartBattle(string continentId)
    {
        Game.StartBattle(continentId);
    }

    private void OnWithdraw(string continentId)
    {
        Game.WithdrawBattleAgents(continentId);
    }

    private void ScrollToRecruit()
    {
        _ = JS.InvokeVoidAsync("eval", "document.getElementById('recruit-section')?.scrollIntoView({behavior:'smooth',block:'start'})");
    }

    public void Dispose() => Game.OnChange -= StateChanged;
}
