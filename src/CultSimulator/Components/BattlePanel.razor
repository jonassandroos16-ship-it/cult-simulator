@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService LocationService
@implements IDisposable

<div class="panel glass-panel rounded-[20px] p-5">
    <div class="flex items-center justify-between mb-4">
        <h2 class="panel-title">⚔️ Shadow Battle</h2>
        <button class="ley-line-shortcut-btn" @onclick="OnViewMap">
            <span>🗺️</span> View on Map
        </button>
    </div>
    <p class="text-sm text-violet-300 mb-3">Rival cults emerge when you control 2+ covens in a continent. Recruit agents, deploy them to battle, and fight back. Different agent types excel at different roles.</p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-cyan-400 uppercase tracking-wider">Agents</div>
            <div class="font-display text-lg text-amber-100">@((int)sw.AvailableAgents) / @((int)sw.TotalAgents)</div>
            <div class="text-[10px] text-slate-400">+@ShadowWarEngine.AgentProductionPerSec(sw, Game.State).ToString("F2")/s</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-emerald-400 uppercase tracking-wider">Strength</div>
            <div class="font-display text-lg text-amber-100">×@ShadowWarEngine.AgentStrength(sw, Game.State).ToString("F2")</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-rose-400 uppercase tracking-wider">Heat</div>
            <div class="font-display text-lg text-amber-100">@((int)sw.Heat)</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-slate-400 uppercase tracking-wider">Controlled</div>
            <div class="font-display text-lg text-amber-100">@sw.ControlledInstitutions.Count</div>
        </div>
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">YOUR FORCES</h2>
    <p class="text-xs text-slate-400 mb-3">Your recruited agents by type. Deploy them to a Battle Theatre to fight. Initiates are basic agents, Zealots hit hard, Infiltrators stay hidden.</p>
    <div class="flex flex-col gap-2.5">
        @foreach (var agentDef in BattleData.AgentTypes)
        {
            sw.RecruitedAgents.TryGetValue(agentDef.Type, out int owned);
            <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="text-3xl flex-shrink-0">@agentDef.Icon</div>
                <div class="flex-1 flex flex-col gap-0.5">
                    <div class="flex items-center gap-2">
                        <span class="font-display text-base text-amber-100 font-medium">@agentDef.Name</span>
                        <span class="text-[0.65rem] text-violet-300 px-2 py-0.5 rounded-full border border-violet-400/20">@owned owned</span>
                    </div>
                    <span class="text-xs text-slate-400">@agentDef.Description</span>
                    <span class="text-[0.68rem] text-violet-400">ATK @agentDef.Attack &middot; DEF @agentDef.Defense &middot; STEALTH @agentDef.Stealth</span>
                </div>
            </div>
        }
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">RECRUIT AGENTS</h2>
    <p class="text-xs text-slate-400 mb-3">Spend <strong class="text-amber-200">Agents</strong> (your shadow-war currency, generated passively) to recruit battle-ready units.</p>
    <div class="flex flex-col gap-2.5">
        @foreach (var agentDef in BattleData.AgentTypes)
        {
            bool canRecruit = sw.AvailableAgents >= agentDef.AgentCost;
            int maxBuy = recruitCounts.GetValueOrDefault(agentDef.Type, 1);
            <div class="upgrade-item p-3.5 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center gap-3.5">
                    <div class="text-3xl flex-shrink-0">@agentDef.Icon</div>
                    <div class="flex-1 flex flex-col gap-0.5">
                        <span class="font-display text-base text-amber-100 font-medium">@agentDef.Name</span>
                        <span class="text-xs text-slate-400">@agentDef.Description</span>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <div class="flex items-center gap-1">
                            <button class="w-6 h-6 rounded-full text-xs" style="background: rgba(100,100,100,0.3); border: 1px solid var(--panel-border); color: var(--gold-soft);" @onclick="() => AdjustCount(agentDef.Type, -1)">-</button>
                            <span class="text-sm text-amber-100 w-5 text-center">@maxBuy</span>
                            <button class="w-6 h-6 rounded-full text-xs" style="background: rgba(100,100,100,0.3); border: 1px solid var(--panel-border); color: var(--gold-soft);" @onclick="() => AdjustCount(agentDef.Type, 1)">+</button>
                        </div>
                        <button class="upgrade-buy px-3 py-1.5 rounded-full font-body font-semibold text-xs cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
                                style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);"
                                disabled="@(!canRecruit)"
                                @onclick="() => Game.RecruitBattleAgent(agentDef.Type, maxBuy)">
                            @(agentDef.AgentCost * maxBuy) 🧹
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">BATTLE THEATRES</h2>
    <p class="text-xs text-slate-400 mb-3">Active battle zones where rival cults threaten your territories. Deploy agents to fight them back.</p>
    <div class="flex flex-col gap-3">
        @foreach (var theater in BattleData.Theaters)
        {
            bool active = BattleEngine.IsTheaterActive(Game.State, LocationService, theater.ContinentId);
            var battle = Game.State.BattleSystem?.GetBattle(theater.ContinentId);
            <div class="upgrade-item p-4 rounded-[14px] @(active ? "" : "opacity-50")" style="background: rgba(15,10,36,0.5); border: 1px solid @(active ? "rgba(220,38,38,0.3)" : "var(--panel-border)");">
                <div class="flex items-center gap-3 mb-2">
                    <span class="text-2xl">@theater.Icon</span>
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-display text-sm text-amber-100 font-medium">@theater.Name</span>
                            @if (!active) { <span class="text-[0.6rem] text-slate-500 tracking-wider uppercase">Inactive — need 2+ covens</span> }
                            @if (battle?.Phase == BattlePhase.Fighting) { <span class="text-[0.6rem] text-rose-400 tracking-wider uppercase animate-pulse">FIGHTING</span> }
                            @if (battle?.Phase == BattlePhase.Deploy) { <span class="text-[0.6rem] text-amber-400 tracking-wider uppercase">RIVAL PRESENT</span> }
                            @if (battle?.Phase == BattlePhase.Cooldown) { <span class="text-[0.6rem] text-emerald-400 tracking-wider uppercase">VICTORY — COOLDOWN</span> }
                        </div>
                        <p class="text-[0.68rem] text-slate-400 mt-0.5">@theater.Description</p>
                    </div>
                </div>
                @if (active && battle != null && battle.Phase != BattlePhase.NoThreat)
                {
                    <div class="flex flex-col gap-1.5 mb-2">
                        <div class="flex items-center justify-between text-[0.68rem]">
                            <span class="text-slate-400">Your Forces</span>
                            <span class="text-amber-200">@battle.PlayerHp.ToString("F0") / @battle.PlayerMaxHp HP</span>
                        </div>
                        <div class="h-1.5 bg-white/[0.06] rounded-full overflow-hidden">
                            <div class="h-full rounded-full" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%; background: linear-gradient(90deg, var(--gold-warm), var(--gold-deep));"></div>
                        </div>
                        <div class="flex items-center justify-between text-[0.68rem]">
                            <span class="text-rose-400">Rival Cult</span>
                            <span class="text-rose-300">@battle.RivalHp.ToString("F0") / @battle.RivalMaxHp HP</span>
                        </div>
                        <div class="h-1.5 bg-white/[0.06] rounded-full overflow-hidden">
                            <div class="h-full rounded-full" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%; background: linear-gradient(90deg, #dc2626, #7f1d1d);"></div>
                        </div>
                    </div>
                    @if (battle.Phase == BattlePhase.Deploy)
                    {
                        <div class="flex gap-2 flex-wrap mb-2">
                            @foreach (var agentDef in BattleData.AgentTypes)
                            {
                                sw.RecruitedAgents.TryGetValue(agentDef.Type, out int avail);
                                <button class="px-3 py-1.5 rounded-full text-xs font-body disabled:opacity-40 disabled:cursor-not-allowed"
                                        style="background: rgba(15,10,36,0.8); border: 1px solid var(--panel-border); color: var(--gold-soft);"
                                        disabled="@(avail < 1)"
                                        @onclick="() => Game.DeployBattleAgent(theater.ContinentId, agentDef.Type, 1)">
                                    Deploy @agentDef.Name (@avail)
                                </button>
                            }
                        </div>
                        @if (battle.TotalDeployed > 0)
                        {
                            <button class="w-full py-2 rounded-[14px] font-body font-semibold text-sm"
                                    style="background: linear-gradient(135deg, #dc2626, #991b1b); border: none; color: #fef3c7; cursor: pointer;"
                                    @onclick="() => Game.StartBattle(theater.ContinentId)">
                                Launch Attack — @battle.TotalDeployed agents deployed
                            </button>
                        }
                    }
                    @if (battle.Log.Count > 0)
                    {
                        <div class="mt-2 p-2 rounded-[10px] text-[0.65rem] text-slate-400 max-h-20 overflow-y-auto" style="background: rgba(0,0,0,0.3);">
                            @foreach (var entry in Enumerable.Reverse(battle.Log).Take(5))
                            {
                                <div>@entry</div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    private ShadowWarState sw => ShadowWarEngine.EnsureInitialized(Game.State);
    private AgentType selectedAgentType = AgentType.Initiate;
    private Dictionary<AgentType, int> recruitCounts = new() { { AgentType.Initiate, 1 }, { AgentType.Zealot, 1 }, { AgentType.Infiltrator, 1 } };

    [Parameter] public EventCallback OnViewMap { get; set; }

    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private void AdjustCount(AgentType type, int delta)
    {
        recruitCounts.TryGetValue(type, out int current);
        recruitCounts[type] = Math.Max(1, current + delta);
    }

    public void Dispose() => Game.OnChange -= StateChanged;
}
