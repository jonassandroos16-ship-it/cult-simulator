@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService LocationService
@implements IDisposable

@{
    var sw = ShadowWarEngine.EnsureInitialized(Game.State);
    var losses = Game.RecentTerritoryLosses;
}

<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <div class="flex items-center justify-between mb-3">
        <h2 class="panel-title">⚔️ Shadow Battle</h2>
        <button class="ley-line-shortcut-btn" @onclick="OnViewMap">
            <span>🗺️</span> View on Map
        </button>
    </div>
    <p class="text-sm text-violet-300 mb-4 leading-6">
        Rival cults threaten your hold on the world. When you control <strong class="text-amber-200">2 or more covens in the same continent</strong>, a rival will emerge. Recruit agents below, deploy them to a Battle Theatre, then launch your attack. Win to earn a Faith bonus; lose and your Suspicion rises.
    </p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-cyan-400 uppercase tracking-wider mb-1">Agent Pool</div>
            <div class="font-display text-lg text-amber-100">@((int)sw.AvailableAgents) / @((int)sw.TotalAgents)</div>
            <div class="text-[10px] text-slate-400">+@ShadowWarEngine.AgentProductionPerSec(sw, Game.State).ToString("F2")/s</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Spend to recruit units</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-emerald-400 uppercase tracking-wider mb-1">Strength</div>
            <div class="font-display text-lg text-amber-100">×@ShadowWarEngine.AgentStrength(sw, Game.State).ToString("F2")</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Multiplies all agent ATK</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-rose-400 uppercase tracking-wider mb-1">Heat</div>
            <div class="font-display text-lg text-amber-100">@((int)sw.Heat)</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Rival aggression level</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-slate-400 uppercase tracking-wider mb-1">Controlled</div>
            <div class="font-display text-lg text-amber-100">@sw.ControlledInstitutions.Count</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Shadow War institutions</div>
        </div>
    </div>

    @if (losses.Count > 0)
    {
        <div class="mt-4 p-3 rounded-[14px]" style="background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.25);">
            <div class="text-[0.65rem] text-rose-400 uppercase tracking-wider mb-1">⚠️ Recent Defeats</div>
            @foreach (var loss in losses)
            {
                <div class="text-xs text-rose-300">@loss.RivalName drove you back in @loss.ContinentId</div>
            }
        </div>
    }
</div>

<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <h2 class="panel-title mb-1">YOUR FORCES</h2>
    <p class="text-xs text-slate-400 mb-3 leading-5">
        These are your recruited agents waiting to be deployed. Each type fills a different role:
        <strong class="text-amber-200">Initiates</strong> are cheap and reliable,
        <strong class="text-amber-200">Zealots</strong> deal heavy damage but are loud,
        <strong class="text-amber-200">Infiltrators</strong> reduce the damage rivals deal back to you.
    </p>
    <div class="flex flex-col gap-2.5">
        @foreach (var agentDef in BattleData.AgentTypes)
        {
            sw.RecruitedAgents.TryGetValue(agentDef.Type, out int owned);
            <div class="flex items-center gap-3.5 p-3.5 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="text-3xl flex-shrink-0">@agentDef.Icon</div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-display text-base text-amber-100 font-medium">@agentDef.Name</span>
                        <span class="text-[0.65rem] text-violet-300 px-2 py-0.5 rounded-full" style="border: 1px solid rgba(167,139,250,0.25);">@owned ready</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-0.5">@agentDef.Description</p>
                    <div class="flex gap-3 mt-1 text-[0.65rem]">
                        <span class="text-rose-300">⚔ ATK @agentDef.Attack</span>
                        <span class="text-cyan-300">🛡 DEF @agentDef.Defense</span>
                        <span class="text-emerald-300">👁 STL @agentDef.Stealth</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <h2 class="panel-title mb-1">RECRUIT AGENTS</h2>
    <p class="text-xs text-slate-400 mb-3 leading-5">
        Spend from your <strong class="text-amber-200">Agent Pool</strong> (generated passively, shown above) to recruit battle units.
        Adjust the quantity with <strong class="text-amber-200">+ / −</strong>, then press the cost button to recruit.
    </p>
    <div class="flex flex-col gap-2.5">
        @foreach (var agentDef in BattleData.AgentTypes)
        {
            int qty = recruitCounts.GetValueOrDefault(agentDef.Type, 1);
            int totalCost = agentDef.AgentCost * qty;
            bool canRecruit = sw.AvailableAgents >= totalCost;
            <div class="p-3.5 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center gap-3">
                    <span class="text-2xl flex-shrink-0">@agentDef.Icon</span>
                    <div class="flex-1 min-w-0">
                        <span class="font-display text-sm text-amber-100 font-medium">@agentDef.Name</span>
                        <div class="text-[0.65rem] text-slate-400">@agentDef.AgentCost agents each &middot; @agentDef.Description</div>
                    </div>
                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        <button class="w-6 h-6 rounded-full text-xs flex items-center justify-center"
                                style="background: rgba(100,100,100,0.25); border: 1px solid var(--panel-border); color: var(--gold-soft);"
                                @onclick="() => AdjustCount(agentDef.Type, -1)">-</button>
                        <span class="text-sm text-amber-100 w-5 text-center">@qty</span>
                        <button class="w-6 h-6 rounded-full text-xs flex items-center justify-center"
                                style="background: rgba(100,100,100,0.25); border: 1px solid var(--panel-border); color: var(--gold-soft);"
                                @onclick="() => AdjustCount(agentDef.Type, 1)">+</button>
                        <button class="px-3 py-1.5 rounded-full font-body font-semibold text-xs cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
                                style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);"
                                disabled="@(!canRecruit)"
                                @onclick="() => OnRecruitClick(agentDef.Type, qty)">
                            @totalCost 🧹
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title mb-1">BATTLE THEATRES</h2>
    <p class="text-xs text-slate-400 mb-4 leading-5">
        Each continent where you hold 2+ covens becomes an active theatre. Deploy recruited agents here, then press
        <strong class="text-amber-200">Launch Attack</strong> to begin fighting. Your squad fights automatically — come back to see the result.
        Victory rewards Faith; defeat raises Suspicion and returns your agents.
    </p>
    <div class="flex flex-col gap-3">
        @foreach (var theater in BattleData.Theaters)
        {
            bool active = BattleEngine.IsTheaterActive(Game.State, LocationService, theater.ContinentId);
            var battle = active ? BattleEngine.GetOrCreateBattle(Game.State, LocationService, theater.ContinentId) : Game.State.BattleSystem?.GetBattle(theater.ContinentId);
            var rivalDef = BattleData.RivalForContinent(theater.ContinentId);

            <div class="p-4 rounded-[14px] @(!active ? "opacity-50" : "")" style="background: rgba(15,10,36,0.5); border: 1px solid @(battle?.Phase == BattlePhase.Fighting ? "rgba(220,38,38,0.4)" : active ? "rgba(245,158,11,0.25)" : "var(--panel-border)");">
                <div class="flex items-start gap-3 mb-2">
                    <span class="text-2xl mt-0.5">@theater.Icon</span>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-display text-sm font-medium text-amber-100">@theater.Name</span>
                            @if (!active)
                            {
                                <span class="text-[0.6rem] text-slate-500 uppercase tracking-wider">Inactive — need 2+ covens</span>
                            }
                            else if (battle?.Phase == BattlePhase.Fighting)
                            {
                                <span class="text-[0.6rem] text-rose-400 uppercase tracking-wider animate-pulse">FIGHTING</span>
                            }
                            else if (battle?.Phase == BattlePhase.Deploy)
                            {
                                <span class="text-[0.6rem] text-amber-400 uppercase tracking-wider">RIVAL PRESENT</span>
                            }
                            else if (battle?.Phase == BattlePhase.Cooldown)
                            {
                                <span class="text-[0.6rem] text-emerald-400 uppercase tracking-wider">VICTORY — COOLING DOWN</span>
                            }
                        </div>
                        <p class="text-[0.68rem] text-slate-400 mt-0.5">@theater.Description</p>
                        @if (rivalDef != null && active)
                        {
                            <p class="text-[0.65rem] text-rose-300 mt-0.5">Rival: @rivalDef.Name (@rivalDef.Icon) &mdash; Strength @rivalDef.AgentStrength.ToString("F1")</p>
                        }
                    </div>
                </div>

                @if (active && battle != null && battle.Phase != BattlePhase.NoThreat)
                {
                    <div class="flex flex-col gap-1 mb-3">
                        <div class="flex justify-between text-[0.68rem] mb-0.5">
                            <span class="text-amber-300">Your Forces</span>
                            <span class="text-amber-200">@battle.PlayerHp.ToString("F0") / @battle.PlayerMaxHp HP</span>
                        </div>
                        <div class="h-1.5 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.06);">
                            <div class="h-full rounded-full" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%; background: linear-gradient(90deg, var(--gold-warm), var(--gold-deep));"></div>
                        </div>
                        <div class="flex justify-between text-[0.68rem] mt-1 mb-0.5">
                            <span class="text-rose-400">Rival Cult</span>
                            <span class="text-rose-300">@battle.RivalHp.ToString("F0") / @battle.RivalMaxHp HP</span>
                        </div>
                        <div class="h-1.5 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.06);">
                            <div class="h-full rounded-full" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%; background: linear-gradient(90deg, #dc2626, #7f1d1d);"></div>
                        </div>
                    </div>

                    @if (battle.Phase == BattlePhase.Deploy)
                    {
                        <div class="mb-2">
                            <div class="text-[0.65rem] text-slate-400 mb-1.5">Deploy from your recruited agents:</div>
                            <div class="flex gap-2 flex-wrap">
                                @foreach (var agentDef in BattleData.AgentTypes)
                                {
                                    sw.RecruitedAgents.TryGetValue(agentDef.Type, out int avail);
                                    int deployed = battle.DeployedSquad.FirstOrDefault(d => d.Type == agentDef.Type)?.Count ?? 0;
                                    <button class="px-2.5 py-1 rounded-full text-[0.68rem] font-body disabled:opacity-40 disabled:cursor-not-allowed"
                                            style="background: rgba(15,10,36,0.8); border: 1px solid var(--panel-border); color: var(--gold-soft);"
                                            disabled="@(avail < 1)"
                                            @onclick="() => OnDeployClick(theater.ContinentId, agentDef.Type)">
                                        @agentDef.Icon @agentDef.Name (@avail) @(deployed > 0 ? $"[{deployed} deployed]" : "")
                                    </button>
                                }
                            </div>
                        </div>

                        @if (battle.TotalDeployed > 0)
                        {
                            <div class="flex gap-2">
                                <button class="flex-1 py-2 rounded-[14px] font-body font-semibold text-sm"
                                        style="background: linear-gradient(135deg, #dc2626, #991b1b); border: none; color: #fef3c7; cursor: pointer;"
                                        @onclick="() => OnStartBattle(theater.ContinentId)">
                                    Launch Attack — @battle.TotalDeployed agents
                                </button>
                                <button class="px-4 py-2 rounded-[14px] font-body text-sm"
                                        style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border); color: var(--gold-soft); cursor: pointer;"
                                        @onclick="() => OnWithdraw(theater.ContinentId)">
                                    Withdraw
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-[0.68rem] text-slate-500 italic">No agents deployed yet. Recruit some above, then deploy them here.</p>
                        }
                    }

                    @if (battle.Phase == BattlePhase.Fighting)
                    {
                        <p class="text-xs text-rose-300 italic">Battle in progress — your agents are fighting automatically. Check back soon.</p>
                    }

                    @if (battle.Phase == BattlePhase.Cooldown)
                    {
                        <p class="text-xs text-emerald-300 italic">Victory achieved. A new rival will rise shortly.</p>
                    }

                    @if (battle.Log.Count > 0)
                    {
                        <div class="mt-2 p-2 rounded-[10px] text-[0.65rem] text-slate-400 max-h-24 overflow-y-auto" style="background: rgba(0,0,0,0.3);">
                            @foreach (var entry in Enumerable.Reverse(battle.Log).Take(5))
                            {
                                <div>@entry</div>
                            }
                        </div>
                    }
                }
                else if (!active)
                {
                    <p class="text-[0.68rem] text-slate-500 italic">Convert a second coven in @theater.Name to unlock this theatre.</p>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnViewMap { get; set; }

    private Dictionary<AgentType, int> recruitCounts = new()
    {
        { AgentType.Initiate, 1 },
        { AgentType.Zealot, 1 },
        { AgentType.Infiltrator, 1 }
    };

    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private void AdjustCount(AgentType type, int delta)
    {
        recruitCounts.TryGetValue(type, out int current);
        recruitCounts[type] = Math.Max(1, current + delta);
    }

    private void OnRecruitClick(AgentType type, int qty)
    {
        Game.RecruitAgent(type, qty);
    }

    private void OnDeployClick(string continentId, AgentType type)
    {
        Game.DeployAgents(continentId, type, 1);
    }

    private void OnStartBattle(string continentId)
    {
        Game.StartBattle(continentId);
    }

    private void OnWithdraw(string continentId)
    {
        Game.WithdrawBattleAgents(continentId);
    }

    public void Dispose() => Game.OnChange -= StateChanged;
}
