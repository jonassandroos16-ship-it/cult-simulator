@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService LocationService
@implements IDisposable

@{
    var sw = Game.State.ShadowWarOrInit;
    var losses = Game.RecentTerritoryLosses;
    var activeRivals = Game.ActiveRivals.ToList();
    var warElixirActive = Game.State.Occult.ElixirWarStrengthMult > 1.0 && Game.State.Occult.ElixirTimer > 0;
    var agentCap = ShadowWarEngine.AgentPoolCap(Game.State);
    var barracksLevel = Game.State.ActiveCoven.Buildings.GetValueOrDefault(BuildingType.Barracks);
    var trainingCampLevel = Game.State.ActiveCoven.Buildings.GetValueOrDefault(BuildingType.TrainingCamp);
    var atCap = (int)sw.AvailableAgents >= agentCap && sw.TotalAgents >= agentCap;
    var poolAgents = (int)sw.AvailableAgents;
    var totalRecruited = sw.RecruitedAgents.Values.Sum();
    var productionRate = ShadowWarEngine.AgentProductionPerSec(sw, Game.State);
}

<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <div class="flex items-center justify-between mb-3">
        <h2 class="panel-title">⚔️ Shadow Battle</h2>
        <button class="ley-line-shortcut-btn" @onclick="OnViewMap">
            <span>🗺️</span> View on Map
        </button>
    </div>
    <p class="text-sm text-violet-300 mb-4 leading-6">
        Rival cults threaten your hold on the world. When you control <strong class="text-amber-200">ALL covens in a continent</strong>, a rival will emerge. Recruit agents below, deploy them to a Battle Theatre, then launch your attack. <strong class="text-rose-300">Agents used in battle are lost forever</strong> — win for a Faith bonus, or lose and your Suspicion rises. Choose your battles wisely.
    </p>

    <div class="grid grid-cols-3 gap-3">
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-cyan-400 uppercase tracking-wider mb-1">Agent Pool</div>
            <div class="font-display text-lg text-amber-100">@poolAgents / @agentCap</div>
            <div class="text-[10px] text-slate-400">+@productionRate.ToString("F2")/s</div>
            @if (atCap)
            {
                <div class="text-[10px] text-amber-400 font-medium mt-0.5">⚠ Pool full — build Barracks</div>
            }
            else
            {
                <div class="text-[10px] text-slate-500 mt-0.5">Spend to recruit units</div>
            }
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-emerald-400 uppercase tracking-wider mb-1">Strength</div>
            <div class="font-display text-lg text-amber-100">×@ShadowWarEngine.AgentStrength(sw, Game.State).ToString("F2")</div>
            @if (warElixirActive)
            {
                <div class="text-[10px] text-amber-400 font-medium">⚗️ War Elixir: ×@Game.State.Occult.ElixirWarStrengthMult.ToString("F1") (@((int)Game.State.Occult.ElixirTimer)s left)</div>
            }
            else
            {
                <div class="text-[10px] text-slate-500 mt-0.5">Multiplies all agent ATK</div>
            }
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-[0.65rem] text-amber-400 uppercase tracking-wider mb-1">Controlled</div>
            <div class="font-display text-lg text-amber-100">@sw.TotalControlled</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Institutions seized</div>
        </div>
    </div>

    @if (warElixirActive)
    {
        <div class="mt-3 p-2.5 rounded-[12px] text-xs flex items-center gap-2" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
            <span class="text-base">⚗️</span>
            <span class="text-amber-300">War Elixir active — your battle agents deal <strong>@((int)((Game.State.Occult.ElixirWarStrengthMult - 1) * 100))% extra damage</strong> for @((int)Game.State.Occult.ElixirTimer)s more.</span>
        </div>
    }

    <!-- Agent production tip -->
    <div class="mt-3 p-2.5 rounded-[12px] text-xs leading-5" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
        <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider mb-1">How to Get More Agents</div>
        <div class="text-slate-400 space-y-0.5">
            <div><strong class="text-amber-200">🏰 Barracks</strong> (Lv @barracksLevel) — Raises your agent pool cap by +5 per level. Currently: @agentCap max.</div>
            <div><strong class="text-amber-200">🗡️ Training Camp</strong> (Lv @trainingCampLevel) — Boosts agent production speed by +50% per level. Currently: ×@((1.0 + trainingCampLevel * GameBalance.TrainingCampProductionPerLevel).ToString("F1")) production.</div>
            <div class="text-slate-500 text-[0.65rem] mt-1">Build or upgrade these in the <strong>Build</strong> tab to increase your agent flow.</div>
        </div>
    </div>

    @if (losses.Count > 0)
    {
        <div class="mt-3 p-2.5 rounded-[12px] text-xs" style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2);">
            <div class="text-rose-300 mb-1 font-medium">Recent Territory Losses</div>
            @foreach (var loss in losses)
            {
                <div class="text-slate-400 text-[0.7rem]">@loss.RivalName took @loss.ContinentId</div>
            }
        </div>
    }
</div>

<!-- Step 1: Recruit Agents -->
<div class="panel glass-panel rounded-[20px] p-5 mb-4">
    <div class="flex items-center gap-2 mb-1">
        <span class="deploy-step-badge">Step 1</span>
        <h2 class="panel-title">Recruit Agents</h2>
    </div>
    <p class="text-xs text-slate-400 mb-3 leading-relaxed">
        Spend agents from your pool (@poolAgents available) to recruit battle units. Each unit type has different strengths.
    </p>

    <div class="mb-3 p-2.5 rounded-[12px] text-xs leading-5" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
        <div class="text-[0.65rem] text-violet-400 uppercase tracking-wider mb-1">Understanding Agent Stats</div>
        <div class="text-slate-400 space-y-0.5">
            <div><strong class="text-rose-300">⚔ ATK</strong> — Damage dealt to the rival per second. Multiplied by your Strength.</div>
            <div><strong class="text-cyan-300">🛡 DEF</strong> — Reduces damage your squad takes from counterattacks.</div>
            <div><strong class="text-emerald-300">👁 STL</strong> — Higher stealth reduces rival counterattack damage. <strong class="text-amber-200">Infiltrators</strong> are key to minimizing losses.</div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        @foreach (var agentDef in BattleData.AgentTypes)
        {
            sw.RecruitedAgents.TryGetValue(agentDef.Type, out int owned);
            var maxForType = BattleEngine.MaxAgentsForType(sw, Game.State, agentDef.Type);
            var canAfford = poolAgents >= agentDef.AgentCost;
            var maxRecruitable = Math.Min(maxForType - owned, poolAgents / agentDef.AgentCost);
            <div class="deploy-recruit-card @(owned == 0 && !canAfford ? "opacity-50" : "")">
                <div class="flex items-start gap-3">
                    <span class="text-2xl flex-shrink-0">@agentDef.Icon</span>
                    <div class="flex-1 min-w-0">
                        <div class="font-display text-sm text-amber-100 font-medium">@agentDef.Name</div>
                        <div class="deploy-agent-stats text-[0.6rem] mt-0.5">
                            <span class="text-rose-300">⚔ @agentDef.Attack</span>
                            <span class="text-cyan-300">🛡 @agentDef.Defense</span>
                            <span class="text-emerald-300">👁 @agentDef.Stealth</span>
                        </div>
                        <div class="text-[0.55rem] text-slate-500 mt-1 leading-tight">@agentDef.Description</div>
                    </div>
                </div>
                <div class="flex items-center justify-between mt-3">
                    <div class="text-[0.6rem]">
                        <div class="text-cyan-400">Cost: @agentDef.AgentCost pool agents</div>
                        <div class="text-slate-400">Owned: @owned@(agentDef.Type != AgentType.Initiate ? $" / {maxForType} max" : "")</div>
                    </div>
                    <button class="deploy-btn deploy-btn-recruit" disabled="@(!canAfford || (agentDef.Type != AgentType.Initiate && owned >= maxForType))" @onclick="() => OnRecruit(agentDef.Type, 1)">
                        Recruit
                    </button>
                </div>
            </div>
        }
    </div>

    @if (totalRecruited == 0 && poolAgents == 0 && !AnyAgentsDeployedAnywhere())
    {
        <div class="mt-3 p-3 rounded-[12px] text-center text-xs text-slate-400" style="background: rgba(15,10,36,0.4); border: 1px solid var(--panel-border);">
            Your agent pool is empty. Agents accumulate over time — build Barracks to raise the cap and a Training Camp to speed up production.
        </div>
    }
</div>

@if (activeRivals.Count > 0)
{
    <div class="panel rounded-[20px] p-5 mb-4" style="background: linear-gradient(135deg, rgba(30,10,40,0.8), rgba(10,5,20,0.9)); border: 2px solid rgba(239,68,68,0.3); box-shadow: 0 0 30px rgba(239,68,68,0.1);">
        <div class="flex items-center gap-2 mb-2">
            <span class="text-2xl">☠️</span>
            <h2 class="panel-title text-rose-200">Rival Cult Assault</h2>
        </div>
        <p class="text-sm text-rose-300 mb-4 leading-6">
            These are the most powerful enemies in the world. Each rival commands hundreds of agents and controls institutions across their continent.
            <strong class="text-amber-200">Defeating a rival permanently destroys them</strong> and grants a massive Faith reward — but their HP is enormous and their counterattack devastating. Stockpile your best agents before engaging.
        </p>

        @foreach (var (def, rivalState) in activeRivals)
        {
            var battle = Game.GetRivalBattle(def.Id);
            var isDefeated = rivalState.Defeated;

            <div class="mb-4 p-4 rounded-[16px] @(isDefeated ? "opacity-40" : "")" style="background: rgba(15,10,36,0.6); border: 1px solid rgba(239,68,68,0.2);">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <span class="text-3xl">@def.Icon</span>
                        <div>
                            <div class="font-display text-base font-bold text-rose-200">@def.Name</div>
                            <div class="text-[0.65rem] text-slate-400 uppercase tracking-wider">@ContinentName(def.PreferredTerritoryId) · Power: @((int)rivalState.Power)</div>
                        </div>
                    </div>
                    @if (isDefeated)
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-medium">DEFEATED</span>
                    }
                    else if (battle != null && battle.Phase == RivalBattlePhase.Fighting)
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-rose-500/20 text-rose-300 animate-pulse font-medium">IN COMBAT</span>
                    }
                    else if (battle != null && battle.Phase == RivalBattlePhase.Deploy)
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 font-medium">DEPLOYING</span>
                    }
                    else
                    {
                        <span class="text-[0.65rem] px-3 py-1 rounded-full bg-slate-500/20 text-slate-300">@rivalState.Status</span>
                    }
                </div>

                <p class="text-xs text-slate-400 mb-3 italic">@def.Description</p>

                @if (!isDefeated && battle != null)
                {
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <div class="text-[0.65rem] text-emerald-400 uppercase tracking-wider mb-1">Your Force HP</div>
                            <div class="text-emerald-300 font-display text-sm">@((int)battle.PlayerHp) / @((int)battle.PlayerMaxHp)</div>
                            <div class="w-full h-2.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-emerald-400 rounded-full transition-all duration-300" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="text-[0.65rem] text-rose-400 uppercase tracking-wider mb-1">Rival HP</div>
                            <div class="text-rose-300 font-display text-sm">@((int)battle.RivalHp) / @((int)battle.RivalMaxHp)</div>
                            <div class="w-full h-2.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-rose-400 rounded-full transition-all duration-300" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                    </div>

                    @if (battle.Phase == RivalBattlePhase.Deploy)
                    {
                        <DeploySquadPanel CanDeploy="true"
                                          DeployedSquad="battle.DeployedSquad"
                                          FightLabel="Launch Assault"
                                          OnDeployAgent="args => OnDeployRival(def.Id, args.Item1, args.Item2)"
                                          OnWithdraw="() => OnWithdrawRival(def.Id)"
                                          OnFight="() => OnStartRivalBattle(def.Id)" />
                    }
                    else if (battle.Phase == RivalBattlePhase.Fighting)
                    {
                        <DeploySquadPanel CanDeploy="false" IsFighting="true" DeployedSquad="battle.DeployedSquad" />
                    }
                    else if (battle.Phase == RivalBattlePhase.Defeat)
                    {
                        <div class="text-center text-sm text-rose-400 py-2 mb-2">Your forces were crushed. Regroup and try again.</div>
                        <button class="w-full p-2.5 rounded-[10px] text-sm text-amber-100 font-medium transition-all hover:bg-amber-500/10"
                                style="background: rgba(15,10,36,0.6); border: 1px solid var(--panel-border);"
                                @onclick="() => OnRetryRival(def.Id)">
                            Regroup
                        </button>
                    }

                    @if (battle.Log.Count > 0)
                    {
                        <div class="mt-2 p-2 rounded-[8px] text-[0.65rem] space-y-0.5 max-h-20 overflow-y-auto" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                            @foreach (var entry in battle.Log.TakeLast(4))
                            {
                                <div class="text-slate-400">@entry</div>
                            }
                        </div>
                    }
                }
                else if (!isDefeated && battle == null)
                {
                    <button class="w-full p-3 rounded-[12px] text-sm text-rose-100 font-bold transition-all hover:bg-rose-500/20 hover:border-rose-500/40"
                            style="background: rgba(127,29,29,0.3); border: 1px solid rgba(239,68,68,0.25);"
                            @onclick="() => OnStartRivalBattle(def.Id)">
                        ⚔️ Begin Assault on @def.Name
                    </button>
                }
            </div>
        }
    </div>
}

<!-- Step 2: Battle Theatres -->
<div class="panel glass-panel rounded-[20px] p-5">
    <div class="flex items-center gap-2 mb-1">
        <span class="deploy-step-badge">Step 2</span>
        <h2 class="panel-title">Battle Theatres</h2>
    </div>
    <p class="text-xs text-slate-400 mb-4 leading-relaxed">Deploy your recruited agents here, then launch the attack. Defeating the rival completes the continent.</p>

    <div class="flex flex-col gap-3">
        @foreach (var theater in BattleData.Theaters)
        {
            bool active = BattleEngine.IsTheaterActive(Game.State, LocationService, theater.ContinentId);
            var battle = active ? BattleEngine.GetOrCreateBattle(Game.State, LocationService, theater.ContinentId) : Game.State.BattleSystem?.GetBattle(theater.ContinentId);

            <div class="p-4 rounded-[16px] @(active ? "" : "opacity-50")" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">@theater.Icon</span>
                        <span class="font-display text-sm font-semibold text-amber-100">@theater.Name</span>
                    </div>
                    @if (active)
                    {
                        <span class="text-[0.6rem] px-2 py-0.5 rounded-full @(battle?.Phase == BattlePhase.Fighting ? "bg-rose-500/20 text-rose-300" : battle?.Phase == BattlePhase.Deploy ? "bg-amber-500/20 text-amber-300" : "bg-slate-500/20 text-slate-300")">@(battle?.Phase == BattlePhase.Deploy ? "Ready" : battle?.Phase == BattlePhase.Fighting ? "Fighting" : battle?.Phase == BattlePhase.Cooldown ? "Cooldown" : "No threat")</span>
                    }
                    else
                    {
                        <span class="text-[0.6rem] px-2 py-0.5 rounded-full bg-slate-500/20 text-slate-400">Inactive</span>
                    }
                </div>

                @if (active && battle != null)
                {
                    <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                        <div>
                            <div class="text-slate-400 text-[0.65rem] mb-0.5">Your HP</div>
                            <div class="text-emerald-300 font-display">@((int)battle.PlayerHp) / @((int)battle.PlayerMaxHp)</div>
                            <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-emerald-400 rounded-full transition-all duration-300" style="width: @(battle.PlayerMaxHp > 0 ? (battle.PlayerHp / battle.PlayerMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="text-slate-400 text-[0.65rem] mb-0.5">Rival HP</div>
                            <div class="text-rose-300 font-display">@((int)battle.RivalHp) / @((int)battle.RivalMaxHp)</div>
                            <div class="w-full h-1.5 rounded-full bg-slate-700/50 mt-1 overflow-hidden">
                                <div class="h-full bg-rose-400 rounded-full transition-all duration-300" style="width: @(battle.RivalMaxHp > 0 ? (battle.RivalHp / battle.RivalMaxHp * 100).ToString("F0") : "0")%;"></div>
                            </div>
                        </div>
                    </div>

                    @if (battle.Phase == BattlePhase.Deploy)
                    {
                        <DeploySquadPanel CanDeploy="true"
                                          DeployedSquad="battle.DeployedSquad"
                                          FightLabel="Start Battle"
                                          OnDeployAgent="args => OnDeploy(theater.ContinentId, args.Item1, args.Item2)"
                                          OnWithdraw="() => OnWithdraw(theater.ContinentId)"
                                          OnFight="() => OnStartBattle(theater.ContinentId)" />
                    }
                    else if (battle.Phase == BattlePhase.Fighting)
                    {
                        <DeploySquadPanel CanDeploy="false" IsFighting="true" DeployedSquad="battle.DeployedSquad" />
                    }
                    else if (battle.Phase == BattlePhase.Cooldown)
                    {
                        <DeploySquadPanel CanDeploy="false" IsCooldown="true" DeployedSquad="battle.DeployedSquad" />
                    }

                    @if (battle.Log.Count > 0)
                    {
                        <div class="mt-2 p-2 rounded-[8px] text-[0.65rem] space-y-0.5 max-h-24 overflow-y-auto" style="background: rgba(5,3,8,0.4); border: 1px solid var(--panel-border);">
                            @foreach (var entry in battle.Log.TakeLast(5))
                            {
                                <div class="text-slate-400">@entry</div>
                            }
                        </div>
                    }
                }
                else if (!active)
                {
                    <div class="text-xs text-slate-500 text-center py-2">Convert all covens in this continent to activate.</div>
                }
            </div>
        }
    </div>
</div>


@code {
    [Parameter] public EventCallback OnViewMap { get; set; }

    private void StateChanged() => StateHasChanged();

    protected override void OnInitialized() => Game.OnChange += StateChanged;

    private void OnRecruit(AgentType type, int count) => Game.RecruitAgent(type, count);
    private void OnDeploy(string continentId, AgentType type, int count) => Game.DeployAgents(continentId, type, count);
    private void OnStartBattle(string continentId) => Game.StartBattle(continentId);
    private void OnWithdraw(string continentId) => Game.WithdrawBattleAgents(continentId);

    private void OnDeployRival(string rivalId, AgentType type, int count) => Game.DeployRivalBattleAgents(rivalId, type, count);
    private void OnWithdrawRival(string rivalId) => Game.WithdrawRivalBattleAgents(rivalId);
    private void OnStartRivalBattle(string rivalId) => Game.StartRivalBattle(rivalId);
    private void OnRetryRival(string rivalId)
    {
        Game.WithdrawRivalBattleAgents(rivalId);
        var battle = Game.GetRivalBattle(rivalId);
        if (battle != null) battle.Phase = RivalBattlePhase.Deploy;
        StateHasChanged();
    }

    private bool AnyAgentsDeployedAnywhere()
    {
        var sw = Game.State.ShadowWarOrInit;
        if (sw == null) return false;
        if (Game.State.BattleSystem?.Battles != null)
        {
            foreach (var b in Game.State.BattleSystem.Battles)
            {
                if (b.DeployedSquad != null && b.DeployedSquad.Any(s => s.Count > 0))
                    return true;
            }
        }
        var rs = Game.State.RivalCultsOrInit;
        if (rs?.RivalBattles != null)
        {
            foreach (var b in rs.RivalBattles)
            {
                if (b.DeployedSquad != null && b.DeployedSquad.Any(s => s.Count > 0))
                    return true;
            }
        }
        if (Game.State.LocalCultBattles != null)
        {
            foreach (var b in Game.State.LocalCultBattles)
            {
                if (b.DeployedSquad != null && b.DeployedSquad.Any(s => s.Count > 0))
                    return true;
            }
        }
        return false;
    }

    private static string ContinentName(string continent) => continent switch
    {
        "europe" => "Europe",
        "north_america" => "North America",
        "south_america" => "South America",
        "asia" => "Asia",
        "oceania" => "Oceania",
        "africa" => "Africa",
        "middle_east" => "Middle East",
        _ => continent
    };

    public void Dispose() => Game.OnChange -= StateChanged;
}
