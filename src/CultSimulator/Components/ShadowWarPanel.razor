@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

<div class="panel glass-panel rounded-[20px] p-5">
    <div class="flex items-center justify-between mb-4">
        <h2 class="panel-title">Shadow War</h2>
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full" style="background: rgba(15,10,36,0.6); border: 1px solid rgba(167,139,250,0.3);">
            <span class="text-lg">🕵️</span>
            <span class="font-display text-lg font-semibold text-amber-100">@NumberFormat.Fmt(occult.Agents)</span>
            <span class="text-[0.65rem] text-violet-400 tracking-wide uppercase">Agents</span>
        </div>
    </div>

    <div class="mb-4 p-3.5 rounded-[14px] text-sm leading-relaxed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
        <p class="text-violet-300">Recruit shadow agents to wage covert war against rival cults and inquisitors. Agents passively generate Faith, Army Power, and suppress Suspicion — but each costs Agent currency to recruit.</p>
        <p class="text-slate-400 text-xs mt-2">Agents accumulate passively at @OccultBalance.AgentBasePerSec/s. Each agent type has different strengths. Costs scale with how many you already hold.</p>
    </div>

    @if (totalAgentCount > 0)
    {
        <div class="flex flex-col gap-3 mb-4">
            <div class="flex items-center justify-between p-3 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <span class="text-xs font-display tracking-[0.15em] uppercase text-violet-300">Active Agents</span>
                <span class="font-display text-sm text-amber-100">@totalAgentCount</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <span class="text-xs font-display tracking-[0.15em] uppercase text-violet-300">Agent Faith Bonus</span>
                <span class="font-display text-sm text-emerald-400">+@NumberFormat.Fmt(ShadowWarEngine.TotalAgentFaithPerSec(occult))/s</span>
            </div>
            @if (ShadowWarEngine.TotalAgentSuspicionPerSec(occult) < 0)
            {
                <div class="flex items-center justify-between p-3 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid rgba(52,211,153,0.2);">
                    <span class="text-xs font-display tracking-[0.15em] uppercase text-violet-300">Suspicion Suppressed</span>
                    <span class="font-display text-sm text-emerald-400">@NumberFormat.Fmt(ShadowWarEngine.TotalAgentSuspicionPerSec(occult))/s</span>
                </div>
            }
            @if (ShadowWarEngine.TotalAgentArmyPowerPerSec(occult) > 0)
            {
                <div class="flex items-center justify-between p-3 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <span class="text-xs font-display tracking-[0.15em] uppercase text-violet-300">Agent Army Power</span>
                    <span class="font-display text-sm text-amber-100">+@NumberFormat.Fmt(ShadowWarEngine.TotalAgentArmyPowerPerSec(occult))/s</span>
                </div>
            }
        </div>
    }

    <div class="flex flex-col gap-2.5">
        @foreach (var def in OccultData.Agents)
        {
            var count = ShadowWarEngine.AgentCount(occult, def.Type);
            var cost = ShadowWarEngine.AgentRecruitCost(occult, def);
            var canRecruit = occult.Agents >= cost && count < OccultBalance.MaxAgentsPerType;
            <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px] @(count > 0 ? "border-violet-400/20 bg-violet-400/5" : "")" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                <div class="text-3xl flex-shrink-0">@def.Icon</div>
                <div class="flex-1 flex flex-col gap-0.5">
                    <div class="flex items-center gap-2">
                        <span class="font-display text-base text-amber-100 font-medium">@def.Name</span>
                        @if (count > 0)
                        {
                            <span class="text-[0.65rem] px-2 py-0.5 rounded-full bg-violet-500/20 text-violet-300 border border-violet-500/30">×@count</span>
                        }
                    </div>
                    <span class="text-[0.7rem] text-slate-400">@def.EffectDescription</span>
                    <div class="flex gap-3 mt-0.5">
                        @if (def.FaithPerSec > 0) { <span class="text-[0.65rem] text-emerald-400">+@def.FaithPerSec/s faith</span> }
                        @if (def.SuspicionPerSec < 0) { <span class="text-[0.65rem] text-emerald-400">@def.SuspicionPerSec/s suspicion</span> }
                        @if (def.ArmyPowerPerSec > 0) { <span class="text-[0.65rem] text-amber-300">+@def.ArmyPowerPerSec/s army</span> }
                    </div>
                </div>
                <div class="flex-shrink-0">
                    <button class="upgrade-buy flex items-center gap-1.5 px-3.5 py-2 rounded-full font-body font-semibold text-xs cursor-pointer transition-transform duration-200 disabled:opacity-40 disabled:cursor-not-allowed"
                            style="background: linear-gradient(135deg, #7c3aed, #4c1d95); border: none; color: #fef3c7;"
                            disabled="@(!canRecruit)"
                            @onclick="() => Game.RecruitAgent(def.Type)">
                        <span>🕵️ @NumberFormat.Fmt(cost)</span>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private OccultState occult => Game.State.Occult;
    private int totalAgentCount => ShadowWarEngine.TotalAgentCount(occult);

    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.OnChange -= StateChanged;
}
