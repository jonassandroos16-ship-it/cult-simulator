@using CultSimulator.Game
@inject IJSRuntime JS
@inject GameService Game
@inject WorldLocationService LocationService
@implements IDisposable

<div class="world-map-wrapper">
    <div class="mb-3 flex items-center gap-2 flex-wrap">
        <button class="map-tab-button @(mapMode == "world" ? "active" : "")" @onclick='() => SwitchMapMode("world")'>
            <span class="text-sm">🌍</span> World
        </button>
        <button class="map-tab-button @(mapMode == "local" ? "active" : "")" @onclick='() => SwitchMapMode("local")'>
            <span class="text-sm">📍</span> Local
        </button>
        <button class="map-tab-button @(mapMode == "shadowwar" ? "active" : "")" @onclick='() => SwitchMapMode("shadowwar")'>
            <span class="text-sm">⚔️</span> Shadow War
        </button>
        <div class="ml-auto text-[0.7rem] text-violet-400 tracking-wide">
            @if (mapMode == "local")
            {
                <span>@Game.ActiveLocalCultsForCurrentCoven.Count / @LocalCultEngine.MaxActiveLocalCults cults active</span>
            }
            else if (mapMode == "shadowwar")
            {
                <span>@sw.TotalControlled / @ShadowWarData.Institutions.Length institutions · @rivalCount rivals active</span>
            }
        </div>
    </div>

    @if (mapMode == "world")
    {
        <div class="mb-3 p-3.5 rounded-[14px] text-sm leading-relaxed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <p class="text-violet-300">The World Map shows historical covens you can convert. Click a marker to see details. You must have enough followers to begin a conversion — the next available target is highlighted. Each conversion is a narrative siege: make choices, face consequences, and earn the coven's allegiance.</p>
            <p class="text-slate-400 text-xs mt-2">You can only convert covens in continents where you already have a coven. Start in Europe and expand outward. Switch to the Local tab to see rival cults near your active coven.</p>
        </div>
        <div id="world-map-container" class="world-map-container"></div>
    }
    else if (mapMode == "local")
    {
        <div class="mb-3 p-3.5 rounded-[14px] text-sm leading-relaxed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <p class="text-violet-300">Local cults operate near your active coven — @activeCovenName. They are weaker than full covens and can be converted quickly for a reward of followers or gold. A new cult appears every hour, up to @LocalCultEngine.MaxActiveLocalCults at a time.</p>
        </div>
        <div id="local-map-container" class="world-map-container"></div>

        @if (selectedLocalCult != null)
        {
            var cultDef = selectedLocalCult;
            var canConvert = Game.CanConvertLocalCult(cultDef.Id);

            <div class="coven-popup" style="display:block;">
                <button class="coven-popup-close" @onclick="CloseLocalPopup">×</button>
                <h3 class="coven-popup-name">@cultDef.Name</h3>
                <p class="coven-popup-summary">@cultDef.Description</p>

                <div class="coven-popup-takeover mt-3">
                    <div class="takeover-progress-row flex items-center justify-between text-[0.7rem] text-violet-300 mb-1">
                        <span>Followers needed</span>
                        <span class="text-amber-200">@CovenProgress.TotalFollowers(Game.State) / @cultDef.FollowersRequired</span>
                    </div>
                    <div class="rank-progress h-1.5 bg-white/[0.06] rounded-full overflow-hidden mb-2">
                        <div class="h-full rounded-full transition-all duration-500"
                             style="width: @(Math.Min(1.0, (double)CovenProgress.TotalFollowers(Game.State) / cultDef.FollowersRequired) * 100)%; background: @((canConvert ? "var(--success)" : "var(--danger)"));"></div>
                    </div>
                    <p class="text-[0.65rem] text-amber-300 mb-2">Reward: @cultDef.RewardAmount followers or gold</p>
                    <button class="coven-action-button w-full py-2.5 rounded-full font-display text-xs font-semibold tracking-[0.2em] uppercase cursor-pointer transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed"
                            style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);"
                            disabled="@(!canConvert)"
                            @onclick="() => ConvertLocalCult(cultDef.Id)">
                        Convert
                    </button>
                </div>
            </div>
        }
    }
    else if (mapMode == "shadowwar")
    {
        <div class="mb-3 p-3.5 rounded-[14px] text-sm leading-relaxed" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <p class="text-violet-300">The Shadow War map shows institutions across the globe you can infiltrate. Click a marker to recon, infiltrate, or defend. Green = controlled, blue = recon, amber = infiltrating, red = alerted, orange = under investigation.</p>
            @if (rivalCount > 0)
            {
                <p class="text-rose-300 text-xs mt-2">⚠️ @rivalCount rival cult(s) are active and competing for control. Red markers indicate institutions they've seized. Act fast to defend your territory.</p>
            }
            else
            {
                <p class="text-slate-400 text-xs mt-2">Rival cults emerge once you control 2 covens in a continent. They only operate in continents where they have presence.</p>
            }
        </div>
        <div id="shadowwar-map-container" class="world-map-container"></div>

        @if (selectedInstitution != null)
        {
            <ShadowWarModal InstitutionId="@selectedInstitution" OnClose="CloseInstitutionPopup" />
        }
    }

    @if (mapMode == "world" && selectedCoven != null)
    {
        <div class="coven-popup" style="display:block;">
            <button class="coven-popup-close" @onclick="ClosePopup">×</button>
            <div class="coven-popup-flag">@selectedCoven.CountryFlag</div>
            <h3 class="coven-popup-name">@selectedCoven.Name</h3>
            <p class="coven-popup-location">@selectedCoven.Location, @selectedCoven.Country</p>
            <p class="coven-popup-era">@selectedCoven.Era</p>
            <p class="coven-popup-summary">@selectedCoven.Summary</p>

            @if (showLore)
            {
                <p class="coven-popup-lore">@selectedCoven.Lore</p>
                <button class="coven-popup-lore-toggle" @onclick="ToggleLore">Hide Lore</button>
            }
            else
            {
                <button class="coven-popup-lore-toggle" @onclick="ToggleLore">Reveal Lore</button>
            }

            @if (selectedCoven.Id != "skanor")
            {
                var covenState = Game.State.FindCoven(selectedCoven.Id);
                var isConverted = covenState != null && covenState.Converted;
                var canConvert = Game.CanConvert(selectedCoven.Id);
                var nextTarget = CovenProgress.NextTarget(Game.State, LocationService.Locations);
                var isNextTarget = nextTarget?.Id == selectedCoven.Id;
                var conversionDef = ConversionData.Find(selectedCoven.Id);
                var hasCovenInContinent = HasCovenInContinent(selectedCoven.Continent);

                if (!isConverted)
                {
                    <div class="coven-popup-takeover mt-3">
                        @if (!hasCovenInContinent)
                        {
                            <div class="mb-2 p-2.5 rounded-[10px] text-xs text-rose-300" style="background: rgba(127,29,29,0.15); border: 1px solid rgba(239,68,68,0.2);">
                                ⚠️ You need a coven in @ContinentName(selectedCoven.Continent) before you can convert covens there.
                            </div>
                        }
                        <div class="takeover-progress-row flex items-center justify-between text-[0.7rem] text-violet-300 mb-1">
                            <span>Followers needed</span>
                            <span class="text-amber-200">@CovenProgress.TotalFollowers(Game.State) / @selectedCoven.FollowersRequired</span>
                        </div>
                        <div class="rank-progress h-1.5 bg-white/[0.06] rounded-full overflow-hidden mb-2">
                            <div class="h-full rounded-full transition-all duration-500"
                                 style="width: @(CovenProgress.ConversionProgress(Game.State, selectedCoven) * 100)%; background: @((canConvert ? "var(--success)" : "var(--danger)"));"></div>
                        </div>
                        @if (conversionDef != null)
                        {
                            <p class="text-[0.65rem] text-violet-400 mb-2 italic">@(conversionDef.Theme) — @conversionDef.Steps.Count trials</p>
                        }
                        @if (isNextTarget && !canConvert)
                        {
                            <span class="coven-target-badge block text-center text-[0.65rem] font-semibold tracking-[0.2em] uppercase text-rose-300 mb-2">Next Target</span>
                        }
                        <button class="coven-action-button w-full py-2.5 rounded-full font-display text-xs font-semibold tracking-[0.2em] uppercase cursor-pointer transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed"
                                style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);"
                                disabled="@(!canConvert)"
                                @onclick="() => BeginConversion(selectedCoven.Id)">
                            Convert
                        </button>
                    </div>
                }
                else
                {
                    <div class="coven-popup-takenover mt-3 text-center">
                        <span class="learned-badge text-[0.7rem] font-semibold tracking-[0.15em] uppercase text-emerald-400 px-3 py-1.5 border border-emerald-400/30 rounded-full">Under Your Control</span>
                        @if (Game.State.ActiveCovenId == selectedCoven.Id)
                        {
                            <span class="block text-[0.7rem] text-amber-200 mt-2 tracking-wide">Active coven</span>
                        }
                        else
                        {
                            <button class="coven-action-button w-full mt-2 py-2.5 rounded-full font-display text-xs font-semibold tracking-[0.2em] uppercase cursor-pointer transition-all duration-200"
                                    style="background: linear-gradient(135deg, var(--violet-deep), var(--violet-void)); border: 1px solid rgba(167,139,250,0.3); color: var(--gold-pale);"
                                    @onclick="() => Switch(selectedCoven.Id)">
                                Switch
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="coven-popup-takeover mt-3 text-center">
                    @if (CovenProgress.IsHomeCoven(Game.State))
                    {
                        <span class="block text-[0.7rem] text-amber-200 tracking-wide">Active coven (Home)</span>
                    }
                    else
                    {
                        <button class="coven-action-button w-full py-2.5 rounded-full font-display text-xs font-semibold tracking-[0.2em] uppercase cursor-pointer transition-all duration-200"
                                style="background: linear-gradient(135deg, var(--violet-deep), var(--violet-void)); border: 1px solid rgba(167,139,250,0.3); color: var(--gold-pale);"
                                @onclick="() => Switch(selectedCoven.Id)">
                            Switch
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string mapMode = "world";
    private WorldLocationDef? selectedCoven;
    private LocalCultDef? selectedLocalCult;
    private string? selectedInstitution;
    private bool showLore = false;
    private bool mapInitialized = false;
    private DotNetObjectReference<WorldMap>? _dotRef;

    private ShadowWarState sw => Game.ShadowWar;
    private int rivalCount => RivalCultEngine.ActiveRivals(Game.State).Count;

    private static string GetTypeIcon(InstitutionType t) => t switch
    {
        InstitutionType.Police => "🚔",
        InstitutionType.Media => "📡",
        InstitutionType.Government => "🏛️",
        InstitutionType.Military => "⚔️",
        InstitutionType.Finance => "💰",
        InstitutionType.Intelligence => "🕵️",
        _ => ""
    };

    private string activeCovenName
    {
        get
        {
            var loc = LocationService.Find(Game.State.ActiveCovenId);
            return loc?.Name ?? "Skanör";
        }
    }

    [Parameter]
    public string? InitialMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LocationService.LoadAsync();
        if (!string.IsNullOrEmpty(InitialMode))
            mapMode = InitialMode;
        _dotRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mapInitialized && LocationService.IsLoaded)
        {
            if (mapMode == "world") await InitWorldMap();
            else if (mapMode == "local") await InitLocalMap();
            else if (mapMode == "shadowwar") await InitShadowWarMap();
            mapInitialized = true;
        }
    }

    private async Task SwitchMapMode(string mode)
    {
        if (mapMode == mode) return;
        await JS.InvokeVoidAsync("destroyWorldMap");
        await JS.InvokeVoidAsync("destroyShadowWarMap");
        mapInitialized = false;
        mapMode = mode;
        selectedCoven = null;
        selectedLocalCult = null;
        selectedInstitution = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task InitWorldMap()
    {
        var locations = LocationService.Locations;
        var jsLocations = new List<object>();
        foreach (var loc in locations)
        {
            var covenState = Game.State.FindCoven(loc.Id);
            var converted = loc.Id == "skanor" || (covenState != null && covenState.Converted);
            var nextTarget = CovenProgress.NextTarget(Game.State, locations);
            var isNextTarget = nextTarget?.Id == loc.Id && loc.Id != "skanor" && !converted;
            var hasCovenInContinent = HasCovenInContinent(loc.Continent);

            jsLocations.Add(new {
                id = loc.Id,
                name = loc.Name,
                lat = loc.Latitude,
                lng = loc.Longitude,
                flag = loc.CountryFlag,
                era = loc.Era,
                summary = loc.Summary,
                lore = loc.Lore,
                location = loc.Location,
                country = loc.Country,
                takenOver = converted,
                isNextTarget = isNextTarget,
                isActive = Game.State.ActiveCovenId == loc.Id && converted,
                locked = !converted && !hasCovenInContinent
            });
        }
        await JS.InvokeVoidAsync("initWorldMap", "world-map-container", jsLocations, _dotRef);
    }

    private async Task InitLocalMap()
    {
        var activeCoven = LocationService.Find(Game.State.ActiveCovenId);
        if (activeCoven == null) return;

        var localCults = LocalCultData.ForCoven(Game.State.ActiveCovenId);
        var activeInstances = Game.ActiveLocalCultsForCurrentCoven;

        var jsLocations = new List<object>();

        jsLocations.Add(new {
            id = activeCoven.Id,
            name = activeCoven.Name,
            lat = activeCoven.Latitude,
            lng = activeCoven.Longitude,
            flag = activeCoven.CountryFlag,
            era = "",
            summary = "Your active coven",
            lore = "",
            location = activeCoven.Location,
            country = activeCoven.Country,
            takenOver = true,
            isNextTarget = false,
            isActive = true,
            locked = false
        });

        foreach (var cult in localCults)
        {
            var isActive = activeInstances.Any(i => i.CultId == cult.Id);
            if (isActive)
            {
                jsLocations.Add(new {
                    id = cult.Id,
                    name = cult.Name,
                    lat = cult.Latitude,
                    lng = cult.Longitude,
                    flag = "🗡️",
                    era = "Local Cult",
                    summary = cult.Description,
                    lore = "",
                    location = "",
                    country = "",
                    takenOver = false,
                    isNextTarget = true,
                    isActive = false,
                    locked = false
                });
            }
        }

        var mapOpts = new Dictionary<string, object>
        {
            ["zoom"] = 6,
            ["minZoom"] = 3,
            ["center"] = new[] { activeCoven.Latitude, activeCoven.Longitude }
        };
        await JS.InvokeVoidAsync("initWorldMap", "local-map-container", jsLocations, _dotRef, mapOpts);
    }

    [JSInvokable]
    public void SelectCoven(string id)
    {
        if (mapMode == "local")
        {
            var cultDef = LocalCultData.Find(id);
            if (cultDef != null)
            {
                selectedLocalCult = cultDef;
                selectedCoven = null;
                StateHasChanged();
                return;
            }
        }

        var loc = LocationService.Find(id);
        if (loc != null)
        {
            selectedCoven = loc;
            selectedLocalCult = null;
            showLore = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void SelectInstitution(string id)
    {
        selectedInstitution = id;
        StateHasChanged();
    }

    private void CloseInstitutionPopup() { selectedInstitution = null; _ = RefreshShadowWarMap(); }

    private async Task InitShadowWarMap()
    {
        var sw = Game.ShadowWar;
        var jsInstitutions = new List<object>();
        var rivalState = Game.State.RivalCultsOrInit;

        foreach (var def in ShadowWarData.Institutions)
        {
            var inst = sw.GetInstitution(def.Id);
            if (inst == null) continue;
            var rivalControlled = rivalState.IsActive && rivalState.Rivals
                .Any(r => r.ControlledInstitutions.Contains(def.Id));

            jsInstitutions.Add(new
            {
                id = def.Id,
                name = def.Name,
                icon = GetTypeIcon(def.Type),
                lat = def.Latitude,
                lng = def.Longitude,
                status = inst.Status.ToString().ToLower(),
                rivalControlled = rivalControlled
            });
        }

        var jsRivals = new List<object>();
        if (rivalState.IsActive)
        {
            foreach (var rival in rivalState.Rivals)
            {
                var def = RivalCultData.Find(rival.Id);
                if (def == null) continue;
                var territory = ShadowWarData.Territory(def.PreferredTerritoryId);
                if (territory == null) continue;

                var firstInst = ShadowWarData.InstitutionsForTerritory(def.PreferredTerritoryId).FirstOrDefault();
                var lat = firstInst?.Latitude ?? 30;
                var lng = firstInst?.Longitude ?? 10;

                jsRivals.Add(new
                {
                    id = rival.Id,
                    name = def.Name,
                    icon = def.Icon,
                    lat = lat,
                    lng = lng,
                    status = rival.Status.ToString().ToLower(),
                    power = rival.Power
                });
            }
        }

        var mapOpts = new Dictionary<string, object>
        {
            ["zoom"] = 2,
            ["minZoom"] = 2,
            ["center"] = new[] { 30.0, 10.0 }
        };

        await JS.InvokeVoidAsync("initShadowWarMap", "shadowwar-map-container", jsInstitutions, jsRivals, _dotRef, mapOpts);
    }

    private async Task RefreshShadowWarMap()
    {
        await JS.InvokeVoidAsync("destroyShadowWarMap");
        mapInitialized = false;
        await InitShadowWarMap();
        mapInitialized = true;
        StateHasChanged();
    }

    private void ClosePopup() { selectedCoven = null; showLore = false; }
    private void CloseLocalPopup() { selectedLocalCult = null; }
    private void ToggleLore() => showLore = !showLore;

    private void BeginConversion(string id)
    {
        Game.StartConversion(id);
        selectedCoven = null;
        _ = RefreshMap();
    }

    private void ConvertLocalCult(string id)
    {
        Game.RequestLocalCultConversion(id);
        selectedLocalCult = null;
        _ = RefreshMap();
    }

    private void Switch(string id)
    {
        Game.SwitchActiveCoven(id);
        selectedCoven = null;
        _ = RefreshMap();
    }

    private async Task RefreshMap()
    {
        await JS.InvokeVoidAsync("destroyWorldMap");
        await JS.InvokeVoidAsync("destroyShadowWarMap");
        mapInitialized = false;
        if (mapMode == "world") await InitWorldMap();
        else if (mapMode == "local") await InitLocalMap();
        else if (mapMode == "shadowwar") await InitShadowWarMap();
        mapInitialized = true;
        StateHasChanged();
    }

    private bool HasCovenInContinent(string continent)
    {
        return Game.State.Covens.Any(c => c.Converted &&
            string.Equals(LocationService.Find(c.Id)?.Continent, continent, StringComparison.OrdinalIgnoreCase));
    }

    private static string ContinentName(string continent) => continent switch
    {
        "europe" => "Europe",
        "north_america" => "North America",
        "south_america" => "South America",
        "asia" => "Asia",
        "oceania" => "Oceania",
        "africa" => "Africa",
        "middle_east" => "Middle East",
        _ => continent
    };

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("destroyWorldMap");
        _ = JS.InvokeVoidAsync("destroyShadowWarMap");
        _dotRef?.Dispose();
    }
}
