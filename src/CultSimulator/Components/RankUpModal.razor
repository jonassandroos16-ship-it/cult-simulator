@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

@if (showModal && newRank != null)
{
    <div class="rankup-overlay fixed inset-0 z-[200] flex items-center justify-center p-8">
        <div class="rankup-backdrop absolute inset-0"></div>

        <div class="rankup-confetti-container absolute inset-0 pointer-events-none overflow-hidden">
            @for (int i = 0; i < 40; i++)
            {
                var conf = confetti[i];
                <div class="rankup-confetti" style="@conf.Style"></div>
            }
        </div>

        <div class="rankup-modal relative rounded-3xl p-12 max-w-lg w-full overflow-hidden">
            <div class="rankup-aura absolute -inset-[50%] pointer-events-none"></div>
            <div class="rankup-rays absolute -inset-[50%] pointer-events-none"></div>

            <div class="rankup-content relative text-center">
                <div class="rankup-sparkle-row mb-2">
                    <span class="rankup-sparkle rankup-sparkle-1">✦</span>
                    <span class="rankup-sparkle rankup-sparkle-2">✧</span>
                    <span class="rankup-sparkle rankup-sparkle-3">✦</span>
                </div>

                <div class="rankup-icon-wrapper mb-4">
                    <div class="rankup-icon-glow"></div>
                    <span class="rankup-icon">🌟</span>
                </div>

                <h2 class="rankup-eyebrow font-display text-xs tracking-[0.4em] uppercase mb-3">Rank Up</h2>

                <div class="rankup-rank-name font-display text-4xl font-bold tracking-[0.08em] mb-2 rankup-shimmer"
                     style="--rank-color: @newRank.Color;">
                    @newRank.Name
                </div>

                <p class="rankup-subtitle text-sm text-violet-300 tracking-[0.05em] mb-1">
                    @oldRankName → @newRank.Name
                </p>
                <p class="rankup-followers text-xs text-amber-200/70 tracking-[0.1em] mb-8">
                    @currentFollowers Followers
                </p>

                <button class="rankup-button font-display text-sm font-medium tracking-[0.2em] uppercase px-8 py-3 rounded-full cursor-pointer transition-all duration-300 hover:scale-105"
                        style="background: linear-gradient(135deg, @(newRank.Color)22, @(newRank.Color)11); border: 1px solid @(newRank.Color)55; color: @(newRank.Color);"
                        @onclick="Dismiss">
                    Continue
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showModal = false;
    private RankDef? newRank = null;
    private string oldRankName = "";
    private int currentFollowers = 0;
    private RankDef? lastRank = null;

    private record ConfettiPiece(string Style);
    private List<ConfettiPiece> confetti = new();

    protected override void OnInitialized()
    {
        Game.OnChange += StateChanged;
        var followers = Game.State.ActiveCoven.Followers;
        lastRank = GameEngine.RankFor(followers);
    }

    private void StateChanged()
    {
        _ = InvokeAsync(() =>
        {
            var followers = Game.State.ActiveCoven.Followers;
            var currentRank = GameEngine.RankFor(followers);

            if (lastRank != null && currentRank.MinFollowers > lastRank.MinFollowers)
            {
                newRank = currentRank;
                oldRankName = lastRank.Name;
                currentFollowers = followers;
                GenerateConfetti(currentRank.Color);
                showModal = true;
            }

            lastRank = currentRank;
            StateHasChanged();
        });
    }

    private void GenerateConfetti(string color)
    {
        confetti.Clear();
        var colors = new[] { color, "#fbbf24", "#a78bfa", "#f472b6", "#fde68a", "#7dd3fc" };
        var rand = new Random();
        for (int i = 0; i < 40; i++)
        {
            var left = rand.NextDouble() * 100;
            var delay = rand.NextDouble() * 0.8;
            var duration = 1.5 + rand.NextDouble() * 1.5;
            var size = 4 + rand.Next(8);
            var c = colors[rand.Next(colors.Length)];
            var rotate = rand.Next(0, 360);
            var drift = (rand.NextDouble() - 0.5) * 200;
            var shape = rand.Next(3) switch
            {
                0 => "50%",
                1 => "0%",
                _ => "2px"
            };
            var style = $"left: {left:F1}%; animation-delay: {delay:F2}s; animation-duration: {duration:F2}s; " +
                        $"width: {size}px; height: {size}px; background: {c}; border-radius: {shape}; " +
                        $"--confetti-drift: {drift:F0}px; transform: rotate({rotate}deg);";
            confetti.Add(new ConfettiPiece(style));
        }
    }

    private void Dismiss()
    {
        showModal = false;
        newRank = null;
    }

    public void Dispose() => Game.OnChange -= StateChanged;
}