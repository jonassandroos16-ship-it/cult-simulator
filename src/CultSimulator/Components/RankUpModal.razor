@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

@if (showModal && newRank != null)
{
    <div class="rankup-overlay fixed inset-0 z-[200] flex items-center justify-center p-8">
        <div class="rankup-backdrop absolute inset-0"></div>

        <div class="rankup-fog-container absolute inset-0 pointer-events-none overflow-hidden">
            @for (int i = 0; i < 6; i++)
            {
                <div class="rankup-fog-layer" style="--fog-delay: @(i * 2)s; --fog-duration: @(20 + i * 5)s;"></div>
            }
        </div>

        <div class="rankup-ash-container absolute inset-0 pointer-events-none overflow-hidden">
            @for (int i = 0; i < 35; i++)
            {
                var piece = ash[i];
                <div class="rankup-ash" style="@piece.Style"></div>
            }
        </div>

        <div class="rankup-modal relative rounded-2xl p-12 max-w-lg w-full overflow-hidden">
            <div class="rankup-aura absolute -inset-[50%] pointer-events-none"></div>
            <div class="rankup-rays absolute -inset-[50%] pointer-events-none"></div>
            <div class="rankup-vignette absolute inset-0 pointer-events-none"></div>

            <div class="rankup-content relative text-center">
                <div class="rankup-sigil-row mb-2">
                    <span class="rankup-sigil rankup-sigil-1">☽</span>
                    <span class="rankup-sigil rankup-sigil-2">⛧</span>
                    <span class="rankup-sigil rankup-sigil-3">☽</span>
                </div>

                <div class="rankup-icon-wrapper mb-4">
                    <div class="rankup-icon-glow"></div>
                    <div class="rankup-icon-ring"></div>
                    <span class="rankup-icon">🕯️</span>
                </div>

                <h2 class="rankup-eyebrow font-display text-xs tracking-[0.5em] uppercase mb-3">Ascension</h2>

                <div class="rankup-rank-name font-display text-4xl font-bold tracking-[0.08em] mb-2 rankup-shimmer"
                     style="--rank-color: @newRank.Color;">
                    @newRank.Name
                </div>

                <p class="rankup-subtitle text-sm tracking-[0.05em] mb-1">
                    @oldRankName → @newRank.Name
                </p>
                <p class="rankup-followers text-xs tracking-[0.1em] mb-8">
                    @currentFollowers Souls
                </p>

                <button class="rankup-button font-display text-sm font-medium tracking-[0.2em] uppercase px-8 py-3 rounded-sm cursor-pointer transition-all duration-300 hover:scale-105"
                        style="background: linear-gradient(135deg, @(newRank.Color)11, @(newRank.Color)05); border: 1px solid @(newRank.Color)44; color: @(newRank.Color);"
                        @onclick="Dismiss">
                    Embrace
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showModal = false;
    private RankDef? newRank = null;
    private string oldRankName = "";
    private int currentFollowers = 0;
    private RankDef? lastRank = null;

    private record AshPiece(string Style);
    private List<AshPiece> ash = new();

    protected override void OnInitialized()
    {
        Game.OnChange += StateChanged;
        var followers = Game.State.ActiveCoven.Followers;
        lastRank = GameEngine.RankFor(followers);
    }

    private void StateChanged()
    {
        _ = InvokeAsync(() =>
        {
            var followers = Game.State.ActiveCoven.Followers;
            var currentRank = GameEngine.RankFor(followers);

            if (lastRank != null && currentRank.MinFollowers > lastRank.MinFollowers)
            {
                newRank = currentRank;
                oldRankName = lastRank.Name;
                currentFollowers = followers;
                GenerateAsh(currentRank.Color);
                showModal = true;
            }

            lastRank = currentRank;
            StateHasChanged();
        });
    }

    private void GenerateAsh(string color)
    {
        ash.Clear();
        var colors = new[] { color, "#6b0f1a", "#3b1505", "#1a1a2e", "#4a0e1f", "#2d1b0e" };
        var rand = new Random();
        for (int i = 0; i < 35; i++)
        {
            var left = rand.NextDouble() * 100;
            var delay = rand.NextDouble() * 2.5;
            var duration = 4.0 + rand.NextDouble() * 4.0;
            var size = 2 + rand.Next(5);
            var c = colors[rand.Next(colors.Length)];
            var drift = (rand.NextDouble() - 0.5) * 80;
            var opacity = 0.3 + rand.NextDouble() * 0.4;
            var style = $"left: {left:F1}%; animation-delay: {delay:F2}s; animation-duration: {duration:F2}s; " +
                        $"width: {size}px; height: {size}px; background: {c}; " +
                        $"--ash-drift: {drift:F0}px; --ash-opacity: {opacity:F2};";
            ash.Add(new AshPiece(style));
        }
    }

    private void Dismiss()
    {
        showModal = false;
        newRank = null;
    }

    public void Dispose() => Game.OnChange -= StateChanged;
}