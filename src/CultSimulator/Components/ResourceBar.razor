@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService Locations
@implements IDisposable

<div class="resource-bar glass-panel rounded-[20px] p-5 md:p-6 mb-6">
    <div class="cult-header flex items-center justify-between flex-wrap gap-2 mb-3">
        <div class="flex items-baseline gap-3 flex-wrap">
            <h1 class="cult-name font-display text-2xl md:text-3xl font-semibold text-amber-100 tracking-[0.1em]">@Game.State.CultName</h1>
            @if (!CovenProgress.IsHomeCoven(Game.State)) { <span class="active-coven-tag font-display text-xs tracking-[0.2em] uppercase text-violet-300 px-2.5 py-1 border border-violet-500/25 rounded-full">@activeCovenName</span> }
            else { <span class="active-coven-tag font-display text-xs tracking-[0.2em] uppercase text-amber-300/80 px-2.5 py-1 border border-amber-500/20 rounded-full">Home</span> }
            <span class="total-followers-tag font-display text-xs tracking-[0.15em] uppercase text-amber-200 px-2.5 py-1 border border-amber-500/30 rounded-full flex items-center gap-1"><span class="text-sm">👥</span><span>@CovenProgress.TotalFollowers(Game.State) Total</span></span>
        </div>
        <div class="rank-badge font-display text-xs font-semibold tracking-[0.25em] uppercase px-3.5 py-1.5 border rounded-full" style="border-color: @currentRank.Color; color: @currentRank.Color;">@currentRank.Name</div>
    </div>
    <div class="rank-progress h-1 bg-white/[0.06] rounded-full overflow-hidden mb-1.5"><div class="rank-progress-bar h-full rounded-full transition-all duration-500" style="width: @(GameEngine.RankProgress(Game.State) * 100)%; background: @currentRank.Color;"></div></div>
    <div class="rank-label text-[0.7rem] text-violet-300 tracking-[0.1em] mb-4">@if (nextRank != null) { <span>@totalFollowers / @nextRank.MinFollowers followers to @nextRank.Name</span> } else { <span>Maximum rank achieved</span> }</div>
    <div class="resource-stats flex gap-6 flex-wrap">
        <div class="resource-stat flex items-baseline gap-1.5"><span class="resource-icon text-xl">👥</span><span class="resource-value font-display text-xl font-semibold text-amber-100">@activeCoven.Followers</span><span class="resource-label text-[0.7rem] text-violet-300 tracking-[0.15em] uppercase">Followers</span></div>
        <div class="resource-stat flex items-baseline gap-1.5"><span class="resource-icon text-xl">✨</span><span class="resource-value font-display text-xl font-semibold text-amber-100">@NumberFormat.Fmt(activeCoven.Faith)</span><span class="resource-label text-[0.7rem] text-violet-300 tracking-[0.15em] uppercase">Faith</span></div>
        <div class="resource-stat flex items-baseline gap-1.5"><span class="resource-icon text-xl">💰</span><span class="resource-value font-display text-xl font-semibold text-amber-100">@NumberFormat.Fmt(activeCoven.Gold)</span><span class="resource-label text-[0.7rem] text-violet-300 tracking-[0.15em] uppercase">Gold</span></div>
        @if (Game.State.Occult.EldritchFavor > 0) { <div class="resource-stat flex items-baseline gap-1.5"><span class="resource-icon text-xl">🌟</span><span class="resource-value font-display text-xl font-semibold text-amber-200">@NumberFormat.Fmt(Game.State.Occult.EldritchFavor)</span><span class="resource-label text-[0.7rem] text-amber-400 tracking-[0.15em] uppercase">Favor</span></div> }
    </div>
    <div class="income-display flex gap-6 mt-2 text-xs"><span class="income-faith text-emerald-400">+@NumberFormat.Fmt(totalFaithPerSec)/s ✨</span><span class="income-gold text-amber-500">+@NumberFormat.Fmt(GameEngine.TickIncome(Game.State).gold)/s 💰</span></div>
</div>

@code {
    private CovenState activeCoven => Game.State.ActiveCoven;
    private int totalFollowers => CovenProgress.TotalFollowers(Game.State);
    private double totalFaithPerSec => GameEngine.TickIncome(Game.State).faith + OccultEngine.TotalFaithPerSec(Game.State) + OccultEngine.TotalMapFaithPerSec(Game.State);
    private RankDef currentRank => GameEngine.RankFor(totalFollowers);
    private RankDef? nextRank => GameEngine.NextRank(totalFollowers);
    private string activeCovenName { get { var loc = Locations.Find(Game.State.ActiveCovenId); return loc?.Name ?? Game.State.ActiveCovenId; } }
    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.OnChange -= StateChanged;
}
