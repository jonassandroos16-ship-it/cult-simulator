@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">Codex Necrotica</h2>
    <p class="text-xs text-slate-400 mb-4 leading-relaxed">Research technologies across four branches. Each tech requires Faith and may need prerequisite technologies unlocked first. Technologies unlock new features like the Cauldron, Shadow Tactics, and endgame content.</p>
    <div class="flex flex-col gap-4">
        @foreach (var branch in branches)
        {
            <div class="tech-branch">
                <h3 class="text-xs font-display tracking-[0.2em] uppercase text-violet-300 mb-2">@BranchName(branch.Key)</h3>
                <div class="flex flex-col gap-2">
                    @foreach (var tech in branch)
                    {
                        var owned = TechTree.IsUnlocked(occult, tech);
                        var prereqsMet = TechTree.PrerequisitesMet(occult, tech);
                        var affordable = Game.State.ActiveCoven.Faith >= tech.FaithCost;
                        <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px] @(owned ? "border-emerald-400/20 bg-emerald-400/5" : "") @(!prereqsMet && !owned ? "opacity-40" : "")" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                            <div class="text-3xl flex-shrink-0">@tech.Icon</div>
                            <div class="flex-1 flex flex-col gap-0.5">
                                <span class="font-display text-base text-amber-100 font-medium">@tech.Name</span>
                                <span class="text-xs text-violet-300">@tech.EffectDescription</span>
                                @if (!prereqsMet && !owned) { <span class="text-[0.7rem] text-slate-400">Requires: @(string.Join(", ", tech.Prerequisites?.Select(p => OccultData.Tech(p).Name) ?? Array.Empty<string>()))</span> }
                            </div>
                            <div class="flex-shrink-0">
                                @if (owned) { <span class="learned-badge text-[0.7rem] font-semibold tracking-[0.15em] uppercase text-emerald-400 px-3 py-1.5 border border-emerald-400/30 rounded-full">Unlocked</span> }
                                else if (!prereqsMet) { <span class="text-xl">🔒</span> }
                                else { <button class="upgrade-buy flex items-center gap-1.5 px-3.5 py-2 rounded-full font-body font-semibold text-xs cursor-pointer transition-transform duration-200 disabled:opacity-40 disabled:cursor-not-allowed" style="background: linear-gradient(135deg, var(--gold-warm), var(--gold-deep)); border: none; color: var(--void-deep);" disabled="@(!affordable)" @onclick="() => Game.UnlockTech(tech.Id)"><span>@NumberFormat.Fmt(tech.FaithCost) ✨</span></button> }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private OccultState occult => Game.State.Occult;
    private IEnumerable<IGrouping<TechBranch, TechDef>> branches => OccultData.Techs.GroupBy(t => t.Branch);
    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    private static string BranchName(TechBranch branch) => branch switch { TechBranch.BloodFlesh => "Blood & Flesh", TechBranch.MindCoercion => "Mind & Coercion", TechBranch.VoidAstral => "Void & Astral", TechBranch.OuterGate => "The Outer Gate", _ => branch.ToString() };
    public void Dispose() => Game.OnChange -= StateChanged;
}