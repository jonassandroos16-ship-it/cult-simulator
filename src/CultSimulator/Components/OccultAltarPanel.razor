@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

<div class="panel occult-altar-panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">The Altar</h2>
    <div class="flex flex-col items-center gap-4">
        <button class="occult-altar-btn relative w-[180px] h-[180px] rounded-full border-none cursor-pointer flex items-center justify-center transition-transform duration-150 hover:scale-105 active:scale-95"
                style="background: radial-gradient(circle at center, var(--altar-core) 0%, var(--altar-mid) 60%, var(--altar-edge) 100%);"
                @onclick="OnTapClick">
            <div class="altar-glow absolute -inset-5 rounded-full pointer-events-none animate-altar-pulse"
                 style="background: radial-gradient(circle, rgba(220,38,38,0.15) 0%, transparent 70%);"></div>
            <div class="flex flex-col items-center gap-2 z-10">
                <span class="text-5xl">🩸</span>
                <span class="font-display text-sm font-bold tracking-[0.35em] text-rose-100">TAP</span>
            </div>
        </button>
        <div class="text-center">
            <p class="text-sm text-rose-300 tracking-[0.05em]">+@NumberFormat.Fmt(OccultEngine.ClickPower(Game.State)) Devotion per tap</p>
            @if (occult.IsFrenzyActive)
            {
                <p class="text-xs text-amber-400 mt-1 animate-pulse">FRENZY ACTIVE: @(Math.Ceiling(occult.FrenzyTimer))s</p>
            }
            @if (occult.IsMassHysteriaActive)
            {
                <p class="text-xs text-violet-400 mt-1 animate-pulse">MASS HYSTERIA: @(Math.Ceiling(occult.MassHysteriaTimer))s</p>
            }
        </div>
    </div>
</div>

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">Dark Registry</h2>
    <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between p-3 rounded-[14px]"
             style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="flex items-center gap-2">
                <span class="text-xl">🙇</span>
                <span class="text-sm text-violet-300 tracking-[0.1em] uppercase">Acolytes</span>
            </div>
            <span class="font-display text-lg font-semibold text-amber-100">@occult.Acolytes / @CultistHierarchy.AcolyteCap(occult)</span>
        </div>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed"
                style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                disabled="@(!OccultEngine.CanHireAcolyte(occult))"
                @onclick="() => Game.HireAcolyte()">
            <div class="text-3xl flex-shrink-0">🙇</div>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="font-display text-base text-amber-100 font-medium">Hire Acolyte</span>
                <span class="text-xs text-emerald-400">+1 Acolyte (passive Devotion)</span>
            </div>
            <div class="flex items-baseline gap-1 flex-shrink-0">
                <span class="font-display font-semibold text-amber-400 text-base">@NumberFormat.Fmt(OccultEngine.AcolyteHireCost(occult))</span>
                <span class="text-sm">🩸</span>
            </div>
        </button>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed"
                style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                disabled="@(!OccultEngine.CanBuyClickPower(occult))"
                @onclick="() => Game.BuyClickPower()">
            <div class="text-3xl flex-shrink-0">💪</div>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="font-display text-base text-amber-100 font-medium">Click Power Upgrade</span>
                <span class="text-xs text-emerald-400">+1 base tap power (level @occult.ClickPowerLevel)</span>
            </div>
            <div class="flex items-baseline gap-1 flex-shrink-0">
                <span class="font-display font-semibold text-amber-400 text-base">@NumberFormat.Fmt(OccultEngine.ClickPowerUpgradeCost(occult))</span>
                <span class="text-sm">🩸</span>
            </div>
        </button>
        <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed"
                style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                disabled="@(!CultistHierarchy.CanPromote(occult))"
                @onclick="() => Game.PromoteMinion()">
            <div class="text-3xl flex-shrink-0">🔮</div>
            <div class="flex-1 flex flex-col gap-0.5">
                <span class="font-display text-base text-amber-100 font-medium">Promote Minion</span>
                <span class="text-xs text-violet-300">Spend @OccultBalance.PromoteAcolyteCost Acolytes for a named follower</span>
            </div>
        </button>
    </div>
</div>

@if (occult.Minions.Count > 0)
{
    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">Promoted Minions</h2>
        <div class="flex flex-col gap-2.5">
            @foreach (var minion in occult.Minions)
            {
                <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px]"
                     style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <div class="text-3xl flex-shrink-0">@RoleIcon(minion.Role)</div>
                    <div class="flex-1 flex flex-col gap-0.5">
                        <span class="font-display text-base text-amber-100 font-medium">@minion.Name</span>
                        <span class="text-xs text-violet-300">@RoleName(minion.Role) · @minion.Trait?.Name</span>
                        <span class="text-[0.7rem] text-slate-400">@minion.Trait?.Description</span>
                    </div>
                    <button class="upgrade-buy px-3 py-1.5 rounded-full font-body text-xs cursor-pointer transition-transform duration-200"
                            style="background: linear-gradient(135deg, #dc2626, #991b1b); border: none; color: #fef3c7;"
                            @onclick="() => Game.SacrificeMinion(minion.Id)">
                        Sacrifice
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (occult.HighCouncil.Count > 0 || occult.Minions.Count > 0)
{
    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">High Council</h2>
        <div class="flex flex-col gap-2.5">
            @foreach (var role in OccultData.CouncilRoles)
            {
                var member = occult.HighCouncil.FirstOrDefault(c => c.Role == role);
                <div class="upgrade-item flex items-center gap-3.5 p-3.5 rounded-[14px] @(member != null ? "border-amber-500/20 bg-amber-500/5" : "")"
                     style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
                    <div class="text-3xl flex-shrink-0">👑</div>
                    <div class="flex-1 flex flex-col gap-0.5">
                        <span class="font-display text-base text-amber-100 font-medium">@CouncilRoleName(role)</span>
                        @if (member != null)
                        {
                            <span class="text-xs text-emerald-400">@member.Name (active)</span>
                        }
                        else
                        {
                            <span class="text-xs text-slate-400">Empty slot</span>
                        }
                    </div>
                    @if (member != null)
                    {
                        <button class="upgrade-buy px-3 py-1.5 rounded-full font-body text-xs cursor-pointer transition-transform duration-200"
                                style="background: rgba(100,100,100,0.3); border: 1px solid var(--panel-border); color: var(--gold-soft);"
                                @onclick="() => Game.RemoveCouncil(role)">
                            Remove
                        </button>
                    }
                    else if (occult.Minions.Count > 0)
                    {
                        <select class="bg-transparent text-xs text-amber-100 border border-violet-500/20 rounded-full px-2 py-1"
                                @onchange="(e) => AppointFromSelect(role, e.Value?.ToString())">
                            <option value="">Appoint...</option>
                            @foreach (var m in occult.Minions)
                            {
                                <option value="@m.Id">@m.Name (@RoleName(m.Role))</option>
                            }
                        </select>
                    }
                </div>
            }
        </div>
    </div>
}

@if (TechTree.HasTech(occult, TechId.ExsanguinationEngine))
{
    <div class="panel glass-panel rounded-[20px] p-5">
        <h2 class="panel-title">Rituals</h2>
        <div class="flex flex-col gap-2.5">
            <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed"
                    style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                    disabled="@(!OccultEngine.CanActivateFrenzy(occult))"
                    @onclick="() => Game.ActivateFrenzy()">
                <div class="text-3xl flex-shrink-0">🔥</div>
                <div class="flex-1 flex flex-col gap-0.5">
                    <span class="font-display text-base text-amber-100 font-medium">Exsanguination Frenzy</span>
                    <span class="text-xs text-rose-400">Sacrifice a minion for 15s of 10x tap power</span>
                </div>
            </button>
            @if (TechTree.HasTech(occult, TechId.MassHysteria))
            {
                <button class="building-item flex items-center gap-3.5 p-3.5 rounded-[14px] cursor-pointer transition-all duration-200 text-left w-full disabled:opacity-45 disabled:cursor-not-allowed"
                        style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border); color: inherit; font-family: inherit;"
                        disabled="@(!OccultEngine.CanActivateMassHysteria(occult))"
                        @onclick="() => Game.ActivateMassHysteria()">
                    <div class="text-3xl flex-shrink-0">😱</div>
                    <div class="flex-1 flex flex-col gap-0.5">
                        <span class="font-display text-base text-amber-100 font-medium">Mass Hysteria</span>
                        <span class="text-xs text-violet-400">30s of doubled FK generation</span>
                    </div>
                </button>
            }
        </div>
    </div>
}

@code {
    private OccultState occult => Game.State.Occult;

    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnTapClick()
    {
        Game.OccultTap();
        await InvokeAsync(StateHasChanged);
    }

    private void AppointFromSelect(CouncilRole role, string? minionId)
    {
        if (!string.IsNullOrEmpty(minionId))
            Game.AppointCouncil(role, minionId);
    }

    private static string RoleIcon(PromotedRole role) => role switch
    {
        PromotedRole.Zealot => "⚔️",
        PromotedRole.Scholar => "📖",
        PromotedRole.Infiltrator => "🕵️",
        _ => "🔮"
    };

    private static string RoleName(PromotedRole role) => role switch
    {
        PromotedRole.Zealot => "Zealot",
        PromotedRole.Scholar => "Scholar",
        PromotedRole.Infiltrator => "Infiltrator",
        _ => "Unknown"
    };

    private static string CouncilRoleName(CouncilRole role) => role switch
    {
        CouncilRole.Inquisitor => "Inquisitor",
        CouncilRole.Archon => "Archon",
        CouncilRole.HighPriest => "High Priest",
        _ => "Unknown"
    };

    public void Dispose() => Game.OnChange -= StateChanged;
}