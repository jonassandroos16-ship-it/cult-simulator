@using CultSimulator.Game
@inject GameService Game
@inject IJSRuntime JS
@implements IDisposable

<div class="preach-section flex flex-col items-center gap-4 p-8">
    <div class="preach-altar-wrapper relative">
        <button class="preach-altar relative w-[200px] h-[200px] rounded-full border-none cursor-pointer flex items-center justify-center transition-transform duration-150 overflow-visible
               hover:scale-105 active:scale-95"
                style="background: radial-gradient(circle at center, var(--altar-core) 0%, var(--altar-mid) 60%, var(--altar-edge) 100%);"
                @onclick="OnPreachClick">
            <div class="altar-glow absolute -inset-5 rounded-full pointer-events-none animate-altar-pulse"
                 style="background: radial-gradient(circle, rgba(245,158,11,0.15) 0%, transparent 70%);"></div>
            <div class="altar-ring absolute -inset-2 rounded-full pointer-events-none animate-slow-rotate"
                 style="background: conic-gradient(from 0deg, transparent, rgba(167,139,250,0.2), transparent, rgba(251,191,36,0.15), transparent);"></div>
            <div class="altar-body flex flex-col items-center gap-2 z-10">
                <span class="altar-icon text-5xl">🕯️</span>
                <span class="altar-label font-display text-sm font-bold tracking-[0.35em] text-amber-100">PREACH</span>
            </div>
        </button>
        @foreach (var ft in _floatTexts)
        {
            <span class="float-faith" style="left: @(ft.X)px; animation-duration: @(ft.Duration)ms;" key="@ft.Id">+@CultGame.Fmt(ft.Amount) ✨</span>
        }
    </div>
    <div class="preach-info text-center">
        <p class="preach-yield text-sm text-violet-300 tracking-[0.05em]">+@CultGame.Fmt(CultGame.PreachMultiplier(Game.State)) Faith per sermon</p>
    </div>
    <button class="recruit-button flex items-center gap-2 px-6 py-3 rounded-full font-body text-sm cursor-pointer transition-all duration-200
                  disabled:opacity-40 disabled:cursor-not-allowed"
            style="background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(217,119,6,0.1)); border: 1px solid var(--active-border); color: var(--gold-pale);"
            disabled="@(!CultGame.CanRecruit(Game.State))"
            @onclick="OnRecruitClick">
        <span class="recruit-icon text-lg">👥</span>
        <span class="recruit-text">Recruit Follower</span>
        <span class="recruit-cost text-amber-400 font-semibold">@CultGame.RecruitCost ✨</span>
    </button>
</div>

@code {
    [Parameter] public EventCallback OnPreach { get; set; }
    [Parameter] public EventCallback OnRecruit { get; set; }

    private record FloatText(int Id, double Amount, int X, int Duration);
    private List<FloatText> _floatTexts = new();
    private int _nextId = 0;

    protected override void OnInitialized() => Game.OnChange += StateChanged;

    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnPreachClick()
    {
        var gained = Game.Preach();
        AddFloatText(gained);
        await OnPreach.InvokeAsync();
    }

    private async Task OnRecruitClick()
    {
        Game.Recruit();
        await OnRecruit.InvokeAsync();
    }

    private void AddFloatText(double amount)
    {
        var x = Random.Shared.Next(-50, 51);
        var duration = Random.Shared.Next(900, 1300);
        var id = _nextId++;
        _floatTexts.Add(new FloatText(id, amount, x, duration));
        _ = RemoveFloatTextAfter(id, duration);
    }

    private async Task RemoveFloatTextAfter(int id, int delay)
    {
        await Task.Delay(delay);
        _floatTexts.RemoveAll(t => t.Id == id);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Game.OnChange -= StateChanged;
}
