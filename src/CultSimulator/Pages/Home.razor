@page "/"
@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

@if (!initialized)
{
    <div class="loading-screen flex items-center justify-center min-h-screen">
        <div class="loading-pulse text-6xl animate-pulse">🕯️</div>
    </div>
}
else if (Game.IsFirstRun)
{
    <NamingScreen />
}
else
{
    <div class="game-container max-w-5xl mx-auto px-4 pb-12 pt-6">
        <ResourceBar />
        <div class="game-main grid grid-cols-1 md:grid-cols-[1fr_1.3fr] gap-6">
            <div class="game-left flex flex-col gap-6">
                <PreachAltar OnPreach="OnPreach" OnRecruit="OnRecruit" />
            </div>
            <div class="game-right flex flex-col gap-6">
                <BuildingsPanel />
                <UpgradesPanel />
            </div>
        </div>
        <div class="game-footer mt-8 text-center">
            <button class="reset-button ghost-button" @onclick="ResetGame">Abandon Cult</button>
        </div>
    </div>
    <EventModal />
}

@code {
    private bool initialized = false;

    protected override async Task OnInitializedAsync()
    {
        await Game.InitAsync();
        Game.OnChange += StateChanged;
        Game.StartTimers();
        initialized = true;
    }

    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnPreach() => await InvokeAsync(StateHasChanged);
    private async Task OnRecruit() => await InvokeAsync(StateHasChanged);

    private async Task ResetGame() { await Game.ResetAsync(); }

    public void Dispose() { Game.OnChange -= StateChanged; }
}
