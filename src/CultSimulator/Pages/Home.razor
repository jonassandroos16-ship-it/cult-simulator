@page "/"
@using CultSimulator.Game
@inject GameService Game
@inject WorldLocationService LocationService
@implements IDisposable

<StoryScreen />
<NamingScreen />
<ResourceBar />

<div class="game-grid">
    <div class="left-panel">
        <PreachAltar />
        <SanctumPanel />
    </div>
    <div class="center-panel">
        <WorldMap />
        <UpgradesPanel />
        <BuildingsPanel />
    </div>
    <div class="right-panel">
        <BankPanel />
        <GrimoirePanel />
        <CodexPanel />
        <GrandSacrificePanel />
    </div>
</div>

<ConversionModal /><EventModal /><GenericPopup /><LocalCultModal /><LocalCultSpawnModal /><RankUpModal /><VictoryScreen /><ContinentStoryScreen />

@code {
    protected override async Task OnInitializedAsync()
    {
        Game.OnChange += StateChanged;
        await Game.InitAsync();
        await LocationService.LoadAsync();
    }

    private void StateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Game.OnChange -= StateChanged;
}
