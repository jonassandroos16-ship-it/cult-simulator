@page "/"
@using CultSimulator.Game
@inject IJSRuntime JS
@inject GameService Game
@inject WorldLocationService Locations
@inject AudioService Audio
@implements IDisposable

@if (!initialized)
{
    <div class="loading-screen flex items-center justify-center min-h-screen">
        <div class="loading-pulse text-6xl animate-pulse">🕯️</div>
    </div>
}
else if (Game.IsFirstRun)
{
    <NamingScreen />
}
else if (Game.NeedsStory)
{
    <StoryScreen OnDismissed="StoryDismissed" />
}
else
{
    <div class="game-container max-w-5xl mx-auto px-4 pb-12 pt-6 @themeClass">
        <ResourceBar />
        <div class="bookmark-tabs">
            <button class="bookmark-tab @(activeTab == "preach" ? "active" : "")" @onclick='() => SwitchTab("preach")'><span class="bookmark-tab-icon">🕯️</span><span class="bookmark-tab-label">Preach</span></button>
            <button class="bookmark-tab @(activeTab == "map" ? "active" : "")" @onclick='() => SwitchTab("map")'><span class="bookmark-tab-icon">🗺️</span><span class="bookmark-tab-label">Map</span></button>
            <button class="bookmark-tab @(activeTab == "sanctum" ? "active" : "")" @onclick='() => SwitchTab("sanctum")'><span class="bookmark-tab-icon">🔮</span><span class="bookmark-tab-label">Sanctum</span></button>
            <button class="bookmark-tab @(activeTab == "codex" ? "active" : "")" @onclick='() => SwitchTab("codex")'><span class="bookmark-tab-icon">📜</span><span class="bookmark-tab-label">Codex</span></button>
            <button class="bookmark-tab @(activeTab == "grimoire" ? "active" : "")" @onclick='() => SwitchTab("grimoire")'><span class="bookmark-tab-icon">📖</span><span class="bookmark-tab-label">Grimoire</span></button>
            <button class="bookmark-tab @(activeTab == "ascension" ? "active" : "")" @onclick='() => SwitchTab("ascension")'><span class="bookmark-tab-icon">🌟</span><span class="bookmark-tab-label">Ascension</span></button>
            <button class="bookmark-tab @(activeTab == "bank" ? "active" : "")" @onclick='() => SwitchTab("bank")'><span class="bookmark-tab-icon">🏦</span><span class="bookmark-tab-label">Bank</span></button>
            <button class="bookmark-tab @(activeTab == "battle" ? "active" : "")" @onclick='() => SwitchTab("battle")'><span class="bookmark-tab-icon">⚔️</span><span class="bookmark-tab-label">Battle</span></button>
            <button class="bookmark-tab @(activeTab == "settings" ? "active" : "")" @onclick='() => SwitchTab("settings")'><span class="bookmark-tab-icon">⚙️</span><span class="bookmark-tab-label">Settings</span></button>
        </div>
        @if (activeTab == "preach")
        {
            <div class="game-main grid grid-cols-1 md:grid-cols-[1fr_1.3fr] gap-6">
                <div class="game-left flex flex-col gap-6"><PreachAltar OnPreach="OnPreach" OnRecruit="OnRecruit" /></div>
                <div class="game-right flex flex-col gap-6"><BuildingsPanel /><UpgradesPanel /></div>
            </div>
            }
        else if (activeTab == "sanctum")
        {
            <div class="game-main grid grid-cols-1 md:grid-cols-[1fr_1.3fr] gap-6">
                <div class="game-left flex flex-col gap-6"><SanctumPanel /></div>
                <div class="game-right flex flex-col gap-6"></div>
            </div>
        }
        else if (activeTab == "codex") { <CodexPanel /> }
        else if (activeTab == "grimoire") { <GrimoirePanel /> }

        else if (activeTab == "ascension") { <GrandSacrificePanel /> }
        else if (activeTab == "bank") { <BankPanel /> }
        else if (activeTab == "battle") { <BattlePanel OnViewMap="SwitchToBattleMap" /> }
        else if (activeTab == "settings") { <SettingsPanel /> }
        else if (activeTab == "map") { <WorldMap InitialMode="@mapInitialMode" /> }
    </div>
    <ConversionModal /><EventModal /><GenericPopup /><LocalCultModal /><OfflineReportPopup /><RankUpModal /><VictoryScreen /><ContinentStoryScreen />
}

@code {
    private bool initialized = false;
    private string activeTab = "preach";
    private string mapInitialMode = "world";
    private string themeClass => ComputeThemeClass();

    private string ComputeThemeClass()
    {
        var loc = Locations.Find(Game.State.ActiveCovenId);
        if (loc == null) return "theme-viking";
        return ContinentThemes.For(loc.Continent).ThemeClass;
    }
    protected override async Task OnInitializedAsync() { await Game.InitAsync(); Game.OnChange += StateChanged; if (Game.LoadSucceeded || !Game.IsFirstRun) Game.StartTimers(); initialized = true; await UpdateAudioState(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { try { await JS.InvokeVoidAsync("setupAutoSave", DotNetObjectReference.Create(this)); await Audio.ResumeAudioAsync(); } catch { } } }
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    private void SwitchTab(string tab)
    {
        activeTab = tab;
        _ = Audio.PlayClickAsync();
        _ = UpdateAudioState();
    }
    private async Task UpdateAudioState()
    {
        if (Game.IsFirstRun) { await Audio.SetGameStateAsync(AudioGameState.Menu); return; }
        var loc = Locations.Find(Game.State.ActiveCovenId);
        var continent = loc?.Continent;
        if (activeTab == "map") await Audio.SetGameStateAsync(AudioGameState.Map, continent);
        else if (activeTab == "battle") await Audio.SetGameStateAsync(AudioGameState.Combat, continent);
        else await Audio.SetGameStateAsync(AudioGameState.Gameplay, continent);
    }
    private void SwitchToBattleMap() { mapInitialMode = "local"; activeTab = "map"; }
    private void StoryDismissed() { }
    private async Task OnPreach() => await InvokeAsync(StateHasChanged);
    private async Task OnRecruit() => await InvokeAsync(StateHasChanged);
    public void Dispose() { Game.OnChange -= StateChanged; _ = Game.SaveAsync(); }
    [Microsoft.JSInterop.JSInvokable] public async Task SyncSaveJsonToJS() => await Game.SyncSaveJsonToJSAsync();
    [Microsoft.JSInterop.JSInvokable] public async Task SaveOnExit() => await Game.SaveAsync();
}
