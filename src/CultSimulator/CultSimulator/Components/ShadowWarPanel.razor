@using CultSimulator.Game
@inject GameService Game
@implements IDisposable

<div class="panel glass-panel rounded-[20px] p-5">
    <h2 class="panel-title">🕯️ The Shadow War</h2>
    <p class="text-sm text-violet-300 mb-4">Your cult does not fight openly — it seeps into society. Train acolytes into sleeper agents, then deploy them to infiltrate real-world institutions across the globe.</p>

    <!-- Resource summary -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-cyan-400 uppercase tracking-wider">Agents</div>
            <div class="font-display text-lg text-amber-100">@((int)sw.AvailableAgents) / @((int)sw.TotalAgents)</div>
            <div class="text-[10px] text-slate-400">+@ShadowWarEngine.AgentProductionPerSec(sw, Game.State).ToString("F2")/s</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-emerald-400 uppercase tracking-wider">Strength</div>
            <div class="font-display text-lg text-amber-100">×@ShadowWarEngine.AgentStrength(sw, Game.State).ToString("F2")</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-rose-400 uppercase tracking-wider">Heat</div>
            <div class="font-display text-lg text-amber-100">@((int)sw.Heat)</div>
            <div class="text-[10px] text-slate-400">@(ShadowWarEngine.SuspicionDecay(sw) > 0 ? $"-{ShadowWarEngine.SuspicionDecay(sw):F1}/s" : "no decay")</div>
        </div>
        <div class="p-3 rounded-[14px] text-center" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
            <div class="text-xs text-slate-400 uppercase tracking-wider">Controlled</div>
            <div class="font-display text-lg text-amber-100">@sw.TotalControlled / @ShadowWarData.Institutions.Length</div>
            <div class="text-[10px] text-slate-400">@ShadowWarEngine.ControlledTerritories(sw).Count territories</div>
        </div>
    </div>

    <!-- Territory grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        @foreach (var territory in ShadowWarData.Territories)
        {
            var controlled = ShadowWarEngine.IsTerritoryControlled(sw, territory.Id);
            var insts = ShadowWarData.InstitutionsForTerritory(territory.Id);
            var controlledCount = insts.Count(i => sw.GetInstitution(i.Id)?.Status == InstitutionStatus.Controlled);
            <div class="rounded-[14px] p-3" style="background: rgba(15,10,36,0.5); border: 1px solid @(controlled ? "rgba(52,211,153,0.3)" : "var(--panel-border)");">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">@territory.Icon</span>
                        <div>
                            <div class="text-sm font-semibold text-amber-100">@territory.Name</div>
                            <div class="text-[10px] text-slate-400">@controlledCount / @insts.Count controlled</div>
                        </div>
                    </div>
                    @if (controlled)
                    {
                        <span class="text-[10px] font-medium text-emerald-400 px-2 py-0.5 rounded" style="background: rgba(16,185,129,0.15);">BONUS</span>
                    }
                </div>
                <div class="text-[10px] text-slate-500 mb-2 px-2 py-1 rounded" style="background: rgba(5,3,8,0.4);">@territory.BonusLabel</div>
                <div class="flex flex-col gap-1.5">
                    @foreach (var def in insts)
                    {
                        var inst = sw.GetInstitution(def.Id);
                        if (inst == null) continue;
                        <button class="text-left p-2 rounded-[10px] transition-all hover:scale-[1.02] @GetStatusClass(inst.Status)"
                                disabled="@(inst.Status == InstitutionStatus.Locked)"
                                @onclick="() => SelectInstitution(def.Id)">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1.5">
                                    <span>@GetTypeIcon(def.Type)</span>
                                    <div>
                                        <div class="text-xs font-medium text-amber-100">@def.Name</div>
                                        <div class="text-[9px] text-slate-400 uppercase">@GetStatusLabel(inst.Status)</div>
                                    </div>
                                </div>
                                <div class="text-[9px] text-slate-500">T@((int)def.Tier + 1)</div>
                            </div>
                            @if (inst.Status == InstitutionStatus.Recon)
                            {
                                <div class="mt-1 h-1 rounded-full bg-stone-800 overflow-hidden">
                                    <div class="h-full bg-blue-500 transition-all" style="width: @(inst.ReconProgress)%"></div>
                                </div>
                            }
                            @if (inst.Status == InstitutionStatus.Infiltrating || inst.Status == InstitutionStatus.Recon)
                            {
                                <div class="mt-1 h-1 rounded-full bg-stone-800 overflow-hidden">
                                    <div class="h-full bg-amber-500 transition-all" style="width: @((def.Defense - inst.DefenseRemaining) / def.Defense * 100)%"></div>
                                </div>
                                <div class="mt-1 h-1 rounded-full bg-stone-800 overflow-hidden">
                                    <div class="h-full bg-red-500 transition-all" style="width: @inst.Detection%"></div>
                                </div>
                            }
                            @if (inst.Status == InstitutionStatus.Investigated)
                            {
                                <div class="mt-1 h-1 rounded-full bg-stone-800 overflow-hidden">
                                    <div class="h-full bg-orange-500 transition-all" style="width: @inst.InvestigationDefense%"></div>
                                </div>
                            }
                            <div class="mt-1 flex items-center justify-between text-[9px] text-slate-400">
                                <span>⚔️ @inst.AssignedAgents agents</span>
                                @if (inst.Status == InstitutionStatus.Controlled)
                                {
                                    <span class="text-emerald-400 font-medium">@def.RewardLabel</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Progress bar -->
    <div class="mt-4 p-3 rounded-[14px]" style="background: rgba(15,10,36,0.5); border: 1px solid var(--panel-border);">
        <div class="text-xs text-slate-400 uppercase tracking-wider mb-2">Path to Global Domination</div>
        <div class="flex flex-wrap gap-1.5">
            @foreach (var def in ShadowWarData.Institutions)
            {
                var inst = sw.GetInstitution(def.Id);
                var isControlled = inst?.Status == InstitutionStatus.Controlled;
                var isInvestigated = inst?.Status == InstitutionStatus.Investigated;
                <div class="h-3 w-3 rounded-full transition-colors @(isControlled ? "bg-emerald-500" : isInvestigated ? "bg-orange-500" : "bg-stone-700")" title="@def.Name"></div>
            }
        </div>
        <div class="mt-1.5 text-[10px] text-slate-500">@sw.TotalControlled / @ShadowWarData.Institutions.Length institutions controlled</div>
    </div>
</div>

@if (selectedInstitution != null)
{
    <ShadowWarModal InstitutionId="@selectedInstitution" OnClose="() => selectedInstitution = null" />
}

@code {
    private string? selectedInstitution;
    private ShadowWarState sw => Game.ShadowWar;

    private string GetStatusClass(InstitutionStatus s) => s switch
    {
        InstitutionStatus.Locked => "opacity-40 cursor-not-allowed",
        InstitutionStatus.Controlled => "border border-emerald-700/40 bg-emerald-950/20",
        InstitutionStatus.Investigated => "border border-orange-700/40 bg-orange-950/20",
        InstitutionStatus.Alerted => "border border-red-700/40 bg-red-950/20",
        InstitutionStatus.Infiltrating => "border border-amber-700/40 bg-amber-950/20",
        InstitutionStatus.Recon => "border border-blue-700/40 bg-blue-950/20",
        _ => "border border-stone-700/40 bg-stone-900/40 hover:border-stone-600/50"
    };

    private string GetStatusLabel(InstitutionStatus s) => s switch
    {
        InstitutionStatus.Locked => "Locked",
        InstitutionStatus.Unlocked => "Available",
        InstitutionStatus.Recon => "Recon",
        InstitutionStatus.Infiltrating => "Infiltrating",
        InstitutionStatus.Controlled => "Controlled",
        InstitutionStatus.Alerted => "Alerted",
        InstitutionStatus.Investigated => "Under Investigation",
        _ => ""
    };

    private string GetTypeIcon(InstitutionType t) => t switch
    {
        InstitutionType.Police => "🚔",
        InstitutionType.Media => "📡",
        InstitutionType.Government => "🏛️",
        InstitutionType.Military => "⚔️",
        InstitutionType.Finance => "💰",
        InstitutionType.Intelligence => "🕵️",
        _ => ""
    };

    private void SelectInstitution(string id) => selectedInstitution = id;

    protected override void OnInitialized() => Game.OnChange += StateChanged;
    private void StateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.OnChange -= StateChanged;
}
